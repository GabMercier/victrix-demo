# =============================================================================
# Victrix — variables d'environnement (copier vers .env pour le local).
#
# PÉRIMÈTRE (décision du 17 juil. 2026) : cette version du site est éditée ET
# hébergée chez CloudCannon (CMS + hébergement) ; Azure Static Web Apps est
# l'alternative d'hébergement documentée (docs/options-editeur-hebergement.md,
# scénario C). Cloudflare Pages n'est que l'infrastructure du spike/démo.
# Entra External ID et Dataverse sont HORS PÉRIMÈTRE de cette version — le
# portail client reste un prototype maquetté (mock), son intégration réelle
# est un chantier séparé (docs/portail-auth.md).
#
# En production, poser ces valeurs comme variables/secrets de l'hébergeur
# retenu — jamais dans le dépôt.
# =============================================================================

# --- Build ---

# "1" → build 100 % statique (adaptateur Cloudflare désactivé) — les DEUX
# sites CloudCannon (édition et production). Configuré dans l'UI CloudCannon.
# STATIC_ONLY=

# "1" → APERÇU D'ÉDITION (lot L16) : brouillons et articles programmés
# construits, fenêtres des bannières ignorées, redirections des articles
# retirés non émises, Bookshop attaché (avec STATIC_ONLY). Sites d'ÉDITION
# CloudCannon SEULEMENT — jamais la production (docs/operations.md § 6).
# EDITOR_PREVIEW=

# --- Portail client ---
# 2026-08-18 : le prototype MOCK est RETIRÉ — seule la page de connexion
# VISUELLE (/fr/portail) subsiste (2026-09-10 : bouton actif sans destination,
# vue « mot de passe oublié » ; rien n'est soumis) ; aucune variable portail
# n'est lue par cette version. Les fournisseurs réels (Entra, Dataverse) et
# leurs variables arriveront avec le chantier docs/portail-auth.md §7.

# --- Formulaires (voir docs/formulaires.md) ---
# Aucune variable requise : sans elles, le site est STRICTEMENT identique
# (sections « form » = maquette non fonctionnelle, /api/forms en mode démo).

# "1" → les sections « form » deviennent de vrais <form method="POST"
# action="/api/forms">. Absent/vide → maquette actuelle (bouton désactivé),
# zéro changement visuel. Préfixe PUBLIC_ : visible côté client, jamais un secret.
PUBLIC_FORMS_ENABLED=

# Variante (2026-09-16) : PUBLIC_FORMS_ENABLED=inbox → vrais formulaires POST
# dont l'action est la page Merci de la langue ; l'hébergement CloudCannon
# capte le POST (boîtes de réception « Inbox » du site), transmet aux
# destinataires réglés là-bas et redirige vers Merci. Aucun récepteur à
# déployer, aucune clé SMTP2GO/Turnstile. C'est la valeur à poser sur les
# builds CloudCannon (dev/staging/prod) qui ont une boîte attachée.
# Clé par défaut de la boîte du site (champ caché `inbox_key`) — une par
# environnement, ex. dev-marketing-contact. Vide = boîte par défaut du site.
# Une définition de formulaire peut la surcharger (champ « Boîte de
# réception CloudCannon »).
PUBLIC_FORMS_INBOX_KEY=

# Clé de SITE Turnstile (anti-pourriel Cloudflare — le service Turnstile est
# indépendant de l'hébergeur et fonctionne quel que soit le scénario retenu).
# Le widget ne s'affiche que si PUBLIC_FORMS_ENABLED=1 ET cette clé est
# définie. Clé de test « toujours valide » : 1x00000000000000000000AA.
# CSP : les entrées challenges.cloudflare.com sont APPLIQUÉES dans
# public/_headers depuis le 2026-08-17 (édition OPS-CSP planifiée).
PUBLIC_TURNSTILE_SITE_KEY=

# Clé SECRÈTE Turnstile — vérification serveur du jeton par /api/forms.
# Absente → vérification sautée (le pot de miel reste actif).
# Clé de test « toujours valide » : 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# SMTP2GO — envoi du courriel de notification par /api/forms. Si l'UNE des
# trois manque → « mode démo » : la soumission est journalisée côté serveur et
# le visiteur est quand même redirigé vers /<lang>/merci/.
# FORMS_FROM_EMAIL doit être un expéditeur/domaine VÉRIFIÉ dans SMTP2GO.
SMTP2GO_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=

# --- Analytics (P-11 — GA4 sous consentement Loi 25) ---

# Identifiant de mesure GA4 (format G-XXXXXXXXXX). Absent/vide → AUCUN script
# analytics rendu (zéro requête, zéro balise). Présent → BaseLayout émet les
# balises gtag GELÉES (type="text/plain" data-consent="analytics") : elles ne
# s'exécutent qu'après acceptation du bandeau Loi 25 (contrat ConsentBanner).
# Préfixe PUBLIC_ : identifiant public par nature, jamais un secret.
PUBLIC_GA4_ID=

# --- Brouillons du blogue (voir src/i18n/blog.ts) ---
# Toute valeur non vide → les articles marqués « Brouillon » sont construits
# et listés par CE build. À poser UNIQUEMENT comme variable de build de
# l'environnement de PRÉVERSION de l'hébergeur (jamais en production) : sans
# elle, un brouillon est introuvable (404) sur l'URL de préversion de branche
# qu'un éditeur partage pour validation. Sans elle, les brouillons ne sont
# visibles que dans l'aperçu CloudCannon (build EDITOR_PREVIEW).
DRAFTS_VISIBLE=
