# Victrix — environment variables (copy to .env for local, set as Cloudflare
# secrets/vars in production). None are required while running the mock portal.

# Client-portal auth provider: 'mock' (default) | 'entra'
AUTH_PROVIDER=mock

# Client-portal data source: 'mock' (default) | 'dataverse'
PORTAL_DATA=mock

# Session-cookie signing key — REQUIRED once the portal is real.
# Production: set as a Cloudflare secret, never commit:  wrangler secret put PORTAL_SESSION_SECRET
PORTAL_SESSION_SECRET=

# --- Microsoft Entra External ID (only when AUTH_PROVIDER=entra) ---
# e.g. https://<tenant>.ciamlogin.com/<tenant>.onmicrosoft.com/v2.0
ENTRA_AUTHORITY=
ENTRA_CLIENT_ID=
# Confidential web client → keep secret out of the repo (Cloudflare secret)
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# --- Portal data backend (only when PORTAL_DATA=dataverse / a real API) ---
# e.g. https://<org>.crm3.dynamics.com/api/data/v9.2
DATAVERSE_API_URL=

# --- Formulaires (voir docs/formulaires.md) ---
# Aucune variable requise : sans elles, le site est STRICTEMENT identique
# (sections « form » = maquette non fonctionnelle, /api/forms en mode démo).

# "1" → les sections « form » deviennent de vrais <form method="POST"
# action="/api/forms">. Absent/vide → maquette actuelle (bouton désactivé),
# zéro changement visuel. Préfixe PUBLIC_ : visible côté client, jamais un secret.
PUBLIC_FORMS_ENABLED=

# Clé de SITE Turnstile (anti-pourriel Cloudflare) — le widget ne s'affiche que
# si PUBLIC_FORMS_ENABLED=1 ET cette clé est définie. Clé de test « toujours
# valide » : 1x00000000000000000000AA (fonctionne sur localhost).
# ATTENTION CSP : public/_headers est GELÉ — le widget exige d'y ajouter
# script-src + frame-src https://challenges.cloudflare.com (documenté, non
# appliqué : voir docs/formulaires.md §CSP).
PUBLIC_TURNSTILE_SITE_KEY=

# Clé SECRÈTE Turnstile — vérification serveur du jeton par /api/forms
# (Pages Function). Absente → vérification sautée (le pot de miel reste actif).
# Production : secret Cloudflare Pages, jamais dans le dépôt.
# Clé de test « toujours valide » : 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# SMTP2GO — envoi du courriel de notification par /api/forms. Si l'UNE des
# trois manque → « mode démo » : la soumission est journalisée côté serveur et
# le visiteur est quand même redirigé vers /<lang>/merci/.
# FORMS_FROM_EMAIL doit être un expéditeur/domaine VÉRIFIÉ dans SMTP2GO.
SMTP2GO_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=

# --- Brouillons du blogue (voir src/i18n/blog.ts) ---
# Toute valeur non vide → les articles marqués « Brouillon » sont construits
# et listés par CE build. À poser UNIQUEMENT comme variable de build sur
# l'environnement de PRÉVERSION de Cloudflare Pages (portée « Preview »),
# JAMAIS en production : les préversions de branche construisent sans
# STATIC_ONLY, donc sans cette variable un brouillon est introuvable (404) sur
# l'adresse https://<branche>.victrix-demo.pages.dev qu'un éditeur partage
# pour validation. Sans elle, les brouillons ne sont visibles que dans
# l'aperçu CloudCannon (build STATIC_ONLY).
DRAFTS_VISIBLE=
