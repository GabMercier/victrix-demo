# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# CSP for the static marketing + portal pages. Scoped to the locale-prefixed
# routes (/fr/*, /en/*) on purpose — NOT /* — because Cloudflare Pages COMBINES
# the CSP of every matching _headers rule into one comma-joined header (multiple
# policies, ALL enforced as an intersection). If /* also set a CSP, /admin would
# get this strict policy intersected with its own looser one below, and the
# Sveltia bundle from unpkg would stay blocked. Every real page lives under /fr
# or /en (prefixDefaultLocale: true), so this covers them all while leaving
# /admin free to define its own policy.
# style-src/script-src need 'unsafe-inline' because Astro inlines scoped component
# <style> and a few is:inline/define:vars scripts (announcement no-flash, 404
# locale swap, article copy-link). HARDENING TODO: hash those inline scripts (or
# move them external) and drop 'unsafe-inline' from script-src. When real Entra
# login is wired, add the IdP/login domain to form-action + connect-src.
# 'wasm-unsafe-eval' (P-06, appliqué par la ligne OPS 2026-07-28) : la recherche
# interne Pagefind compile un module WebAssembly LOCAL (/pagefind/*.wasm —
# stemming FR/EN); Chrome exige cette directive pour WebAssembly.instantiate.
# Elle n'autorise QUE la compilation wasm — PAS eval()/new Function() JS.
/fr/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self'; connect-src 'self'; form-action 'self'; manifest-src 'self'
/en/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; font-src 'self'; connect-src 'self'; form-action 'self'; manifest-src 'self'

# Sveltia CMS retiré (Phase 3 convergence, 2026-07-30) : CloudCannon est
# l'éditeur du site. Le bloc CSP /admin/* et public/admin/ ont été supprimés;
# le worker OAuth (sveltia-cms-auth.…workers.dev) peut être décommissionné
# côté Cloudflare (tâche OPS, hors dépôt).

# Keep auth endpoints out of search results.
/auth/*
  X-Robots-Tag: noindex

# Content-hashed build assets — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — stable filenames, cache forever.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
