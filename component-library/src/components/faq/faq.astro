---
import { FOND_CLASSES, estFondSombre, type FondEtenduKey } from '../../shared/fonds';
import { blockHtml } from '../../shared/rich';
/**
 * Section « FAQ » — composant Bookshop (contrat landing GELÉ).
 * RE-SKIN DESIGN SYSTEM 2026-08-05 : fond ivoire (surface), titre centré
 * 40/700 ls -0.4, accordéon en colonne étroite — items blancs bordés `contour` (rayon 8)
 * rayon 4, question 16/700, chevron bleu (primary), réponse 16/26.
 *
 * Props : { type: "faq", title, items: [{ question, answer }] }
 * - `type` est le discriminant du contrat landing ; il arrive via le spread
 *   {...section} depuis la page campagne et est volontairement ignoré ici.
 *
 * Contraintes / pièges :
 * - <h2> de section : le <h1> unique appartient au héros.
 * - Accordéon <details>/<summary> NATIF : ouverture/fermeture, clavier
 *   (Entrée/Espace) et exposition aux lecteurs d'écran sont gérés par le
 *   navigateur — aucun script client (l'éditeur visuel CloudCannon rend les
 *   composants Bookshop dans le navigateur).
 * - JSON-LD FAQPage émis via src/components/JsonLd.astro (contrat gelé — il
 *   neutralise toute fermeture de balise script dans les réponses en échappant
 *   le chevron ouvrant en séquence unicode u003c). GOTCHA compilateur Astro :
 *   dans un commentaire de frontmatter, un chevron ouvrant isolé (non refermé
 *   comme dans <h2>) avale le texte jusqu'au prochain chevron fermant et casse
 *   la détection de l'interface Props — Astro.props devient Record<string, any>
 *   et `astro check` échoue en ts(7006). D'où « chevron » en toutes lettres
 *   dans ce bloc. L'import
 *   relatif sort de component-library/ vers src/ : Vite le résout sans alias
 *   (même mécanique, en sens inverse, que l'import des composants Bookshop
 *   par la page campagne). JsonLd.astro doit rester compatible navigateur
 *   (opérations de chaînes uniquement — pas d'i18n, pas d'astro:assets) pour
 *   ne pas casser le bundle d'édition en direct de CloudCannon.
 * - `items = []` en secours : pendant l'édition en direct, la liste peut être
 *   momentanément absente — on évite de planter l'éditeur visuel. Le bloc
 *   JSON-LD n'est émis que s'il reste au moins une question (une FAQPage à
 *   `mainEntity` vide n'apporte rien aux moteurs de recherche).
 * - Le chevron du summary est un SVG inline pivoté via group-open (le marqueur
 *   natif est masqué ; [&::-webkit-details-marker]:hidden couvre Safari).
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
import JsonLd from '../../../../src/components/JsonLd.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  fond?: FondEtenduKey;
  items: FaqItem[];
}

const { title, fond = 'ivoire', items = [] } = Astro.props;
// Fond SOMBRE (« bleu électrique », 2026-09-21) : seul le titre de section
// s'inverse — les questions restent des cartes blanches bordées.
const sombre = estFondSombre(fond);

// « Fond de section » (2026-08-17, pilote 6 blocs) : clé fermée → utilitaire
// de la palette officielle (aucune couleur libre — esprit P-16). Défaut =
// rendu historique (blanc, ex-bg-surface).
const FONDS: Record<string, string> = FOND_CLASSES;

// Balisage schema.org FAQPage construit depuis les questions — permet aux
// moteurs de recherche d'afficher les Q/R en résultats enrichis. Les réponses
// sont du texte brut (aucun HTML attendu — voir faq.bookshop.yml).
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      // Données structurées = texte nu (la réponse peut porter du HTML enrichi).
      text: item.answer.replace(/<[^>]+>/g, '').trim(),
    },
  })),
};
---

<section class:list={['py-20', FONDS[fond] ?? FONDS.blanc]}>
  <div class="container-site">
    <h2
      class:list={[
        'text-[2rem] leading-[1.2] lg:text-[2.5rem] lg:leading-[3rem] font-bold tracking-[-0.4px] m-0 text-center',
        sombre ? 'text-white' : 'text-on-surface',
      ]}
    >
      {title}
    </h2>
    <div class="flex flex-col gap-3 max-w-[760px] mx-auto mt-12">
      {
        items.map((item) => (
          <details class="group bg-white border border-solid border-contour rounded-lg">
            <summary class="flex items-center justify-between gap-4 px-6 py-4 text-base font-bold text-on-surface cursor-pointer list-none [&::-webkit-details-marker]:hidden rounded-sm focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2">
              {item.question}
              <svg
                class="shrink-0 text-primary transition-transform group-open:rotate-180"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="rich max-w-none px-6 pb-6 text-base leading-[1.625rem] text-on-surface-variant" set:html={blockHtml(item.answer)} />
          </details>
        ))
      }
    </div>
  </div>
  {items.length > 0 && <JsonLd schema={faqSchema} />}
</section>
