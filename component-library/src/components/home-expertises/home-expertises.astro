---
/**
 * Section « Expertises » — composant Bookshop (accueil composable).
 *
 * Props : { type: "home-expertises", sectionTitle, learnMore,
 *           items: [{ number, title, accent, description, href }] }
 * - `learnMore` : libellé du bouton de chaque carte. Il provenait du
 *   dictionnaire UI (t.home.learnMore) ; il est passé en champ de contenu pour
 *   que le composant reste autonome dans le navigateur (aucun import i18n).
 *
 * PARITÉ : reproduit à l'identique la grille d'expertises de l'ancienne page
 * d'accueil (mêmes classes .exp-card, style="--accent:…" inline, libellés).
 * `items = []` en secours pendant l'édition live. Voir home-hero.astro pour les
 * conventions communes.
 */
interface ExpertiseItem {
  number: string;
  title: string;
  accent: string;
  description: string;
  href: string;
}

interface Props {
  sectionTitle: string;
  learnMore: string;
  items: ExpertiseItem[];
}

const { sectionTitle, learnMore, items = [] } = Astro.props;
---

<section class="expertises">
  <div class="container">
    <h2 class="section-title">{sectionTitle}</h2>
    <ul role="list" class="expertises__grid">
      {
        items.map((item) => (
          <li class="exp-card" style={`--accent:${item.accent}`}>
            <p class="exp-card__num" aria-hidden="true">
              {item.number}
            </p>
            <h3 class="exp-card__title">{item.title}</h3>
            <p class="exp-card__desc">{item.description}</p>
            <a class="btn btn--outline exp-card__cta" href={item.href}>
              {learnMore}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Duplicatas scopés (autonomie éditeur). */
  .container {
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--container-pad, 1.5rem);
  }
  h2 {
    font-size: var(--fs-700, clamp(2rem, 2vw + 1.4rem, 3rem));
    font-weight: var(--fw-bold, 700);
    line-height: var(--lh-tight, 1.15);
    color: var(--color-navy, #083957);
    text-wrap: balance;
  }
  h3 {
    font-size: var(--fs-600, clamp(1.625rem, 1vw + 1.3rem, 2.25rem));
    font-weight: var(--fw-bold, 700);
    line-height: var(--lh-tight, 1.15);
    color: var(--color-navy, #083957);
    text-wrap: balance;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: 0.7em 1.5em;
    border: 2px solid transparent;
    border-radius: var(--radius-pill, 999px);
    font-weight: var(--fw-semibold, 600);
    font-size: var(--fs-200, 0.9375rem);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }
  .btn--outline {
    border-color: var(--color-navy, #083957);
    color: var(--color-navy, #083957);
    background-color: transparent;
  }
  .btn--outline:hover {
    background-color: var(--color-navy, #083957);
    color: var(--color-text-invert, #ffffff);
  }

  /* ---------- Expertises (déplacé depuis l'ancienne page d'accueil) -------- */
  .expertises {
    padding-block: var(--space-9, 6rem);
    font-family: var(--font-sans, 'Montserrat', system-ui, sans-serif);
  }
  .section-title {
    text-align: center;
    margin-bottom: var(--space-7, 3rem);
  }
  .expertises__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 2rem);
    margin: 0;
  }
  @media (min-width: 600px) {
    .expertises__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .expertises__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .exp-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-6, 2rem);
    border: 1px solid var(--color-border, #e2e4e8);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-l, 16px);
    background-color: var(--color-bg, #ffffff);
  }
  .exp-card__num {
    font-size: var(--fs-500, clamp(1.375rem, 0.6vw + 1.2rem, 1.75rem));
    font-weight: var(--fw-extrabold, 800);
    color: var(--accent);
    line-height: 1;
  }
  .exp-card__title {
    color: var(--accent);
    font-size: var(--fs-500, clamp(1.375rem, 0.6vw + 1.2rem, 1.75rem));
  }
  .exp-card__desc {
    color: var(--color-text-muted, #4a4d54);
    flex-grow: 1;
  }
  .exp-card__cta {
    align-self: flex-start;
    margin-top: var(--space-2, 0.5rem);
  }
</style>
