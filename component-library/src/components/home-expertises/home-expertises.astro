---
/**
 * Section « Expertises » — composant Bookshop (accueil composable).
 * RE-SKIN 2026-08-04 (lot accueil, Phase 5) : patron « Nos services » de la
 * maquette Accueil.html normalisé système — TUILES image + overlay Bleu nuit
 * (même pattern que les tuiles expertises de PageExpertise, validé au port du
 * pipeline). Les ACCENTS multicolores par carte et les numéros de l'ancien
 * design sont RETIRÉS du rendu (champs conservés au contrat pour
 * compatibilité du contenu existant).
 *
 * Props : { type: "home-expertises", sectionTitle, intro?, learnMore,
 *           items: [{ number, title, accent, description, href, image? }] }
 * - `intro` (NOUVEAU, optionnel) : paragraphe d'appui à droite du titre.
 * - `items[].image` (NOUVEAU, optionnel) : chemin PUBLIC servi tel quel ;
 *   sans image, la tuile pose un fond sable (pas de casse).
 * - `learnMore` : libellé du lien de chaque tuile (champ de contenu — aucun
 *   import i18n, composant browser-safe pour l'éditeur visuel CloudCannon).
 *
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface ExpertiseItem {
  number: string;
  title: string;
  accent: string;
  description: string;
  href: string;
  image?: string;
}

interface Props {
  sectionTitle: string;
  intro?: string;
  learnMore: string;
  items: ExpertiseItem[];
}

const { sectionTitle, intro, learnMore, items = [] } = Astro.props;
---

<section class="py-section-gap bg-surface">
  <div class="max-w-container-max mx-auto px-margin-x">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
      <h2 class="font-headline-lg text-headline-lg text-on-surface m-0">{sectionTitle}</h2>
      {intro && <p class="font-body-md text-body-md text-on-surface-variant max-w-sm m-0 md:text-right">{intro}</p>}
    </div>
    <ul role="list" class="grid grid-cols-1 md:grid-cols-3 gap-6 m-0 p-0 list-none">
      {
        items.map((item) => (
          <li class="m-0">
            <a class="group relative block h-64 rounded-lg overflow-hidden no-underline" href={item.href}>
              {item.image ? (
                <img
                  src={item.image}
                  alt=""
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="absolute inset-0 bg-surface-container-high" aria-hidden="true" />
              )}
              <span class="absolute inset-0 bg-gradient-to-t from-on-primary-fixed/85 via-on-primary-fixed/35 to-transparent" aria-hidden="true" />
              <span class="absolute bottom-0 left-0 right-0 p-6 block">
                <span class="block font-headline-md text-white text-[20px] mb-1">{item.title}</span>
                <span class="block font-body-md text-[14px] leading-snug text-white/80 mb-3">{item.description}</span>
                <span class="inline-flex items-center gap-2 font-button text-button text-primary-fixed-dim group-hover:text-white transition-colors">
                  {learnMore}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
