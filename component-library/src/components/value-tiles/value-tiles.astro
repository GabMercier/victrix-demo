---
import { FOND_CLASSES, estFondSombre, type FondEtenduKey } from '../../shared/fonds';
import { iconFor, iconSvgAttrs, type IconKey } from '../../shared/icons';
/**
 * Section « Tuiles de valeurs » — composant Bookshop (2026-09-17, conversion
 * de la page Carrières en page « sections »).
 * FIDÉLITÉ MAQUETTE 2026-08-05 (docs/design/carriere.css §Valeurs, ex-bloc de
 * src/pages/[lang]/carrieres.astro repris VERBATIM) : surtitre 12/700
 * majuscules bleu, titre 40/700 centré, rangée de tuiles bordées (jeton `contour`, rayon 8)
 * — pictogramme TRAIT bleu 30 px + libellé 12/700 majuscules ls 1.2 —,
 * survol bordure bleue. 2 colonnes mobile / 5 desktop ; une DERNIÈRE tuile
 * impaire s'étale sur les 2 colonnes mobiles (5 valeurs = 2+2+1 centrée).
 *
 * Props : { type: "value-tiles", eyebrow?, title, fond?, items: [{ icon, label }] }
 * - `icon` : clé de la BANQUE de pictogrammes (shared/icons.ts — toute la banque est offerte dans l'éditeur depuis le 2026-09-18) —
 *   trait 1,8 px (maquette : étoile, groupe, ampoule, poignée, coche).
 *   Vide/inconnue = tuile sans pictogramme (le <svg> vide garde l'alignement).
 * - `fond` : palette partagée ; défaut « blanc » (rendu historique).
 *
 * Contraintes / pièges :
 * - <h2> : le <h1> unique appartient au héros ; surtitre = <p>.
 * - `items = []` en secours (édition en direct CloudCannon).
 * - Browser-safe : aucun import d'image, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface ValueTile {
  icon?: IconKey | '';
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  fond?: FondEtenduKey;
  items?: ValueTile[];
}

const { eyebrow = '', title, fond = 'ivoire', items = [] } = Astro.props;
// Fonds SOMBRES ouverts le 2026-09-21. Ici TOUT est posé sur le fond : les
// tuiles n'ont pas de fond propre, seulement une bordure — qui doit elle
// aussi s'éclaircir, sinon elle disparaît sur l'aplat bleu.
const sombre = estFondSombre(fond);

// « Fond de section » : clé fermée → utilitaire de la palette officielle.
const FONDS: Record<string, string> = FOND_CLASSES;

---

<section class:list={['py-20', FONDS[fond] ?? FONDS.blanc]}>
  <div class="container-site flex flex-col gap-8">
    <div class="text-center">
      {eyebrow && (
        <p
          class:list={[
            'text-sm font-bold uppercase tracking-[1.2px] m-0 mb-2 max-w-none',
            sombre ? 'text-white' : 'text-primary',
          ]}
        >
          {eyebrow}
        </p>
      )}
      <h2
        class:list={[
          'text-[2rem] leading-[1.2] lg:text-[2.5rem] lg:leading-[3rem] font-bold tracking-[-0.4px] m-0 text-center',
          sombre ? 'text-white' : 'text-on-surface',
        ]}
      >
        {title}
      </h2>
    </div>
    <ul role="list" class="grid grid-cols-2 md:grid-cols-5 gap-6 m-0 p-0 list-none">
      {
        items.map((item, i) => (
          <li
            class:list={[
              'm-0 flex flex-col items-center text-center gap-2 p-4 rounded-lg border border-solid transition-colors',
              sombre ? 'border-white/40 hover:border-white' : 'border-contour hover:border-primary',
              i === items.length - 1 && items.length % 2 === 1 && 'col-span-2 md:col-span-1',
            ]}
          >
            <svg
              class:list={[sombre ? 'text-white' : 'text-primary']}
              width="30"
              height="30"
              {...iconSvgAttrs(iconFor(item.icon) ?? { paths: [] }, 1.8)}
              aria-hidden="true"
              focusable="false"
            >
              {(iconFor(item.icon)?.paths ?? []).map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span
              class:list={[
                'text-sm font-bold uppercase tracking-[1.2px]',
                sombre ? 'text-white' : 'text-on-surface',
              ]}
            >
              {item.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
