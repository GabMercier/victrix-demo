---
/**
 * Section « Vidéo » — composant Bookshop (palette partagée) en FAÇADE.
 * RE-SKIN DESIGN SYSTEM 2026-08-05 : fond ivoire (surface), titre 40/700
 * ls -0.4, façade rayon 8 en dégradé Bleu nuit→Bleu Victrix (tokens
 * on-primary-fixed→primary), disque de lecture blanc à triangle bleu.
 *
 * Props : { type: "video", title, intro?, videoUrl, posterImage? }
 *
 * PERFORMANCE + CSP : aucun script ni iframe tiers n'est chargé au rendu —
 * la façade est un LIEN (image d'aperçu + bouton lecture) qui ouvre la vidéo
 * dans un nouvel onglet. public/_headers (GELÉ) n'autorise aucun frame-src
 * YouTube/Vimeo : le mode « iframe au clic » exigera d'ajouter, le jour venu,
 * frame-src https://www.youtube-nocookie.com https://player.vimeo.com à la
 * CSP (même mécanique documentée que Turnstile, docs/formulaires.md §7) puis
 * de remplacer ce lien par un embed au clic. Décision OPS — pas ici.
 *
 * Contraintes / pièges :
 * - `posterImage` est un CHEMIN (chaîne) servi tel quel — pas d'astro:assets.
 *   Vide → façade en dégradé de marque (la section fonctionne sans image).
 * - `videoUrl` vide (section fraîchement ajoutée) → le lien est désactivé
 *   visuellement mais l'éditeur visuel ne plante pas.
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */

interface Props {
  title: string;
  intro?: string;
  videoUrl: string;
  posterImage?: string;
  /** Libellé du bouton — champ de contenu (pas d'i18n dans une section). */
  ctaLabel?: string;
}

const { title, intro = '', videoUrl = '', posterImage = '', ctaLabel = '' } = Astro.props;
const facadeLabel = ctaLabel !== '' ? ctaLabel : 'Visionner la vidéo';
---

<section class="py-20 bg-surface">
  <div class="container-site text-center">
    <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0 text-balance">
      {title}
    </h2>
    {intro !== '' && <p class="text-base leading-[26px] text-on-surface-variant m-0 max-w-[640px] mx-auto mt-4">{intro}</p>}
    <a
      class:list={[
        'relative flex flex-col items-center justify-center gap-4 aspect-video max-w-[760px] mx-auto mt-12 rounded-lg overflow-hidden no-underline bg-linear-135 from-on-primary-fixed to-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2',
        videoUrl === '' && 'cursor-default opacity-75',
      ]}
      href={videoUrl !== '' ? videoUrl : undefined}
      target="_blank"
      rel="noopener noreferrer"
      aria-disabled={videoUrl === '' ? 'true' : undefined}
    >
      {
        posterImage !== '' && (
          <img class="absolute inset-0 w-full h-full object-cover border-0" src={posterImage} alt="" loading="lazy" />
        )
      }
      <span
        class="relative z-1 inline-flex items-center justify-center size-[72px] rounded-full bg-white shadow-[0_18px_40px_-12px_rgba(13,20,48,0.4)] transition-transform hover:scale-105"
        aria-hidden="true"
      >
        <svg class="ml-1 text-primary" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M8 5.5v13l11-6.5L8 5.5Z" />
        </svg>
      </span>
      <span class="relative z-1 text-white font-semibold [text-shadow:0_1px_8px_rgba(13,20,48,0.55)]">{facadeLabel}</span>
    </a>
  </div>
</section>
