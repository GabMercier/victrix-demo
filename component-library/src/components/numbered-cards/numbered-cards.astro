---
/**
 * Section « Cartes numérotées » — composant Bookshop (P-07).
 *
 * Props : { type: "numbered-cards", sectionTitle, headingStyle?, intro?,
 *           leadCard?: { title, text }, tone?, columns?, cardStyle?,
 *           items: [{ number, title, text, ctaLabel?, ctaHref? }] }
 *
 * Port fidèle des trois grilles numérotées de la page expertise (interventions,
 * collaboration, bassin d'experts) en UNE section paramétrable :
 * - headingStyle : 'plain' (titre centré) | 'underline' (titre + liseré vert) ;
 * - intro : paragraphe optionnel sous le titre (peut contenir des <strong>) ;
 * - leadCard : carte d'introduction en surimpression (liseré vert), optionnelle ;
 * - tone : 'default' (fond blanc) | 'tint' (fond surface) ;
 * - columns : '2' | '3' ; cardStyle : 'default' | 'center' ;
 * - CTA par carte optionnel (rendu seulement si libellé ET lien).
 *
 * Contraintes / pièges :
 * - <h2> de section, <h3> par carte : le <h1> unique appartient au héros.
 * - `items = []` en secours pour ne pas planter l'éditeur pendant la saisie.
 * - Classes de variante CALCULÉES (jamais de valeur brute dans le DOM) : toute
 *   valeur inattendue retombe sur le défaut.
 * - Aucun script client ; var(--token, secours) reprend src/styles/tokens.css.
 */
interface CardItem {
  number: string;
  title: string;
  text: string;
  ctaLabel?: string;
  ctaHref?: string;
}
interface Props {
  sectionTitle: string;
  headingStyle?: 'plain' | 'underline';
  intro?: string;
  leadCard?: { title: string; text: string };
  tone?: 'default' | 'tint';
  columns?: '2' | '3';
  cardStyle?: 'default' | 'center';
  items: CardItem[];
}

const {
  sectionTitle,
  headingStyle = 'plain',
  intro,
  leadCard,
  tone = 'default',
  columns = '3',
  cardStyle = 'default',
  items = [],
} = Astro.props;

const sectionClass = tone === 'tint' ? 'nc nc--tint' : 'nc';
const titleClass = headingStyle === 'underline' ? 'nc__title nc__title--underline' : 'nc__title';
const gridClass = columns === '2' ? 'nc__grid nc__grid--2' : 'nc__grid nc__grid--3';
const cardClass = cardStyle === 'center' ? 'nc__card nc__card--center' : 'nc__card';
---

<section class={sectionClass}>
  <div class="nc__container">
    <h2 class={titleClass}>{sectionTitle}</h2>
    {intro && <p class="nc__intro" set:html={intro}></p>}
    {
      leadCard && (leadCard.title || leadCard.text) && (
        <div class="nc__lead-card">
          {leadCard.title && <h3 class="nc__lead-card-title">{leadCard.title}</h3>}
          {leadCard.text && <p class="nc__lead-card-text">{leadCard.text}</p>}
        </div>
      )
    }
    <ul role="list" class={gridClass}>
      {
        items.map((item) => (
          <li class={cardClass}>
            <p class="nc__n" aria-hidden="true">
              {item.number}
            </p>
            <h3 class="nc__card-title">{item.title}</h3>
            <p class="nc__card-text">{item.text}</p>
            {item.ctaLabel && item.ctaHref && (
              <a class="nc__cta" href={item.ctaHref}>
                {item.ctaLabel}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .nc {
    padding-block: var(--space-9, 6rem);
    background-color: var(--color-bg, #ffffff);
    color: var(--color-text, #1a1c20);
    font-family: var(--font-sans, 'Montserrat', system-ui, sans-serif);
  }
  .nc--tint {
    background-color: var(--color-surface, #f6f7f8);
  }

  /* Conteneur répliqué localement (pas la classe globale .container). */
  .nc__container {
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--container-pad, 1.5rem);
  }

  .nc__title {
    margin: 0 auto;
    max-width: 24ch;
    text-align: center;
    color: var(--color-navy, #083957);
    font-size: var(--fs-700, clamp(2rem, 2vw + 1.4rem, 3rem));
    font-weight: var(--fw-bold, 700);
    line-height: var(--lh-tight, 1.15);
    text-wrap: balance;
  }
  /* Titre à liseré vert (équivalent .s-head de la page expertise). */
  .nc__title--underline {
    position: relative;
    padding-bottom: var(--space-4, 1rem);
  }
  .nc__title--underline::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 220px;
    max-width: 60%;
    height: 3px;
    background-color: var(--color-accent-green, #24fb8e);
    border-radius: 2px;
  }

  .nc__intro {
    margin: var(--space-5, 1.5rem) auto 0;
    max-width: 80ch;
    text-align: center;
    color: var(--color-text-muted, #4a4d54);
    font-size: var(--fs-400, clamp(1.125rem, 0.2vw + 1.05rem, 1.25rem));
    line-height: var(--lh-normal, 1.6);
    text-wrap: pretty;
  }

  /* Carte d'introduction en surimpression (liseré vert en tête). */
  .nc__lead-card {
    max-width: 760px;
    margin: var(--space-6, 2rem) auto var(--space-8, 4rem);
    padding: var(--space-6, 2rem);
    text-align: center;
    background-color: var(--color-bg, #ffffff);
    border-top: 3px solid var(--color-accent-green, #24fb8e);
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-md, 0 4px 16px rgba(20, 33, 61, 0.1));
  }
  .nc__lead-card-title {
    margin: 0;
    color: var(--color-navy, #083957);
    font-size: var(--fs-600, clamp(1.625rem, 1vw + 1.3rem, 2.25rem));
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-snug, 1.3);
  }
  .nc__lead-card-text {
    margin: var(--space-3, 0.75rem) auto 0;
    max-width: 65ch;
    color: var(--color-text-muted, #4a4d54);
    line-height: var(--lh-normal, 1.6);
  }

  .nc__grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 2rem);
    margin: var(--space-7, 3rem) 0 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .nc__grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .nc__grid--2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .nc__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-6, 2rem);
    background-color: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e2e4e8);
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-sm, 0 1px 2px rgba(20, 33, 61, 0.08));
  }
  .nc__card--center {
    text-align: center;
    align-items: center;
  }

  .nc__n {
    margin: 0;
    font-size: var(--fs-700, clamp(2rem, 2vw + 1.4rem, 3rem));
    font-weight: var(--fw-extrabold, 800);
    line-height: 1;
    color: var(--color-grey-200, #e2e4e8);
  }
  .nc__card-title {
    margin: 0;
    color: var(--color-navy, #083957);
    font-size: var(--fs-500, clamp(1.375rem, 0.6vw + 1.2rem, 1.75rem));
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-snug, 1.3);
  }
  .nc__card-text {
    margin: 0;
    flex-grow: 1;
    color: var(--color-text-muted, #4a4d54);
    line-height: var(--lh-normal, 1.6);
  }

  .nc__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-2, 0.5rem);
    padding: 0.7em 1.5em;
    border: 2px solid transparent;
    border-radius: var(--radius-pill, 999px);
    background-color: var(--color-navy, #083957);
    color: var(--color-text-invert, #ffffff);
    font-size: var(--fs-200, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .nc__card--center .nc__cta {
    align-self: center;
  }
  .nc__cta:hover {
    background-color: var(--color-navy-700, #0b4b71);
  }
</style>
