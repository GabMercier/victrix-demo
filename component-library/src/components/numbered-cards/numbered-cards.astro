---
import { blockHtml, hasRichText, inlineHtml } from '../../shared/rich';
/**
 * Section « Cartes numérotées » — composant Bookshop (P-07).
 *
 * UNIFORMISATION 2026-09-18 (nouvelle direction design) : la TUILE NUMÉRO
 * 48 px bleu plein cède la place au langage de la section Approche
 * (benefits) — COMPTEUR discret « 01 » en haut à droite (12/700, ls 1.2,
 * neutral-500) puis LISERÉ bleu 32×4 au-dessus du titre. La carte prend le
 * jeton `contour` et le rayon 8 du système (était #C4C5D9 verbatim, rayon 2).
 * Le numéro reste SAISI dans l'éditeur (il peut sauter des rangs) ; il est
 * seulement complété à deux chiffres à l'affichage.
 *
 * RE-SKIN DESIGN SYSTEM 2026-08-05 (patron offer-cards, produit-enfant.css) :
 * cartes blanches bordées p-32, titre 24/700, texte 16/26, CTA primaire ;
 * tête centrée 40/700 — headingStyle 'underline' = liseré BLEU 64×4 (patron
 * des têtes landing ; l'ancien liseré vert disparaît) ; leadCard = carte
 * blanche à liseré bleu HAUT 4 px ; tone 'tint' = bande beige
 * (surface-container-low).
 *
 * Props : { type: "numbered-cards", sectionTitle, headingStyle?, intro?,
 *           leadCard?: { title, text }, tone?, columns?, cardStyle?,
 *           items: [{ number, title, text, ctaLabel?, ctaHref? }] }
 *
 * Contraintes / pièges :
 * - <h2> de section, <h3> par carte : le <h1> unique appartient au héros.
 * - `items = []` en secours pour ne pas planter l'éditeur pendant la saisie.
 * - Classes de variante CALCULÉES (jamais de valeur brute dans le DOM) : toute
 *   valeur inattendue retombe sur le défaut.
 * - Liseré haut leadCard : `border-0 border-t-4 border-solid` OBLIGATOIRE
 *   (piège border-solid/UA-medium sans preflight, consigné au lot chrome).
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface CardItem {
  number: string;
  title: string;
  text: string;
  ctaLabel?: string;
  ctaHref?: string;
}
interface Props {
  sectionTitle: string;
  headingStyle?: 'plain' | 'underline';
  intro?: string;
  leadCard?: { title: string; text: string };
  tone?: 'default' | 'tint';
  columns?: '2' | '3';
  cardStyle?: 'default' | 'center';
  items: CardItem[];
}

const {
  sectionTitle,
  headingStyle = 'plain',
  intro,
  leadCard,
  tone = 'default',
  columns = '3',
  cardStyle = 'default',
  items = [],
} = Astro.props;

const centered = cardStyle === 'center';

// Compteur « 01 » — langage visuel COMMUN avec la section Approche
// (benefits, refonte 2026-09-18) : le numéro saisi est complété à deux
// chiffres quand c'en est un, et laissé tel quel sinon (« I », « A »…).
const rang = (n: string) => (/^\d+$/.test(n?.trim() ?? '') ? n.trim().padStart(2, '0') : n);
---

<section class:list={['py-20', tone === 'tint' ? 'bg-surface-container-low' : 'bg-surface']}>
  <div class="container-site">
    <div class="mx-auto text-center flex flex-col items-center gap-4">
      <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0 max-w-[24ch] text-balance">
        {sectionTitle}
      </h2>
      {headingStyle === 'underline' && <span class="w-16 h-1 bg-primary" aria-hidden="true"></span>}
      {
        hasRichText(intro) && (
          <div
            class="rich text-lg leading-[29px] text-on-surface-variant max-w-[80ch] [&_strong]:text-on-surface"
            set:html={blockHtml(intro)}
          />
        )
      }
    </div>
    {
      leadCard && (leadCard.title || leadCard.text) && (
        <div class="max-w-[760px] mx-auto mt-8 mb-4 p-8 text-center bg-white border-solid border-t-4 border-x border-b border-contour border-t-primary rounded-lg shadow-[0_1px_2px_rgba(0,0,0,0.05)] flex flex-col gap-3">
          {leadCard.title && <h3 class="text-2xl leading-8 font-bold text-on-surface m-0">{leadCard.title}</h3>}
          {leadCard.text && (
            <p class="text-base leading-[26px] text-on-surface-variant m-0 max-w-[65ch] mx-auto">{leadCard.text}</p>
          )}
        </div>
      )
    }
    <ul
      role="list"
      class:list={[
        'grid grid-cols-1 gap-6 m-0 mt-12 p-0 list-none',
        columns === '2' ? 'md:grid-cols-2' : 'md:grid-cols-3',
      ]}
    >
      {
        items.map((item) => (
          <li
            class:list={[
              'm-0 bg-white border border-solid border-contour rounded-lg p-8 flex flex-col gap-3',
              centered && 'text-center items-center',
            ]}
          >
            <div class:list={['flex w-full pb-5', centered ? 'justify-center' : 'justify-end']}>
              <span
                class="text-xs leading-[14px] font-bold tracking-[1.2px] text-neutral-500"
                aria-hidden="true"
              >
                {rang(item.number)}
              </span>
            </div>
            <span class="w-8 h-1 rounded-xl bg-primary" aria-hidden="true" />
            <h3 class="text-2xl leading-8 font-bold text-on-surface m-0 pt-1">{item.title}</h3>
            <p class="text-base leading-[26px] text-on-surface-variant m-0 max-w-none grow" set:html={inlineHtml(item.text)} />
            {item.ctaLabel && item.ctaHref && (
              <a
                class:list={[
                  'mt-2 inline-flex items-center justify-center bg-primary text-on-primary px-6 py-3 rounded-xs text-sm font-semibold leading-none no-underline hover:bg-primary-container transition-colors',
                  centered ? 'self-center' : 'self-start',
                ]}
                href={item.ctaHref}
              >
                {item.ctaLabel}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
