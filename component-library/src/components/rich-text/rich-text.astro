---
import { FOND_CLASSES, estFondSombre, type FondEtenduKey } from '../../shared/fonds';
import { blockHtml } from '../../shared/rich';
/**
 * Section « Texte enrichi » — composant Bookshop (P-07).
 * RE-SKIN DESIGN SYSTEM 2026-08-05 : fond ivoire (surface), titre centré
 * 40/700 ls -0.4, paragraphes 18/29 en colonne étroite (820 px), <strong>
 * en anthracite (on-surface). L'ancien thème navy disparaît.
 *
 * Props : { type: "rich-text", title?, paragraphs: string[] }
 * - Chaque paragraphe est rendu set:html (peut contenir des <strong>) — même
 *   politique que la page d'origine (contenu de dépôt de confiance).
 *
 * Contraintes / pièges :
 * - <h2> : le <h1> unique appartient au héros.
 * - `paragraphs = []` en secours pour ne pas planter l'éditeur pendant la saisie.
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface Props {
  title?: string;
  fond?: FondEtenduKey;
  paragraphs: string[];
}

const { title, fond = 'ivoire', paragraphs = [] } = Astro.props;

// Fond SOMBRE (« bleu électrique », 2026-09-21) : la section inverse ses
// textes — titre et gras en blanc, corps en blanc 90 %, liens hérités (le
// `.rich a` global est en `color: inherit`, seul le survol est forcé).
const sombre = estFondSombre(fond);

// « Fond de section » (2026-08-17, pilote 6 blocs) : clé fermée → utilitaire
// de la palette officielle (aucune couleur libre — esprit P-16). Défaut =
// rendu historique (blanc, ex-bg-surface).
const FONDS: Record<string, string> = FOND_CLASSES;
---

<section class:list={['py-20', FONDS[fond] ?? FONDS.blanc]}>
  <div class="w-full max-w-[820px] mx-auto px-4 md:px-8 flex flex-col gap-4">
    {
      title && (
        <h2
          class:list={[
            'text-[2rem] leading-[1.2] lg:text-[2.5rem] lg:leading-[3rem] font-bold tracking-[-0.4px] m-0 text-center text-balance',
            sombre ? 'text-white' : 'text-on-surface',
          ]}
        >
          {title}
        </h2>
      )
    }
    {
      paragraphs.map((p) => (
        <div
          class:list={[
            'rich text-lg leading-[1.8125rem] max-w-none pt-2',
            sombre
              ? 'text-white/90 [&_strong]:text-white [&_a:hover]:text-white'
              : 'text-on-surface-variant [&_strong]:text-on-surface',
          ]}
          set:html={blockHtml(p)}
        />
      ))
    }
  </div>
</section>
