---
/**
 * Section « Solution phare » — composant Bookshop (accueil composable).
 * RE-SKIN 2026-08-04 (lot accueil, Phase 5) : patron « vitrine + carte
 * flottante » de la maquette Accueil.html (validé au port PageExpertise),
 * normalisé système — image arrondie ombrée + CARTE STATISTIQUE flottante
 * (ex. « 24/7 »), texte à droite avec surtitre label-caps et CTA primaire.
 *
 * Props : { type: "home-solution", eyebrow, title, body, ctaLabel, ctaHref,
 *           image, statValue?, statLabel?, statText?, resolvedImage? }
 * - stat* (NOUVEAUX, optionnels — chaîne vide = absent) : carte flottante.
 *
 * IMAGE — pourquoi ce n'est PAS un <Image> astro:assets ici : les composants de
 * la bibliothèque sont recompilés pour le NAVIGATEUR par l'éditeur visuel
 * CloudCannon ; importer astro:assets casserait ce bundle. L'image est
 * pré-résolue au build par la page (src/pages/[lang]/index.astro) et injectée
 * via la prop `resolvedImage` (mécanisme `enrich`). En édition live (pas de
 * resolvedImage) : cadre de remplacement — repli assumé.
 *
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface ResolvedImage {
  src: string;
  srcset: string;
  width: number;
  height: number;
}

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  image?: string;
  statValue?: string;
  statLabel?: string;
  statText?: string;
  resolvedImage?: ResolvedImage;
}

const { eyebrow, title, body, ctaLabel, ctaHref, statValue, statLabel, statText, resolvedImage } = Astro.props;
const hasStat = Boolean(statValue);
---

<section class="py-section-gap bg-surface-container-low overflow-hidden">
  <div class="container-site">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class:list={['w-full lg:w-1/2 relative', hasStat && 'mb-12 lg:mb-0']}>
        <div class="rounded-xl overflow-hidden shadow-2xl bg-surface-container-high">
          {
            resolvedImage ? (
              <img
                src={resolvedImage.src}
                srcset={resolvedImage.srcset}
                alt=""
                sizes="(min-width: 1024px) 600px, 100vw"
                loading="lazy"
                decoding="async"
                width={resolvedImage.width}
                height={resolvedImage.height}
                class="w-full h-[380px] object-cover"
              />
            ) : (
              <div class="w-full h-[380px] flex items-center justify-center font-label-caps text-label-caps uppercase text-on-surface-variant" aria-hidden="true">
                Image
              </div>
            )
          }
        </div>
        {
          hasStat && (
            <div class="absolute bottom-[-40px] right-0 lg:right-[-8px] bg-white p-8 rounded-xl shadow-xl border border-solid border-outline-variant max-w-[300px]">
              <p class="text-primary font-display text-[40px] leading-none m-0 mb-2">{statValue}</p>
              {statLabel && <p class="text-on-surface font-button text-button uppercase tracking-widest m-0 mb-2">{statLabel}</p>}
              {statText && <p class="font-label-caps text-label-caps text-on-surface-variant leading-tight m-0 normal-case tracking-normal">{statText}</p>}
            </div>
          )
        }
      </div>
      <div class="w-full lg:w-1/2">
        <p class="font-label-caps text-label-caps text-primary uppercase m-0 mb-4">{eyebrow}</p>
        <h2 class="font-headline-lg text-headline-lg text-on-surface m-0 mb-6">{title}</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant m-0 mb-10">{body}</p>
        <a
          class="no-underline bg-primary text-on-primary px-8 py-4 rounded font-button text-button inline-flex items-center gap-2 hover:bg-primary-container transition-colors"
          href={ctaHref}
        >
          {ctaLabel}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
