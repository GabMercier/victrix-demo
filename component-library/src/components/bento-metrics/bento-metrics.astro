---
import { FOND_CLASSES, type FondKey } from '../../shared/fonds';
import { blockHtml, hasRichText, inlineHtml } from '../../shared/rich';
import { iconFor, iconSvgAttrs, type IconKey } from '../../shared/icons';
/**
 * Section « Bento métriques » — composant Bookshop, NOUVEAU 2026-08-24.
 * FIDÉLITÉ MAQUETTE (docs/produits.css §Section - Value Proposition & Metrics
 * (Bento Grid), « Studio de création » — style catalogue/produit) : tête
 * centrée (H2 36/40 ls -0.9 + intro 16/24 max 672), puis grille bento 2/3+1/3 —
 *  - carte SOMBRE (2 colonnes) : aplat Bleu nuit rayon 24, titre 30/36 blanc,
 *    texte 16/26 (max 448), rangée de puces-métriques « verre » (fond blanc
 *    10 % + blur 2, libellé 12 + valeur 20/700), grand pictogramme en
 *    FILIGRANE blanc 10 % débordant en bas à droite ;
 *  - carte CLAIRE (1 colonne) : fond gris perle rayon 24 bordé froid, tuile
 *    icône 48 bleue sur bleu 10 % rayon 12, titre 20/28, texte 14/20, lien
 *    bleu 14/700 à flèche, calé au bas de la carte.
 * Couleurs = TOKENS (#001B44→on-primary-fixed [Bleu nuit], #EDEEEF→
 * surface-container, #00020A→on-surface, #44474F→on-surface-variant,
 * #0038E6→primary) ; texte atténué de la carte sombre #7084B3→blanc 70 %
 * (idiome a11y des aplats nuit — voir cta variante « nuit ») ; bordure froide
 * rgba(197,198,208,.3) VERBATIM (famille C4C5D9).
 *
 * Props : { type: "bento-metrics", title, intro?, fond?,
 *           featured: { title, text?, watermark?, stats: [{value,label}] },
 *           aside?: { icon?, title, text?, linkLabel?, linkHref? } }
 * - `watermark` (carte sombre) et `icon` (carte claire) : clé de la BANQUE de pictogrammes (shared/icons.ts — toute la banque est offerte dans l'éditeur depuis le 2026-09-18) ;
 *   "" = rien. Maquette : éclair / engrenage / graphique en filigrane, coche /
 *   bouclier / étoile en tuile. Noms de champ DISTINCTS à dessein : un même nom
 *   partagerait sa config _inputs CloudCannon (chemins imbriqués non
 *   supportés, gotcha consigné 2026-07-20) ;
 * - `stats` : mêmes {value,label} que strategic-value (_structures.stat_tiles).
 *
 * Contraintes / pièges :
 * - <h2> de section, <h3> par carte : le <h1> unique appartient au héros.
 * - `featured`/`aside` peuvent être absents PENDANT l'édition CloudCannon —
 *   chaque carte est gardée (rien ne rend tant que l'objet n'existe pas).
 * - `featured.text` peut contenir des <strong> → set:html (contenu de dépôt).
 * - Filigrane : parent `overflow-hidden isolate` + `-z-10` (patron cta).
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  intro?: string;
  fond?: FondKey;
  featured?: {
    title: string;
    text?: string;
    watermark?: IconKey | '';
    stats?: Stat[];
  };
  aside?: {
    icon?: IconKey | '';
    title: string;
    text?: string;
    linkLabel?: string;
    linkHref?: string;
  };
}

const { title, intro, fond = 'blanc', featured, aside } = Astro.props;

// « Fond de section » : clé fermée → utilitaire de la palette officielle.
const FONDS: Record<string, string> = FOND_CLASSES;

const stats = featured?.stats ?? [];

const watermark = iconFor(featured?.watermark);
const asideIcon = iconFor(aside?.icon);
---

<section class:list={['py-20 lg:py-24', FONDS[fond] ?? FONDS.blanc]}>
  <div class="container-site flex flex-col gap-12 lg:gap-16">
    <div class="max-w-[672px] mx-auto flex flex-col items-center text-center gap-4">
      <h2 class="text-[28px] leading-[1.15] lg:text-4xl lg:leading-10 font-bold tracking-[-0.9px] text-on-surface m-0 text-balance">
        {title}
      </h2>
      {hasRichText(intro) && <div class="rich text-base leading-6 text-on-surface-variant max-w-none" set:html={blockHtml(intro)} />}
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {
        featured && (
          <div class="relative overflow-hidden isolate lg:col-span-2 bg-on-primary-fixed rounded-3xl p-8 lg:p-10 flex flex-col gap-8">
            {watermark && (
              <svg
                class="absolute -right-8 -bottom-10 text-white opacity-10 -z-10"
                width="190"
                height="190"
                {...iconSvgAttrs(watermark, 1.2)}
                aria-hidden="true"
                focusable="false"
              >
                {watermark.paths.map((d) => (
                  <path d={d} />
                ))}
              </svg>
            )}
            <div class="flex flex-col gap-4">
              <h3 class="text-2xl leading-8 lg:text-[30px] lg:leading-9 font-bold text-white m-0">{featured.title}</h3>
              {featured.text && <p class="text-base leading-[26px] text-white/70 m-0 max-w-[448px]" set:html={inlineHtml(featured.text)} />}
            </div>
            {stats.length > 0 && (
              <ul role="list" class="flex flex-wrap gap-4 m-0 mt-auto p-0 list-none">
                {stats.map((stat) => (
                  <li class="m-0 bg-white/10 backdrop-blur-[2px] rounded-lg px-4 py-2 flex flex-col">
                    <span class="text-xs leading-4 text-white/70">{stat.label}</span>
                    <span class="text-xl leading-7 font-bold text-white">{stat.value}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
      {
        aside && (
          <div class="bg-surface-container border border-solid border-[#C5C6D0]/30 rounded-3xl p-8 lg:p-10 flex flex-col items-start">
            {asideIcon && (
              <span class="size-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
                <svg
                  class="text-primary"
                  width="22"
                  height="22"
                  {...iconSvgAttrs(asideIcon, 1.8)}
                  aria-hidden="true"
                  focusable="false"
                >
                  {asideIcon.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
            )}
            <h3 class="text-xl leading-7 font-bold text-on-surface m-0 mb-2">{aside.title}</h3>
            {aside.text && <p class="text-sm leading-5 text-on-surface-variant m-0 max-w-none">{aside.text}</p>}
            {aside.linkLabel && aside.linkHref && (
              <a
                class="no-underline inline-flex items-center gap-2 pt-6 mt-auto text-sm leading-5 font-bold text-primary hover:text-primary-container transition-colors"
                href={aside.linkHref}
              >
                {aside.linkLabel}
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 12h14m0 0-6-6m6 6-6 6" />
                </svg>
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
