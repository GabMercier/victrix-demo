---
/**
 * Section « Héros de service » — composant Bookshop (P-07).
 *
 * Props : { type: "service-hero", eyebrow?, titleAccent?, title, lead?,
 *           ctaLabel?, ctaHref?, image?, imageAlt? }
 * - `type` est le discriminant du contrat sections ; il arrive via le spread
 *   {...section} depuis la route et est volontairement ignoré ici.
 *
 * Port fidèle du héros de la page expertise (src/pages/[lang]/expertises/
 * intelligence-artificielle.astro) vers une section composable réutilisable.
 *
 * Contraintes / pièges :
 * - Rend le SEUL <h1> de la page → à placer en PREMIÈRE position. Le <h1>
 *   contient le surtitre accentué (bloc) suivi du titre.
 * - `lead` peut contenir des <strong> → rendu set:html (contenu de dépôt,
 *   même politique que la page expertise d'origine).
 * - `image` = chemin PUBLIC servi tel quel (ex. /images/services/…-hero.png) :
 *   aucun astro:assets (le composant doit compiler dans le navigateur pour
 *   l'éditeur visuel CloudCannon — même règle que testimonial/video/faq).
 * - Aucun script client ; chaque var(--token, secours) embarque la valeur de
 *   src/styles/tokens.css pour un rendu fidèle hors du site (éditeur visuel).
 */
interface Props {
  eyebrow?: string;
  titleAccent?: string;
  title: string;
  lead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, titleAccent, title, lead, ctaLabel, ctaHref, image, imageAlt } = Astro.props;
---

<section class="svc-hero">
  <div class="svc-hero__container">
    <div class="svc-hero__text">
      {eyebrow && <p class="svc-hero__eyebrow">{eyebrow}</p>}
      <h1 class="svc-hero__title">
        {titleAccent && <span class="svc-hero__title-accent">{titleAccent}</span>}
        {title}
      </h1>
      {lead && <p class="svc-hero__lead" set:html={lead}></p>}
      {
        /* Le bouton n'est rendu que si le libellé ET le lien sont fournis. */
        ctaLabel && ctaHref && (
          <a class="svc-hero__cta" href={ctaHref}>
            {ctaLabel}
          </a>
        )
      }
    </div>
    {image && <img class="svc-hero__img" src={image} alt={imageAlt ?? ''} loading="eager" />}
  </div>
</section>

<style>
  /* Même langage visuel que le héros de la page expertise : dégradé marine,
     surtitre vert accent, titre inversé, image à droite. */
  .svc-hero {
    background:
      radial-gradient(120% 130% at 90% 10%, var(--color-navy-700, #0b4b71) 0%, transparent 55%),
      linear-gradient(120deg, var(--color-navy-900, #052639) 0%, var(--color-navy, #083957) 70%);
    color: var(--color-text-invert, #ffffff);
    font-family: var(--font-sans, 'Montserrat', system-ui, sans-serif);
  }

  /* Conteneur répliqué localement (pas la classe globale .container) pour que
     le composant reste autonome dans l'éditeur visuel. */
  .svc-hero__container {
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--container-pad, 1.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 2rem);
    align-items: center;
    padding-block: var(--space-9, 6rem);
  }
  @media (min-width: 900px) {
    .svc-hero__container {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-8, 4rem);
    }
  }

  .svc-hero__eyebrow {
    margin: 0 0 var(--space-4, 1rem);
    color: var(--color-accent-green, #24fb8e);
    font-weight: var(--fw-semibold, 600);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-200, 0.9375rem);
  }

  .svc-hero__title {
    margin: 0;
    color: var(--color-text-invert, #ffffff);
    font-size: var(--fs-800, clamp(2.5rem, 3.5vw + 1.5rem, 4rem));
    font-weight: var(--fw-extrabold, 800);
    line-height: var(--lh-tight, 1.15);
    text-wrap: balance;
  }
  .svc-hero__title-accent {
    display: block;
    color: var(--color-accent-green, #24fb8e);
  }

  .svc-hero__lead {
    margin: var(--space-5, 1.5rem) 0 0;
    max-width: 60ch;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-400, clamp(1.125rem, 0.2vw + 1.05rem, 1.25rem));
    line-height: var(--lh-normal, 1.6);
    text-wrap: pretty;
  }
  .svc-hero__lead :global(strong) {
    color: var(--color-text-invert, #ffffff);
  }

  .svc-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-6, 2rem);
    padding: 0.7em 1.5em;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-pill, 999px);
    color: var(--color-text-invert, #ffffff);
    font-size: var(--fs-200, 0.9375rem);
    font-weight: var(--fw-semibold, 600);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .svc-hero__cta:hover {
    background-color: var(--color-white, #ffffff);
    color: var(--color-navy, #083957);
  }

  .svc-hero__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-l, 16px);
    box-shadow: var(--shadow-3, 0 12px 32px rgba(20, 33, 61, 0.14));
  }
</style>
