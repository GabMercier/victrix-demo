---
/**
 * Section « Témoignage » — composant Bookshop (palette partagée).
 *
 * Props : { type: "testimonial", quote, name, role?, organization?, photo? }
 * - `type` est le discriminant du contrat de sections ; il arrive via le
 *   spread {...section} depuis le renderer partagé et est ignoré ici.
 *
 * Contraintes / pièges (voir faq.astro pour le détail des conventions) :
 * - <h2> interdit ici : un témoignage n'a pas de titre de section — le
 *   blockquote est le contenu. Aucun impact sur la hiérarchie de titres.
 * - `photo` est un CHEMIN (chaîne) servi tel quel — pas d'astro:assets
 *   (composant rendu dans le navigateur par l'éditeur visuel). Vide ou
 *   absente → pastille d'initiales générée en pur CSS/texte.
 * - Chaque var(--token, secours) embarque la valeur de src/styles/tokens.css
 *   pour un rendu fidèle dans l'éditeur visuel (global.css absente).
 */

interface Props {
  quote: string;
  name: string;
  role?: string;
  organization?: string;
  photo?: string;
}

const { quote, name, role = '', organization = '', photo = '' } = Astro.props;

// Pastille de secours : initiales dérivées du nom (« Jeanne Tremblay » → JT).
const initials = (name ?? '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0].toUpperCase())
  .join('');

const attribution = [role, organization].filter((v) => v !== '').join(', ');
---

<section class="lp-testimonial">
  <div class="lp-testimonial__container">
    <figure class="lp-testimonial__figure">
      <blockquote class="lp-testimonial__quote">
        <p>{quote}</p>
      </blockquote>
      <figcaption class="lp-testimonial__caption">
        {
          photo !== '' ? (
            <img class="lp-testimonial__photo" src={photo} alt="" width="56" height="56" loading="lazy" />
          ) : (
            <span class="lp-testimonial__initials" aria-hidden="true">
              {initials}
            </span>
          )
        }
        <span class="lp-testimonial__who">
          <span class="lp-testimonial__name">{name}</span>
          {attribution !== '' && <span class="lp-testimonial__role">{attribution}</span>}
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .lp-testimonial {
    padding-block: var(--space-9, 6rem);
    background-color: var(--color-surface, #f4f6f8);
    color: var(--color-text, #1a1c20);
    font-family: var(--font-sans, 'Montserrat', system-ui, sans-serif);
  }

  /* Conteneur répliqué localement (pas la classe globale .container) pour que
     le composant reste autonome dans l'éditeur visuel. */
  .lp-testimonial__container {
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--container-pad, 1.5rem);
  }

  .lp-testimonial__figure {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .lp-testimonial__quote {
    margin: 0;
    position: relative;
  }
  /* Guillemet décoratif en pur CSS — pas d'image ni de police d'icônes. */
  .lp-testimonial__quote::before {
    content: '\201C';
    display: block;
    color: var(--color-accent-blue, #3366ff);
    font-size: 4rem;
    font-weight: var(--fw-bold, 700);
    line-height: 1;
  }
  .lp-testimonial__quote p {
    margin: 0;
    color: var(--color-navy, #083957);
    font-size: var(--fs-500, clamp(1.25rem, 1vw + 1rem, 1.5rem));
    font-weight: var(--fw-medium, 500);
    line-height: var(--lh-snug, 1.4);
    text-wrap: balance;
  }

  .lp-testimonial__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3, 0.75rem);
    margin-top: var(--space-6, 2rem);
  }

  .lp-testimonial__photo,
  .lp-testimonial__initials {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
  }
  .lp-testimonial__photo {
    object-fit: cover;
  }
  .lp-testimonial__initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-navy, #083957);
    color: var(--color-white, #ffffff);
    font-weight: var(--fw-semibold, 600);
  }

  .lp-testimonial__who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .lp-testimonial__name {
    color: var(--color-navy, #083957);
    font-weight: var(--fw-semibold, 600);
  }
  .lp-testimonial__role {
    color: var(--color-text-muted, #4a4d54);
    font-size: var(--fs-200, 0.875rem);
  }
</style>
