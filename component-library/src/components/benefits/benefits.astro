---
/**
 * Section « Cartes à icônes » (clé technique `benefits` — renommage
 * d'affichage 2026-08-17, le bloc sert au-delà des bénéfices : approche,
 * valeurs…) — composant Bookshop (contrat landing GELÉ, enrichi).
 * FIDÉLITÉ MAQUETTE 2026-08-05 (docs/design/expertise-mere.css §Approche
 * Section, « Notre approche humaine ») : fond blanc py-80, tête CENTRÉE
 * (H2 40/700 ls -0.4 + intro 18/29), grille de cartes bordées #C3C6D7 rayon 2
 * p-32 — tuile icône 48 px bleu pâle (primary-fixed) avec pictogramme bleu,
 * titre 24/700, texte 16/24. Bleus/navy/textes = tokens (export Hanken/chaud) ;
 * bordure froide #C3C6D7 verbatim (précédent méga).
 *
 * Props : { type: "benefits", title, intro?, headingStyle?, items: [{ title,
 *           description, icon? }] }
 * - `icon` (clé fermée « dossier » | « personne » | « groupe » | « ampoule » |
 *   « croissance » | « losange » | « organisation » | « porteur » |
 *   « destinataire » | "" — vide = pas de tuile) ; ampoule/croissance/losange
 *   AJOUTÉES 2026-08-05 (landing-page.css) ; organisation/porteur/destinataire
 *   AJOUTÉES 2026-08-17 (page Expertises, SVG PLEINS fournis par le client —
 *   docs/design/export2/Images). Contrat existant intact.
 * - `headingStyle` AJOUTÉ 2026-08-05 (landing-page.css §Guide Benefits) :
 *   « titre » (défaut, H2 40/700 centré) | « compact » (tête réduite 16/24
 *   centrée + liseré bleu 64×4 dessous — patron des têtes de la landing).
 *
 * Contraintes / pièges :
 * - <h2> de section et <h3> par carte : le <h1> unique appartient au héros.
 * - `items = []` en secours (édition en direct CloudCannon).
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface BenefitItem {
  title: string;
  description: string;
  icon?:
    | 'dossier'
    | 'personne'
    | 'groupe'
    | 'ampoule'
    | 'croissance'
    | 'losange'
    | 'organisation'
    | 'porteur'
    | 'destinataire'
    | '';
}

interface Props {
  title: string;
  intro?: string;
  headingStyle?: 'titre' | 'compact';
  fond?: 'blanc' | 'givre' | 'ivoire' | 'beige' | 'sable';
  items: BenefitItem[];
}

const { title, intro, headingStyle = 'titre', fond = 'blanc', items = [] } = Astro.props;
const compact = headingStyle === 'compact';

// « Fond de section » (2026-08-17, pilote 6 blocs) : clé fermée → utilitaire
// de la palette officielle (aucune couleur libre — esprit P-16). 5 fonds
// CLAIRS seulement ; défaut = rendu historique du bloc (blanc).
const FONDS: Record<string, string> = {
  blanc: 'bg-white',
  givre: 'bg-givre',
  ivoire: 'bg-ivoire',
  beige: 'bg-beige',
  sable: 'bg-sable',
};

// Pictogrammes (stroke 24px) par clé fermée du contrat.
const ICONS: Record<string, string[]> = {
