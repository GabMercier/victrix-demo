---
import { FOND_CLASSES, type FondKey } from '../../shared/fonds';
import { blockHtml, hasRichText, inlineHtml } from '../../shared/rich';
import { iconFor, iconSvgAttrs, type IconKey } from '../../shared/icons';
/**
 * Section « Cartes à icônes » (clé technique `benefits` — renommage
 * d'affichage 2026-08-17, le bloc sert au-delà des bénéfices : approche,
 * valeurs…) — composant Bookshop (contrat landing GELÉ, enrichi).
 * FIDÉLITÉ MAQUETTE 2026-08-05 (docs/design/expertise-mere.css §Approche
 * Section, « Notre approche humaine ») : fond blanc py-80, tête CENTRÉE
 * (H2 40/700 ls -0.4 + intro 18/29), grille de cartes bordées #C3C6D7 rayon 2
 * p-32 — tuile icône 48 px bleu pâle (primary-fixed) avec pictogramme bleu,
 * titre 24/700, texte 16/24. Bleus/navy/textes = tokens (export Hanken/chaud) ;
 * bordure froide #C3C6D7 verbatim (précédent méga).
 *
 * Props : { type: "benefits", title, intro?, headingStyle?, items: [{ title,
 *           description, icon? }] }
 * - `icon` : clé de la BANQUE de pictogrammes (shared/icons.ts — toute la banque est offerte dans l'éditeur depuis le 2026-09-18) ; "" = pas de
 *   tuile. Trait 2 px ; les glyphes PLEINS fournis par le client pour la page
 *   Expertises (organisation/porteur/destinataire, docs/design/export2/Images)
 *   gardent leur taille native (`w`/`h` de la banque).
 * - `headingStyle` AJOUTÉ 2026-08-05 (landing-page.css §Guide Benefits) :
 *   « titre » (défaut, H2 40/700 centré) | « compact » (tête réduite 16/24
 *   centrée + liseré bleu 64×4 dessous — patron des têtes de la landing).
 *
 * Contraintes / pièges :
 * - <h2> de section et <h3> par carte : le <h1> unique appartient au héros.
 * - `items = []` en secours (édition en direct CloudCannon).
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface BenefitItem {
  title: string;
  description: string;
  icon?: IconKey | '';
}

interface Props {
  title: string;
  intro?: string;
  headingStyle?: 'titre' | 'compact';
  fond?: FondKey;
  items: BenefitItem[];
}

const { title, intro, headingStyle = 'titre', fond = 'blanc', items = [] } = Astro.props;
const compact = headingStyle === 'compact';

// « Fond de section » (2026-08-17, pilote 6 blocs) : clé fermée → utilitaire
// de la palette officielle (aucune couleur libre — esprit P-16). 5 fonds
// CLAIRS seulement ; défaut = rendu historique du bloc (blanc).
const FONDS: Record<string, string> = FOND_CLASSES;

---

<section class:list={['py-20', FONDS[fond] ?? FONDS.blanc]}>
  <div class="container-site">
    {
      compact ? (
        <div class="mx-auto text-center flex flex-col items-center gap-4 mb-16">
          <h2 class="text-[32px] leading-[39px] font-bold text-on-surface m-0">{title}</h2>
          <span class="w-16 h-1 bg-primary" aria-hidden="true" />
          {hasRichText(intro) && <div class="rich text-base leading-6 text-on-surface-variant max-w-[672px]" set:html={blockHtml(intro)} />}
        </div>
      ) : (
        <div class="max-w-[672px] mx-auto text-center flex flex-col gap-4 mb-16">
          <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0">
            {title}
          </h2>
          {hasRichText(intro) && <div class="rich text-lg leading-[29px] text-on-surface-variant max-w-none" set:html={blockHtml(intro)} />}
        </div>
      )
    }
    <ul role="list" class:list={['grid grid-cols-1 md:grid-cols-3 m-0 p-0 list-none', compact ? 'gap-6' : 'gap-8']}>
      {
        items.map((item) => {
          const icon = iconFor(item.icon);
          return (
          <li
            class:list={[
              'm-0 bg-white border border-solid rounded-sm p-8 flex flex-col gap-4',
              compact ? 'pb-14 border-[#E5E2DE] shadow-[0_1px_2px_rgba(0,0,0,0.05)] rounded-xs' : 'border-[#C3C6D7]',
            ]}
          >
            {icon && (
              <span
                class:list={[
                  'size-12 text-primary flex items-center justify-center',
                  compact ? 'rounded-xs bg-primary/10' : 'rounded-sm bg-primary-fixed',
                ]}
              >
                <svg
                  width={icon.w ?? 18}
                  height={icon.h ?? 18}
                  {...iconSvgAttrs(icon, 2)}
                  aria-hidden="true"
                  focusable="false"
                >
                  {icon.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </span>
            )}
            <h3 class:list={['text-on-surface m-0 pt-2', compact ? 'text-base leading-6 font-normal' : 'text-2xl leading-8 font-bold']}>
              {item.title}
            </h3>
            <p class="text-base leading-6 text-on-surface-variant m-0 max-w-none" set:html={inlineHtml(item.description)} />
          </li>
          );
        })
      }
    </ul>
  </div>
</section>
