---
/**
 * Section « Bannière d'accueil » — composant Bookshop (accueil composable).
 * RE-SKIN 2026-08-04 (lot accueil, Phase 5) : patron du HÉROS de la maquette
 * Accueil.html NORMALISÉ sur le design system (décisions v2 + « garder le vibe
 * de la maquette ») — héros CLAIR : photo pleine largeur voilée d'ivoire,
 * surtitre label-caps Bleu Victrix, titre display anthracite, double CTA
 * (primaire plein + secondaire contour ; la maquette posait bg-secondary,
 * normalisé primary).
 *
 * Props : { type: "home-hero", eyebrow?, title, subtitle, ctaLabel, ctaHref,
 *           image?, cta2Label?, cta2Href? } — nouveaux champs OPTIONNELS
 * (chaîne vide = absent, convention du dépôt) : l'ancien contenu reste valide.
 * `image` est un chemin PUBLIC servi tel quel (pas d'astro:assets — l'éditeur
 * visuel CloudCannon recompile ce composant pour le navigateur).
 *
 * RÈGLE no-hybride : composant re-skinné = 100 % utilitaires Tailwind
 * (theme.css), zéro CSS scopé. Preflight absent → border-solid explicites,
 * m-0 sur les éléments typographiques.
 * Rend le SEUL <h1> de la page : à garder en première position.
 */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  image?: string;
  cta2Label?: string;
  cta2Href?: string;
}

const { eyebrow, title, subtitle, ctaLabel, ctaHref, image, cta2Label, cta2Href } = Astro.props;
---

<section class="relative min-h-[640px] flex items-center overflow-hidden bg-surface">
  {
    image && (
      <div class="absolute inset-0" aria-hidden="true">
        <img src={image} alt="" class="w-full h-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-r from-surface via-surface/85 to-surface/25" />
      </div>
    )
  }
  <div class="relative z-10 max-w-container-max mx-auto px-margin-x w-full py-20">
    <div class="max-w-3xl">
      {eyebrow && <p class="font-label-caps text-label-caps text-primary uppercase m-0 mb-6">{eyebrow}</p>}
      <h1 class="font-display text-display text-on-surface m-0 mb-6 text-balance">{title}</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant m-0 mb-10 max-w-2xl">{subtitle}</p>
      <div class="flex flex-wrap gap-4">
        <a
          class="no-underline bg-primary text-on-primary px-8 py-4 rounded font-button text-button inline-flex items-center gap-2 hover:bg-primary-container transition-colors"
          href={ctaHref}
        >
          {ctaLabel}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        {
          cta2Label && cta2Href && (
            <a
              class="no-underline border border-solid border-outline text-on-surface px-8 py-4 rounded font-button text-button inline-flex items-center hover:bg-surface-variant transition-colors"
              href={cta2Href}
            >
              {cta2Label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
