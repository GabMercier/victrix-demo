---
/**
 * Section « Boîtes de domaines » — composant Bookshop (P-07).
 * RE-SKIN DESIGN SYSTEM 2026-08-05 : tête centrée (H2 40/700 ls -0.4 +
 * liseré bleu 64×4 — patron des têtes landing), grille de tuiles bordées
 * #C4C5D9 (verbatim, précédent méga) à libellé 16/600, survol bordure bleue
 * (patron des tuiles valeurs de la page Carrières). L'ancien thème
 * navy/liseré vert disparaît.
 *
 * Props : { type: "feature-boxes", sectionTitle, subtitle?, boxes: string[] }
 *
 * Contraintes / pièges :
 * - <h2> : le <h1> unique appartient au héros.
 * - `boxes = []` en secours pour ne pas planter l'éditeur pendant la saisie.
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface Props {
  sectionTitle: string;
  subtitle?: string;
  boxes: string[];
}

const { sectionTitle, subtitle, boxes = [] } = Astro.props;
---

<section class="py-20 bg-surface-container-low">
  <div class="container-site">
    <div class="mx-auto text-center flex flex-col items-center gap-4 mb-12">
      <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0 max-w-[24ch] text-balance">
        {sectionTitle}
      </h2>
      <span class="w-16 h-1 bg-primary" aria-hidden="true"></span>
      {subtitle && <p class="text-base leading-[26px] text-on-surface-variant m-0 max-w-[672px]">{subtitle}</p>}
    </div>
    <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 m-0 p-0 list-none">
      {
        boxes.map((box) => (
          <li class="m-0 min-h-24 flex items-center justify-center text-center p-6 bg-white border border-solid border-[#C4C5D9] rounded-xs text-base font-semibold text-on-surface hover:border-primary transition-colors">
            {box}
          </li>
        ))
      }
    </ul>
  </div>
</section>
