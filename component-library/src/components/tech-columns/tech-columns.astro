---
/**
 * Section « Colonnes de technologies » — composant Bookshop (P-07).
 *
 * Props : { type: "tech-columns", sectionTitle,
 *           groups: [{ title, items: string[], subgroup?: { label, items } }] }
 *
 * Port fidèle du bloc « expertise multitechnologique » de la page expertise :
 * grille de colonnes bordées, chacune un titre + une liste à puces vertes, avec
 * un sous-groupe étiqueté optionnel (ex. « Sources ouvertes et locales : »).
 * Les noms de technologies, jadis codés en dur dans le gabarit, deviennent du
 * CONTENU éditable ici.
 *
 * Contraintes / pièges :
 * - <h2> de section, <h3> par colonne : le <h1> unique appartient au héros.
 * - `groups = []` en secours pour ne pas planter l'éditeur pendant la saisie.
 * - Aucun script client ; var(--token, secours) reprend src/styles/tokens.css.
 */
interface Group {
  title: string;
  items: string[];
  subgroup?: { label: string; items: string[] };
}
interface Props {
  sectionTitle: string;
  groups: Group[];
}

const { sectionTitle, groups = [] } = Astro.props;
---

<section class="tc">
  <div class="tc__container">
    <h2 class="tc__title">{sectionTitle}</h2>
    <div class="tc__grid">
      {
        groups.map((group) => (
          <div class="tc__col">
            <h3 class="tc__col-title">{group.title}</h3>
            <ul role="list" class="tc__list">
              {(group.items ?? []).map((it) => (
                <li>{it}</li>
              ))}
              {group.subgroup && (group.subgroup.label || (group.subgroup.items ?? []).length > 0) && (
                <li>
                  {group.subgroup.label}
                  <ul role="list" class="tc__sublist">
                    {(group.subgroup.items ?? []).map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tc {
    padding-block: var(--space-9, 6rem);
    background-color: var(--color-bg, #ffffff);
    color: var(--color-text, #1a1c20);
    font-family: var(--font-sans, 'Montserrat', system-ui, sans-serif);
  }

  /* Conteneur répliqué localement (pas la classe globale .container). */
  .tc__container {
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--container-pad, 1.5rem);
  }

  /* Titre à liseré vert (équivalent .s-head de la page expertise). */
  .tc__title {
    position: relative;
    margin: 0 auto;
    max-width: 24ch;
    padding-bottom: var(--space-4, 1rem);
    text-align: center;
    color: var(--color-navy, #083957);
    font-size: var(--fs-700, clamp(2rem, 2vw + 1.4rem, 3rem));
    font-weight: var(--fw-bold, 700);
    line-height: var(--lh-tight, 1.15);
    text-wrap: balance;
  }
  .tc__title::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 220px;
    max-width: 60%;
    height: 3px;
    background-color: var(--color-accent-green, #24fb8e);
    border-radius: 2px;
  }

  .tc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5, 1.5rem);
    margin-top: var(--space-7, 3rem);
  }
  @media (min-width: 760px) {
    .tc__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tc__col {
    padding: var(--space-6, 2rem);
    border: 1.5px solid var(--color-accent-green, #24fb8e);
    border-radius: var(--radius-m, 8px);
  }
  .tc__col-title {
    margin: 0 0 var(--space-4, 1rem);
    text-align: center;
    color: var(--color-navy, #083957);
    font-size: var(--fs-500, clamp(1.375rem, 0.6vw + 1.2rem, 1.75rem));
    font-weight: var(--fw-semibold, 600);
    line-height: var(--lh-snug, 1.3);
  }
  .tc__list {
    list-style: disc;
    padding-left: var(--space-5, 1.5rem);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    color: var(--color-text-muted, #4a4d54);
    line-height: var(--lh-normal, 1.6);
  }
  .tc__sublist {
    list-style: disc;
    padding-left: var(--space-5, 1.5rem);
    margin-top: var(--space-2, 0.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }
  .tc__list :global(li)::marker {
    color: var(--color-accent-green, #24fb8e);
  }
</style>
