---
/**
 * Section « Bandeau experts » — composant Bookshop (accueil composable).
 * RE-SKIN 2026-08-04 (lot accueil, Phase 5) : patron « Bottom CTA Banner » de
 * la maquette Accueil.html normalisé système — panneau SABLE arrondi (couches
 * tonales, pas d'aplat marine), grand titre, bouton primaire (la maquette
 * posait bg-secondary, normalisé primary — décision CTA).
 *
 * Props : { type: "home-experts", title, subtitle, ctaLabel, ctaHref }
 * (contrat inchangé). Browser-safe (éditeur visuel CloudCannon), aucun import.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface Props {
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
}

const { title, subtitle, ctaLabel, ctaHref } = Astro.props;
---

<section class="py-section-gap bg-surface">
  <div class="max-w-container-max mx-auto px-margin-x">
    <div class="bg-surface-container-high rounded-lg p-12 lg:p-20 flex flex-col lg:flex-row justify-between items-center gap-12">
      <div class="text-center lg:text-left max-w-2xl">
        <h2 class="font-headline-lg text-headline-lg text-on-surface m-0 mb-4">{title}</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant m-0">{subtitle}</p>
      </div>
      <a
        class="no-underline bg-primary text-on-primary px-12 py-5 rounded font-button text-button uppercase tracking-widest hover:bg-primary-container transition-colors shadow-lg whitespace-nowrap"
        href={ctaHref}
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>
