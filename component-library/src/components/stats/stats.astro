---
import { FOND_CLASSES, type FondKey } from '../../shared/fonds';
import { iconFor, iconSvgAttrs, type IconKey } from '../../shared/icons';
/**
 * Section « Victrix en chiffres » — composant Bookshop (palette partagée).
 * RE-SKIN DESIGN SYSTEM 2026-08-05 : bande beige (surface-container-low),
 * titre centré 40/700 ls -0.4, tuiles statistiques au patron strategic-value —
 * fond blanc, LISERÉ GAUCHE bleu 4 px, valeur 40/700 bleue, étiquette 12/700
 * majuscules ls 1.2. L'ancien thème navy/vert disparaît.
 *
 * DEUX STYLES (2026-09-16, parité avec le site WordPress actuel — page
 * Services gérés) :
 * - « bande » (défaut, rendu historique) : section pleine largeur, tuiles à
 *   liseré, jusqu'à 4 colonnes.
 * - « carte » : UNE carte blanche translucide, centrée, qui CHEVAUCHE le bas
 *   de la section précédente (héros) — 3 colonnes, pictogramme au-dessus du
 *   chiffre, chiffre bleu, libellé gris. À placer juste APRÈS un héros ; le
 *   chevauchement vient d'une marge négative sur la carte elle-même (la
 *   section garde son fond, elle commence là où le héros finit).
 *
 * Props : { type: "stats", title?, style?, fond?, items: [{ number, label, icon? }] }
 * - `number` est une CHAÎNE affichée telle quelle (« 25+ », « 99,9 % ») —
 *   aucun formatage numérique imposé, le marketing garde la main.
 * - `icon` : clé de la BANQUE de pictogrammes (shared/icons.ts — toute la banque est offerte dans l'éditeur depuis le 2026-09-18) — trait
 *   1,5 px, rendu seulement en style « carte » (la bande n'en a jamais eu).
 *   Maquette : groupe-mains, engrenage-horloge, bouclier. Vide/inconnue = aucun.
 *
 * Contraintes / pièges :
 * - `items = []` en secours (édition en direct CloudCannon).
 * - <h2> optionnel : rendu seulement si un titre est fourni (sous la carte en
 *   style « carte », pour ne pas casser le chevauchement).
 * - Liseré gauche : `border-0 border-l-4 border-solid` OBLIGATOIRE (piège
 *   border-solid/UA-medium sans preflight, consigné au lot chrome).
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */

interface StatItem {
  number: string;
  label: string;
  icon?: IconKey | '';
}

interface Props {
  title?: string;
  style?: 'bande' | 'carte';
  fond?: FondKey;
  items: StatItem[];
}

const { title = '', style = 'bande', fond = 'beige', items = [] } = Astro.props;
const carte = style === 'carte';

// « Fond de section » (2026-08-17, pilote 6 blocs) : clé fermée → utilitaire
// de la palette officielle (aucune couleur libre — esprit P-16). Défaut =
// rendu historique (givre #f9fafb, ex-bg-surface-container-low).
const FONDS: Record<string, string> = FOND_CLASSES;

---

{
  carte ? (
    <section class:list={['pb-16 lg:pb-20', FONDS[fond] ?? FONDS.givre]}>
      <div class="container-site flex flex-col gap-12">
        {/* La carte remonte SUR la section précédente (héros) : marge négative +
            z-index ; la section, elle, commence à la fin du héros. */}
        <ul
          role="list"
          class="relative z-10 -mt-16 lg:-mt-24 mx-auto w-full max-w-[1100px] grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 bg-white/90 backdrop-blur-md rounded-3xl shadow-[0_24px_48px_-24px_rgba(15,23,42,0.35)] border border-solid border-white px-8 py-10 lg:px-16 lg:py-12 m-0 list-none"
        >
          {items.map((item) => {
            const icon = iconFor(item.icon);
            return (
            <li class="m-0 flex flex-col items-center text-center gap-3">
              {icon && (
                <svg
                  class="size-12 text-on-surface"
                  {...iconSvgAttrs(icon, 1.5)}
                  aria-hidden="true"
                >
                  {icon.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              )}
              <p class="text-[28px] leading-8 font-bold text-primary m-0">{item.number}</p>
              <p class="text-lg leading-7 text-on-surface-variant m-0 max-w-[280px]">{item.label}</p>
            </li>
            );
          })}
        </ul>
        {title !== '' && (
          <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0 text-center">
            {title}
          </h2>
        )}
      </div>
    </section>
  ) : (
    <section class:list={['py-20', FONDS[fond] ?? FONDS.givre]}>
      <div class="container-site flex flex-col gap-12">
        {title !== '' && (
          <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0 text-center">
            {title}
          </h2>
        )}
        <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 m-0 p-0 list-none">
          {items.map((item) => (
            <li class="m-0 bg-white border-0 border-l-4 border-solid border-primary p-6 flex flex-col gap-3 shadow-[0_1px_2px_rgba(0,0,0,0.05)]">
              <p class="text-[40px] leading-[48px] font-bold text-primary m-0">{item.number}</p>
              <p class="text-xs font-bold uppercase tracking-[1.2px] text-on-surface-variant m-0 max-w-none">{item.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
