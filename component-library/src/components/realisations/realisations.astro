---
import { FOND_CLASSES, type FondKey } from '../../shared/fonds';
import { blockHtml, hasRichText, inlineHtml } from '../../shared/rich';
import { iconFor, iconSvgAttrs, type IconKey } from '../../shared/icons';
/**
 * Section « Réalisations » — composant Bookshop, NOUVEAU 2026-08-05.
 * FIDÉLITÉ MAQUETTE (docs/design/produit-enfant.css §Section - Réalisations
 * (Bento Grid Style), « Page Produit - Enfant ») : fond ivoire (surface)
 * py-80, tête en DEUX blocs alignés au bas — à gauche titre 40/700 ls -0.4 +
 * texte 16/26 (max 576) ; à droite LIEN souligné d'un liseré bleu 2 px
 * (14/600 ls 0.28 bleu + flèche) — puis grille de 4 cartes blanches bordées
 * (jeton `contour`, rayon 8, p-32) : icône 32 px bleue, titre 24/700, texte 16/26.
 *
 * Props : { type: "realisations", title, intro?, linkLabel?, linkHref?,
 *           items: [{ icon?, title, text? }] }
 * - `icon` : clé de la BANQUE de pictogrammes (shared/icons.ts — toute la banque est offerte dans l'éditeur depuis le 2026-09-18) ;
 *   "" = pas d'icône (maquette : trousse/casque/groupe/marteau = secteurs
 *   santé/services/RH/juridique) ;
 * - linkLabel/linkHref : lien de section (rendu si libellé ET lien).
 *
 * Contraintes / pièges :
 * - <h2> de section, <h3> par carte : le <h1> unique appartient au héros.
 * - `items = []` en secours (édition en direct CloudCannon).
 * - Liseré du lien : `border-0 border-b-2 border-solid` OBLIGATOIRE (piège
 *   border-solid/UA-medium sans preflight, consigné au lot chrome).
 * - Bordure = jeton `contour` depuis l'uniformisation 2026-09-18 ; le reste = tokens.
 * - Browser-safe : aucun import, aucun script.
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé.
 */
interface RealisationItem {
  title: string;
  text?: string;
  icon?: IconKey | '';
}

interface Props {
  title: string;
  intro?: string;
  fond?: FondKey;
  linkLabel?: string;
  linkHref?: string;
  items: RealisationItem[];
}

const { title, intro, fond = 'ivoire', linkLabel, linkHref, items = [] } = Astro.props;

// « Fond de section » ÉTENDU 2026-08-17 (produit-child.css §Réalisations,
// lavis chauds) : clé fermée → utilitaire de la palette officielle. Défaut =
// rendu historique (blanc, ex-bg-surface).
const FONDS: Record<string, string> = FOND_CLASSES;

---

<section class:list={['py-20', FONDS[fond] ?? FONDS.blanc]}>
  <div class="container-site flex flex-col gap-16">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div class="max-w-[576px] flex flex-col gap-2">
        <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0">
          {title}
        </h2>
        {hasRichText(intro) && <div class="rich text-base leading-[26px] text-on-surface-variant max-w-none" set:html={blockHtml(intro)} />}
      </div>
      {
        linkLabel && linkHref && (
          <a
            class="no-underline inline-flex items-center gap-2 pb-1 border-0 border-b-2 border-solid border-primary text-primary text-sm font-semibold tracking-[0.28px] leading-none hover:text-primary-container hover:border-primary-container transition-colors"
            href={linkHref}
          >
            {linkLabel}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M5 12h14m0 0-6-6m6 6-6 6" />
            </svg>
          </a>
        )
      }
    </div>
    <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 m-0 p-0 list-none">
      {
        items.map((item) => {
          const icon = iconFor(item.icon);
          return (
            <li class="m-0 bg-white border border-solid border-contour rounded-lg p-8 flex flex-col items-start gap-2">
              {icon && (
                <svg
                  class="text-primary"
                  width="32"
                  height="32"
                  {...iconSvgAttrs(icon, 1.8)}
                  aria-hidden="true"
                  focusable="false"
                >
                  {icon.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              )}
              <h3 class="text-2xl leading-8 font-bold text-on-surface m-0 pt-2">{item.title}</h3>
              {item.text && <p class="text-base leading-[26px] text-on-surface-variant m-0 max-w-none" set:html={inlineHtml(item.text)} />}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
