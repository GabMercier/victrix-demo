---
/**
 * Section « Derniers articles » — composant Bookshop (accueil composable).
 *
 * Props : { type: "home-latest", title, ctaLabel, ctaHref, cards? }
 *
 * SECTION DYNAMIQUE — repli documenté. Les cartes proviennent de la collection
 * blog, LUE AU BUILD (src/pages/[lang]/index.astro : getPostsByLocale + getImage
 * pré-résolvent les 3 derniers articles en données SIMPLES — src/srcset/dims en
 * chaînes, aucune image astro:assets), injectées via la prop `cards`
 * (mécanisme `enrich` du renderer partagé). Ce composant n'importe donc NI
 * astro:content NI astro:assets : il reste compilable pour le navigateur par
 * l'éditeur visuel CloudCannon (même contrainte que JsonLd.astro / faq.astro).
 *
 *  - Au build (`cards` fourni) : vraies cartes.
 *  - En édition live (navigateur, `cards` absent) : cartes FACTICES de
 *    remplacement — le titre et le lien restent éditables ; les cartes réelles
 *    réapparaissent au prochain build. C'est le repli « vraies données au build,
 *    factices dans l'éditeur » (équivalent à un drapeau ENV_BOOKSHOP_LIVE, mais
 *    piloté par la présence des données injectées — aucun import à éliminer).
 *
 * Le titre porte un <h2> (le <h1> appartient au héros) ; les cartes portent
 * des <h3>. Voir home-hero.astro pour les conventions communes.
 *
 * RE-SKIN 2026-08-04 (lot chrome) : 100 % utilitaires Tailwind (règle
 * no-hybride), rangée de tête = idiome home-expertises, rythme unifié
 * py-section-gap (était 96px), conteneur container-site.
 */
interface CardImage {
  src: string;
  // Absents pour les couvertures migrées (chemins publics servis tels quels,
  // sans dérivés astro:assets) — les attributs correspondants sont omis.
  srcset?: string;
  width?: number;
  height?: number;
}
interface Card {
  href: string;
  title: string;
  excerpt: string;
  tags: string[];
  dateISO: string;
  dateLabel: string;
  img: CardImage;
}
interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  cards?: Card[];
}

const { title, ctaLabel, ctaHref, cards } = Astro.props;

// Repli éditeur : 3 cartes factices quand aucune donnée n'est injectée (rendu
// dans le navigateur par l'éditeur visuel). Jamais utilisées au build.
const PLACEHOLDER_CARDS = 3;
const isLive = !Array.isArray(cards);

const cardClass =
  'group relative flex flex-col h-full bg-surface-container-lowest border border-solid border-outline-variant rounded-lg overflow-hidden transition-[box-shadow,transform] duration-150 hover:shadow-survol hover:-translate-y-0.5 motion-reduce:transition-none';
const tagClass =
  'text-xs font-medium text-on-primary-fixed bg-surface-container border border-solid border-outline-variant rounded-full px-3 py-1';
const titleClass = 'font-headline-md text-[20px] leading-snug m-0';
const titleLinkClass =
  "text-on-primary-fixed no-underline group-hover:text-primary after:content-[''] after:absolute after:inset-0";
const mutedClass = 'm-0 text-sm text-on-surface-variant max-w-none';
---

<section class="py-section-gap bg-surface">
  <div class="container-site">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
      <h2 class="font-headline-lg text-headline-lg text-on-surface m-0">{title}</h2>
      <a
        class="font-button text-button text-primary no-underline whitespace-nowrap hover:text-primary-container"
        href={ctaHref}
      >{ctaLabel}&nbsp;→</a>
    </div>
    <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 m-0 p-0">
      {
        isLive
          ? Array.from({ length: PLACEHOLDER_CARDS }).map(() => (
              <li>
                <article class={cardClass}>
                  <div class="block aspect-[16/10] bg-surface-container" aria-hidden="true" />
                  <div class="flex flex-col gap-3 p-6">
                    <ul role="list" class="flex flex-wrap gap-2 m-0">
                      <li class={tagClass}>Étiquette</li>
                    </ul>
                    <h3 class={titleClass}>
                      <a class={titleLinkClass} href="#">
                        Titre de l'article
                      </a>
                    </h3>
                    <p class={mutedClass}>Date</p>
                    <p class={mutedClass}>
                      Les derniers articles du blogue s'affichent ici au build.
                    </p>
                  </div>
                </article>
              </li>
            ))
          : cards.map((card) => (
              <li>
                <article class={cardClass}>
                  <a
                    class="block aspect-[16/10] overflow-hidden bg-surface-container"
                    href={card.href}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    {card.img.src && (
                      <img
                        src={card.img.src}
                        srcset={card.img.srcset}
                        alt=""
                        sizes={card.img.srcset ? '(min-width: 768px) 360px, 100vw' : undefined}
                        loading="lazy"
                        decoding="async"
                        fetchpriority="auto"
                        width={card.img.width}
                        height={card.img.height}
                        class="w-full h-full object-cover"
                      />
                    )}
                  </a>
                  <div class="flex flex-col gap-3 p-6">
                    {card.tags.length > 0 && (
                      <ul role="list" class="flex flex-wrap gap-2 m-0">
                        {card.tags.map((tag) => (
                          <li class={tagClass}>{tag}</li>
                        ))}
                      </ul>
                    )}
                    <h3 class={titleClass}>
                      <a class={titleLinkClass} href={card.href}>
                        {card.title}
                      </a>
                    </h3>
                    <p class={mutedClass}>
                      <time datetime={card.dateISO}>{card.dateLabel}</time>
                    </p>
                    <p class={mutedClass}>{card.excerpt}</p>
                  </div>
                </article>
              </li>
            ))
      }
    </ul>
  </div>
</section>
