---
/**
 * Section « Derniers articles » — composant Bookshop (accueil composable).
 *
 * Props : { type: "home-latest", title, ctaLabel, ctaHref, cards? }
 *
 * SECTION DYNAMIQUE — repli documenté. Les cartes proviennent de la collection
 * blog, LUE AU BUILD (src/pages/[lang]/index.astro : getPostsByLocale + getImage
 * pré-résolvent les 3 derniers articles en données SIMPLES — src/srcset/dims en
 * chaînes, aucune image astro:assets), injectées via la prop `cards`
 * (mécanisme `enrich` du renderer partagé). Ce composant n'importe donc NI
 * astro:content NI astro:assets : il reste compilable pour le navigateur par
 * l'éditeur visuel CloudCannon (même contrainte que JsonLd.astro / faq.astro).
 *
 *  - Au build (`cards` fourni) : vraies cartes, PARITÉ avec l'ancienne page
 *    (mêmes classes .card, mêmes <img> résolus).
 *  - En édition live (navigateur, `cards` absent) : cartes FACTICES de
 *    remplacement — le titre et le lien restent éditables ; les cartes réelles
 *    réapparaissent au prochain build. C'est le repli « vraies données au build,
 *    factices dans l'éditeur » (équivalent à un drapeau ENV_BOOKSHOP_LIVE, mais
 *    piloté par la présence des données injectées — aucun import à éliminer).
 *
 * PARITÉ : le titre porte un <h2> (le <h1> appartient au héros) ; les cartes
 * portent des <h3> (`headingLevel="h3"` de l'ancien BlogCard). Voir home-hero.astro
 * pour les conventions communes.
 */
interface CardImage {
  src: string;
  // Absents pour les couvertures migrées (chemins publics servis tels quels,
  // sans dérivés astro:assets) — les attributs correspondants sont omis.
  srcset?: string;
  width?: number;
  height?: number;
}
interface Card {
  href: string;
  title: string;
  excerpt: string;
  tags: string[];
  dateISO: string;
  dateLabel: string;
  img: CardImage;
}
interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  cards?: Card[];
}

const { title, ctaLabel, ctaHref, cards } = Astro.props;

// Repli éditeur : 3 cartes factices quand aucune donnée n'est injectée (rendu
// dans le navigateur par l'éditeur visuel). Jamais utilisées au build.
const PLACEHOLDER_CARDS = 3;
const isLive = !Array.isArray(cards);
---

<section class="latest">
  <div class="container">
    <div class="latest__head">
      <h2 class="section-title section-title--left">{title}</h2>
      <a class="latest__link" href={ctaHref}>{ctaLabel}&nbsp;→</a>
    </div>
    <ul role="list" class="latest__grid">
      {
        isLive
          ? Array.from({ length: PLACEHOLDER_CARDS }).map(() => (
              <li>
                <article class="card">
                  <div class="card__media card__media--placeholder" aria-hidden="true" />
                  <div class="card__body">
                    <ul role="list" class="card__tags">
                      <li class="tag">Étiquette</li>
                    </ul>
                    <h3 class="card__title">
                      <a href="#">Titre de l'article</a>
                    </h3>
                    <p class="card__date">Date</p>
                    <p class="card__excerpt">
                      Les derniers articles du blogue s'affichent ici au build.
                    </p>
                  </div>
                </article>
              </li>
            ))
          : cards.map((card) => (
              <li>
                <article class="card">
                  <a class="card__media" href={card.href} tabindex="-1" aria-hidden="true">
                    {card.img.src && (
                      <img
                        src={card.img.src}
                        srcset={card.img.srcset}
                        alt=""
                        sizes={card.img.srcset ? '(min-width: 768px) 360px, 100vw' : undefined}
                        loading="lazy"
                        decoding="async"
                        fetchpriority="auto"
                        width={card.img.width}
                        height={card.img.height}
                        class="card__img"
                      />
                    )}
                  </a>
                  <div class="card__body">
                    {card.tags.length > 0 && (
                      <ul role="list" class="card__tags">
                        {card.tags.map((tag) => (
                          <li class="tag">{tag}</li>
                        ))}
                      </ul>
                    )}
                    <h3 class="card__title">
                      <a href={card.href}>{card.title}</a>
                    </h3>
                    <p class="card__date">
                      <time datetime={card.dateISO}>{card.dateLabel}</time>
                    </p>
                    <p class="card__excerpt">{card.excerpt}</p>
                  </div>
                </article>
              </li>
            ))
      }
    </ul>
  </div>
</section>

<style>
  /* Duplicatas scopés (autonomie éditeur). */
  .container {
    width: 100%;
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--container-pad, 1.5rem);
  }
  h2 {
    font-size: var(--fs-700, clamp(2rem, 2vw + 1.4rem, 3rem));
    font-weight: var(--fw-bold, 700);
    line-height: var(--lh-tight, 1.15);
    color: var(--color-navy, #083957);
    text-wrap: balance;
  }

  /* ---------- Derniers articles (déplacé depuis l'ancienne page) ---------- */
  .latest {
    padding-block: var(--space-9, 6rem);
    font-family: var(--font-sans, 'Montserrat', system-ui, sans-serif);
  }
  .section-title {
    text-align: center;
    margin-bottom: var(--space-7, 3rem);
  }
  .section-title--left {
    text-align: left;
    margin-bottom: 0;
  }
  .latest__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3, 0.75rem);
    margin-bottom: var(--space-6, 2rem);
  }
  .latest__link {
    color: var(--color-link, #083957);
    font-weight: var(--fw-semibold, 600);
    text-decoration: none;
    white-space: nowrap;
  }
  .latest__link:hover {
    color: var(--color-accent-blue, #3366ff);
    text-decoration: underline;
  }
  .latest__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 2rem);
    margin: 0;
  }
  @media (min-width: 640px) {
    .latest__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .latest__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---------- Carte d'article (repris de BlogCard pour l'autonomie) -------- */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e2e4e8);
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-md, 0 4px 16px rgba(20, 33, 61, 0.1));
    transform: translateY(-2px);
  }
  .card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface, #f6f7f8);
  }
  .card__media--placeholder {
    background-color: var(--color-grey-100, #f0f1f3);
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-5, 1.5rem);
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin: 0;
  }
  .tag {
    font-size: var(--fs-100, 0.8125rem);
    font-weight: var(--fw-semibold, 600);
    color: var(--color-navy, #083957);
    background-color: var(--color-surface, #f6f7f8);
    border: 1px solid var(--color-border, #e2e4e8);
    border-radius: var(--radius-pill, 999px);
    padding: 0.2em 0.7em;
  }
  .card__title {
    font-size: var(--fs-500, clamp(1.375rem, 0.6vw + 1.2rem, 1.75rem));
    line-height: var(--lh-snug, 1.3);
  }
  .card__title a {
    color: var(--color-navy, #083957);
    text-decoration: none;
  }
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover .card__title a {
    color: var(--color-accent-blue, #3366ff);
  }
  .card__date {
    margin: 0;
    font-size: var(--fs-200, 0.9375rem);
    color: var(--color-text-muted, #4a4d54);
  }
  .card__excerpt {
    margin: 0;
    color: var(--color-text-muted, #4a4d54);
  }
</style>
