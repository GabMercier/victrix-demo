{
  "name": "demo-victrix",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Static marketing-site prototype (Astro) reproducing the Victrix homepage + blog, content managed via Sveltia CMS, deployed to Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "design:previews": "node scripts/design/generate-section-previews.mjs",
    "cms:previews": "node scripts/design/generate-cms-previews.mjs",
    "cms:previews:check": "node scripts/design/generate-cms-previews.mjs --check",
    "check:bookshop": "node scripts/check-bookshop-strip.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:prefill": "node scripts/check-contact-prefill.mjs",
    "check:sections": "node scripts/backfill-section-keys.mjs --check",
    "fix:sections": "node scripts/backfill-section-keys.mjs",
    "fix:links": "node scripts/fix-internal-links.mjs",
    "build:redirects": "node scripts/build-redirects.mjs",
    "check:redirects": "node scripts/build-redirects.mjs --check",
    "build:brand": "node scripts/build-brand-images.mjs",
    "check:brand": "node scripts/build-brand-images.mjs --check",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:images": "node scripts/optimize-images.mjs --check",
    "check:old-urls": "node scripts/check-old-urls.mjs",
    "check:parite-texte": "python scripts/migration/check-parite-texte.py"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@bookshop/astro-bookshop": "3.19.0-rc1",
    "astro": "^5.18.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@bookshop/astro-engine": "3.19.0-rc1",
    "@bookshop/browser": "3.19.0-rc1",
    "@bookshop/generate": "3.19.0-rc1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.6"
  }
}
