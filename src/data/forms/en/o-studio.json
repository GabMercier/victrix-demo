{
  "_schema": "default",
  "name": "Ø Studio consultation (EN)",
  "toEmail": "",
  "subject": "Consultation request — Ø Studio",
  "submitLabel": "Request a consultation",
  "consentText": "The information provided is collected and used solely to process your request, in accordance with Law 25 on the protection of personal information in the private sector.",
  "fields": [
    {
      "label": "Full name",
      "type": "text",
      "required": true,
      "options": [],
      "value": "",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "Work email",
      "type": "email",
      "required": true,
      "options": [],
      "value": "",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "Organization",
      "type": "text",
      "required": false,
      "options": [],
      "value": "",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "Your need",
      "type": "select",
      "required": true,
      "options": [
        "Application development",
        "Process automation",
        "Power Platform governance",
        "Dynamics 365",
        "Other"
      ],
      "value": "",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "Tell us more",
      "type": "text",
      "required": true,
      "options": [],
      "value": "",
      "showIf": { "field": "Your need", "equals": "Other" }
    },
    {
      "label": "Message",
      "type": "textarea",
      "required": false,
      "options": [],
      "value": "",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "I consent to Victrix collecting and using my information to process my request (Law 25)",
      "type": "checkbox",
      "required": true,
      "options": [],
      "value": "",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "Source page",
      "type": "hidden",
      "required": false,
      "options": [],
      "value": "{{page.titre}} ({{page.chemin}})",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "UTM — source",
      "type": "hidden",
      "required": false,
      "options": [],
      "value": "{{url.utm_source}}",
      "showIf": { "field": "", "equals": "" }
    },
    {
      "label": "UTM — campaign",
      "type": "hidden",
      "required": false,
      "options": [],
      "value": "{{url.utm_campaign}}",
      "showIf": { "field": "", "equals": "" }
    }
  ]
}
