---
import { type Locale, defaultLocale, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

/**
 * Global site footer: link columns, contact block (chip CTA, email/phone,
 * social text links), separator, and a bottom bar (logo, legal links, ©,
 * back-to-top). Locale-aware: labels from the UI dictionary, internal hrefs
 * localized. Email/phone are locale-neutral and stay literal.
 *
 * RE-SKIN 2026-08-04 (lot chrome) : footer CLAIR (Figma « Composants » —
 * l'ancien fond Bleu nuit disparaît), 100 % utilitaires Tailwind (règle
 * no-hybride), valeurs = tokens planche (arbitrage v2). `.site-footer` et
 * `.footer-col` sont des HOOKS NUS pour e2e (header-variants.spec.ts) —
 * `.footer-col` ne doit PAS apparaître dans CampaignFooter.
 */

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const f = t.footer;
const year = 2026;

const colTitleClass = 'font-headline-md text-headline-md text-on-surface m-0 mb-4';
const colLinkClass = 'text-body-md text-on-surface-variant no-underline hover:text-primary';
const smallMutedClass = 'text-xs font-semibold text-on-surface-variant';
---

<!-- Footer BLANC comme le header (proposition user 2026-08-11, acceptée) :
     liseré froid en tête pour rester lisible sur les sections blanches. -->
<footer
  class="site-footer bg-white rounded-t-xl border-0 border-t border-solid border-[#C5C6D0]/30"
>
  <div class="container-site pt-14 pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10">
      {
        f.columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <h2 class={colTitleClass}>{col.title}</h2>
            <ul role="list" class="flex flex-col gap-1">
              {col.links.map((link) => (
                <li>
                  <a class={colLinkClass} href={localizePath(link.href, lang)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col">
        <h2 class={colTitleClass}>{f.contactTitle}</h2>

        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-fixed text-primary text-sm font-medium no-underline hover:bg-primary hover:text-on-primary transition-colors"
          href={localizePath(f.contactCta.href, lang)}
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M14 4h5v16h-5" />
            <path d="M3 12h12m0 0-4-4m4 4-4 4" />
          </svg>
          {f.contactCta.label}
        </a>

        <ul role="list" class="flex flex-col gap-1 mt-4">
          <li>
            <a class="text-body-md text-on-surface underline hover:text-primary" href="mailto:contact@victrix.ca">contact@victrix.ca</a>
          </li>
          <li>
            <a class="text-body-md text-on-surface no-underline hover:text-primary" href="tel:+15148791919">+1&nbsp;514&nbsp;879-1919</a>
          </li>
        </ul>

        <div class="mt-4">
          <span class:list={['block mb-1', smallMutedClass]}>{f.socialLabel}</span>
          <ul role="list" class="flex items-center gap-4">
            {
              f.social.map((s, i) => (
                <>
                  {i > 0 && (
                    <li aria-hidden="true" class="text-on-surface-variant/40">
                      |
                    </li>
                  )}
                  <li>
                    <a class="text-body-md text-primary no-underline hover:text-primary-container" href={s.href}>
                      {s.label}
                    </a>
                  </li>
                </>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="border-0 border-t border-solid border-outline-variant mt-10 pt-6 flex flex-wrap items-center justify-between gap-4"
    >
      <a
        class="font-headline-md text-headline-md font-bold text-on-surface no-underline"
        href={localizePath('/', lang)}
        aria-label={t.nav.brandAria}
      >Victrix</a>
      <nav aria-label={f.contactTitle}>
        <ul role="list" class="flex flex-wrap items-center gap-6">
          {
            f.legal.map((item) => (
              <li>
                <a
                  class:list={['no-underline hover:text-primary', smallMutedClass]}
                  href={localizePath(item.href, lang)}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class:list={['m-0', smallMutedClass]}>© Victrix {year}</p>
    </div>
    <div class="flex justify-end mt-6">
      <a
        href="#"
        aria-label={f.backToTop}
        class="size-12 rounded-full border border-solid border-outline-variant bg-white shadow-[0_1px_2px_rgba(0,0,0,0.05)] flex items-center justify-center text-on-surface no-underline hover:text-primary"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" />
        </svg>
      </a>
    </div>
  </div>
</footer>
