---
import { type Locale, defaultLocale, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getSiteText } from '../i18n/site';

/**
 * Global site footer: link columns, contact block (chip CTA, email/phone,
 * social text links), separator, and a bottom bar (logo, legal links, ©,
 * back-to-top). Locale-aware: internal hrefs localized.
 *
 * TEXTES ÉDITABLES AU CMS (2026-08-11) : colonnes, coordonnées, réseaux
 * sociaux et mentions légales viennent de la collection `site`
 * (« Textes du site ») — le pied de page est transversal, il ne dépend
 * d'aucune page. Seules les chaînes d'ACCESSIBILITÉ (brandAria, backToTop)
 * restent dans ui.ts.
 *
 * RE-SKIN 2026-08-04 (lot chrome), RE-ANCRÉ 2026-08-14 sur export2
 * (docs/design/export2/Code/footer — décision v3) : fond gris clair
 * neutral-50, titres 18/700, liens 14, chip portail bleu-200/bleu-600,
 * filet appuyé neutral-500. 100 % utilitaires Tailwind (règle no-hybride).
 * `.site-footer` et `.footer-col` sont des HOOKS NUS pour e2e
 * (header-variants.spec.ts) — `.footer-col` ne doit PAS apparaître dans
 * CampaignFooter.
 */

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const f = (await getSiteText(lang)).footer;
// Année du © calculée au build (elle était figée à 2026 en dur).
const year = new Date().getFullYear();

const colTitleClass = 'text-lg font-bold text-on-surface m-0 mb-4';
const colLinkClass = 'text-sm leading-normal text-neutral-700 no-underline hover:text-primary';
const smallMutedClass = 'text-sm font-semibold text-neutral-700';
---

<!-- Fond gris clair neutral-50 (export2 Code/footer — remplace le footer
     blanc du 2026-08-11). -->
<footer
  class="site-footer bg-surface-container-low border-0 border-t border-solid border-neutral-300/30"
>
  <div class="container-site pt-14 pb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10">
      {
        f.columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <h2 class={colTitleClass}>{col.title}</h2>
            <ul role="list" class="flex flex-col gap-1">
              {col.links.map((link) => (
                <li>
                  <a class={colLinkClass} href={localizePath(link.href, lang)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col">
        <h2 class={colTitleClass}>{f.contactTitle}</h2>

        <a
          class="inline-flex items-center gap-2 px-6 py-2 rounded bg-primary-fixed text-on-primary-fixed-variant text-sm font-semibold no-underline shadow-controle hover:bg-primary hover:text-on-primary transition-colors"
          href={localizePath(f.contactCta.href, lang)}
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M14 4h5v16h-5" />
            <path d="M3 12h12m0 0-4-4m4 4-4 4" />
          </svg>
          {f.contactCta.label}
        </a>

        <ul role="list" class="flex flex-col gap-1.5 mt-4">
          <li>
            <a class="text-sm text-neutral-800 underline hover:text-primary" href={`mailto:${f.email}`}>{f.email}</a>
          </li>
          <li>
            <a class="text-sm text-neutral-800 no-underline hover:text-primary whitespace-nowrap" href={`tel:${f.phoneHref}`}>{f.phone}</a>
          </li>
        </ul>

        <div class="mt-4">
          <span class="block mb-1 text-sm font-semibold text-neutral-700">{f.socialLabel}</span>
          <ul role="list" class="flex items-center gap-4">
            {
              f.social.map((s, i) => (
                <>
                  {i > 0 && (
                    <li aria-hidden="true" class="text-neutral-300">
                      |
                    </li>
                  )}
                  <li>
                    <a class="text-sm font-semibold text-primary no-underline hover:text-primary-container" href={s.href}>
                      {s.label}
                    </a>
                  </li>
                </>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="border-0 border-t border-solid border-outline mt-10 pt-6 flex flex-wrap items-center justify-between gap-4"
    >
      <a
        class="text-headline-md font-bold text-on-surface no-underline"
        href={localizePath('/', lang)}
        aria-label={t.nav.brandAria}
      >Victrix</a>
      <nav aria-label={f.contactTitle}>
        <ul role="list" class="flex flex-wrap items-center gap-6">
          {
            f.legal.map((item) => (
              <li>
                <a
                  class:list={['no-underline hover:text-primary', smallMutedClass]}
                  href={localizePath(item.href, lang)}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class:list={['m-0', smallMutedClass]}>© Victrix {year}</p>
    </div>
    <div class="flex justify-end mt-6">
      <a
        href="#"
        aria-label={t.footer.backToTop}
        class="size-12 rounded-full border border-solid border-neutral-400 bg-transparent shadow-[0_1px_2px_rgba(0,0,0,0.05)] flex items-center justify-center text-on-surface no-underline transition-colors hover:bg-black/5 hover:text-primary"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" />
        </svg>
      </a>
    </div>
  </div>
</footer>
