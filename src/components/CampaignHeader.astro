---
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';
import { type Locale, defaultLocale, otherLocale, localizePath, swapLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { resolveHeaderConfig, type LandingHeaderConfig } from '../lib/chrome/header-config';
import { isWithinWindow } from '../lib/schedule';

/**
 * En-tête de campagne (P-04) — rendu UNIQUEMENT quand une campagne porte un
 * bloc `header` en mode « allégé » ou « personnalisé » (BaseLayout choisit :
 * mode complet/absent → Header.astro, INTOUCHÉ — parité octet garantie).
 *
 *  - allégé : logo + UN bouton (CTA sur mesure, sinon le bouton portail) ;
 *  - personnalisé : logo + liens bornés (sans méga-menus, sans tiroir mobile —
 *    ils s'enroulent en mobile) + CTA + interrupteurs annonce / FR-EN /
 *    recherche (politique : src/lib/chrome/header-config.ts).
 *
 * La bannière d'annonce réutilise les classes et attributs du header complet
 * (data-announcement / data-announce-close) : l'état « fermée » est posé
 * pré-peinture par le script bloquant de BaseLayout ; le clic de fermeture est
 * géré ici (le script de Header.astro n'est pas chargé sur ces pages).
 *
 * RE-SKIN 2026-08-04 (lot chrome) : mêmes recettes utilitaires que
 * Header.astro (classes copiées verbatim — composant autonome, pas
 * d'abstraction partagée). `.campaign-header`, `.campaign-header__brand`,
 * `.campaign-header__search`, `.lang-switch`, `.announcement` = hooks nus
 * (e2e + global.css).
 */

interface Props {
  lang?: Locale;
  altLocalePath?: string;
  config?: LandingHeaderConfig;
}

const { lang = defaultLocale, altLocalePath, config } = Astro.props;
const t = useTranslations(lang);
const chrome = resolveHeaderConfig(config);

const navEntry = await getEntry('navigation', lang);
if (!navEntry) {
  throw new Error(`[navigation] Fichier manquant : src/data/navigation/${lang}.json`);
}
const nav = navEntry.data;

// CTA : sur mesure si renseigné, sinon le bouton portail du site (même règle
// de visibilité que le header complet). Aucun bouton si le portail est masqué.
const cta =
  chrome.cta ??
  (nav.portal.visible ? { label: nav.portal.label, href: localizePath('/portail', lang) } : null);

// Bannière d'annonce (personnalisé + interrupteur) — mêmes règles de fenêtre
// planifiée que Header.astro (build d'édition STATIC_ONLY : toujours visible).
const announce = nav.announce;
const announceLink = localizePath(announce.linkHref, lang);
const STATIC_ONLY_BUILD = Boolean(import.meta.env.STATIC_ONLY);
const announceVisible =
  chrome.showAnnounce &&
  announce.enabled &&
  (STATIC_ONLY_BUILD || isWithinWindow(new Date(), announce.startAt, announce.endAt));

const searchHref = localizePath('/recherche', lang);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};

const alt = altLocalePath ?? swapLocale(Astro.url.pathname, otherLocale[lang]);
const frHref = lang === 'fr' ? Astro.url.pathname : alt;
const enHref = lang === 'en' ? Astro.url.pathname : alt;

// Recettes utilitaires — copies verbatim de Header.astro (lot chrome).
const ctaClass =
  'inline-flex items-center justify-center px-6 py-2 rounded-lg bg-primary text-on-primary text-sm font-bold no-underline hover:bg-primary-container transition-colors';
const navLinkClass =
  'text-sm font-medium tracking-[0.14px] text-on-primary-fixed/70 no-underline whitespace-nowrap py-2 hover:text-primary aria-[current=page]:text-primary aria-[current=page]:font-semibold aria-[current=page]:shadow-[inset_0_-2px_0_0_var(--color-primary)]';
const langLinkClass = 'no-underline p-1 text-sm';
---

{
  announceVisible && (
    <div class="announcement bg-primary text-on-primary text-sm" data-announcement>
      <div class="container-site flex items-center justify-center gap-4 py-2">
        <p class="m-0 max-w-none text-center">
          {announce.before}<strong class="font-semibold">{announce.strong}</strong>{announce.after}
          <a class="text-on-primary font-semibold underline whitespace-nowrap" href={announceLink}>
            {announce.linkLabel}
          </a>
        </p>
        <button
          type="button"
          class="shrink-0 inline-flex p-1 bg-transparent border-0 text-on-primary cursor-pointer rounded"
          data-announce-close
          aria-label={t.announce.close}
        >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M2 2l12 12M14 2L2 14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </div>
  )
}

<!-- Barre BLANCHE (décision designer 2026-08-11) — même recette que Header.astro. -->
<header class="campaign-header sticky top-0 z-50 bg-white shadow-[0_1px_2px_rgba(0,0,0,0.05)]">
  <div class="container-site flex flex-wrap items-center justify-between gap-x-6 gap-y-3 min-h-20 py-2">
    <a
      class="campaign-header__brand inline-flex items-center shrink-0 [--logo-height:40px]"
      href={localizePath('/', lang)}
      aria-label={t.nav.brandAria}
    >
      <Logo variant="dark" />
    </a>

    {
      chrome.links.length > 0 && (
        <nav aria-label="Navigation">
          <ul role="list" class="flex flex-wrap items-center gap-y-3 gap-x-[clamp(1rem,2vw,2.5rem)]">
            {chrome.links.map((link) => (
              <li>
                <a
                  class={navLinkClass}
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="flex items-center gap-4 lg:gap-6">
      {
        chrome.showSearch && (
          <a
            class="campaign-header__search inline-flex items-center justify-center size-[34px] rounded text-on-primary-fixed/70 hover:text-primary aria-[current=page]:text-primary"
            href={searchHref}
            aria-label={t.search.navAria}
            aria-current={isCurrent(searchHref) ? 'page' : undefined}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="M15.5 15.5L21 21" />
            </svg>
          </a>
        )
      }

      {
        cta && (
          <a class:list={['campaign-header__cta', ctaClass]} href={cta.href}>
            {cta.label}
          </a>
        )
      }

      {
        chrome.showLangSwitch && (
          <div
            class="lang-switch flex items-center gap-2 text-sm"
            role="group"
            aria-label={t.nav.langGroupAria}
          >
            <a
              class:list={[
                'lang-switch__link',
                langLinkClass,
                lang === 'fr'
                  ? 'is-active font-bold text-on-primary-fixed'
                  : 'font-medium text-on-primary-fixed/70 hover:text-primary',
              ]}
              href={frHref}
              aria-current={lang === 'fr' ? 'true' : undefined}
              lang="fr"
            >
              FR
            </a>
            <span class="text-on-primary-fixed/40" aria-hidden="true">
              |
            </span>
            <a
              class:list={[
                'lang-switch__link',
                langLinkClass,
                lang === 'en'
                  ? 'is-active font-bold text-on-primary-fixed'
                  : 'font-medium text-on-primary-fixed/70 hover:text-primary',
              ]}
              href={enHref}
              aria-current={lang === 'en' ? 'true' : undefined}
              lang="en"
            >
              EN
            </a>
          </div>
        )
      }
    </div>
  </div>
</header>

<script>
  // Fermeture de la bannière — même mécanique que Header.astro : classe sur
  // <html> (déjà appliquée pré-peinture par le script bloquant de BaseLayout
  // au rechargement) + mémorisation de session. Sans bannière rendue, le
  // sélecteur ne trouve rien et le script est inerte.
  document
    .querySelector<HTMLButtonElement>('[data-announce-close]')
    ?.addEventListener('click', () => {
      document.documentElement.classList.add('announce-dismissed');
      try {
        sessionStorage.setItem('victrix-announce', 'closed');
      } catch {
        /* sessionStorage indisponible — la bannière se masque quand même */
      }
    });
</script>
