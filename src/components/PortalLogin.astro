---
/**
 * Carte de connexion du portail client (pages FR et EN).
 *
 * 2026-09-10 (recette user) : carte ÉPURÉE — le formulaire seul, sans panneau
 * marketing, sans mention de démonstration ni de fournisseur d'identité.
 * Parité avec le site actuel : le bouton « Connexion » est ACTIF mais ne mène
 * nulle part (submit intercepté ; champs vides → validation native du
 * navigateur). « Mot de passe oublié » bascule vers un formulaire de
 * réinitialisation (courriel seul). RIEN n'est jamais soumis : champs sans
 * `name`, formulaires sans `action`. L'implémentation réelle (Entra ID) suit
 * docs/portail-auth.md ; l'ancien prototype OIDC vit dans l'historique git.
 */

interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;

const t = {
  fr: {
    title: 'Portail client',
    sub: 'Connectez-vous à votre espace client',
    emailLabel: 'Courriel',
    passwordLabel: 'Mot de passe',
    submit: 'Connexion',
    forgot: 'Mot de passe oublié',
    resetIntro: 'Entrez le courriel associé avec votre compte pour réinitialiser le mot de passe.',
    resetSubmit: 'Réinitialiser le mot de passe',
    back: 'Retour à la connexion',
  },
  en: {
    title: 'Client portal',
    sub: 'Sign in to your client area',
    emailLabel: 'Email',
    passwordLabel: 'Password',
    submit: 'Sign in',
    forgot: 'Forgot password',
    resetIntro: 'Enter the email associated with your account to reset your password.',
    resetSubmit: 'Reset password',
    back: 'Back to sign-in',
  },
}[lang];
---

<section class="pl">
  <div class="container pl__inner">
    <div class="pl__card">
      <h1 class="pl__title">{t.title}</h1>

      {/* Vue connexion */}
      <div data-view="login">
        <p class="pl__sub">{t.sub}</p>
        <form class="pl__fields">
          <div class="field">
            <label for="pl-email">{t.emailLabel}</label>
            <input id="pl-email" type="email" autocomplete="username" inputmode="email" required />
          </div>

          <div class="field">
            <label for="pl-password">{t.passwordLabel}</label>
            <input id="pl-password" type="password" autocomplete="current-password" required />
            <button type="button" class="pl__linkbtn pl__forgot" data-forgot>{t.forgot}</button>
          </div>

          <button type="submit" class="btn btn--primary pl__submit">{t.submit}</button>
        </form>
      </div>

      {/* Vue réinitialisation (courriel seul) */}
      <div data-view="reset" hidden>
        <p class="pl__sub">{t.resetIntro}</p>
        <form class="pl__fields">
          <div class="field">
            <label for="pl-reset-email">{t.emailLabel}</label>
            <input id="pl-reset-email" type="email" autocomplete="username" inputmode="email" required />
          </div>

          <button type="submit" class="btn btn--primary pl__submit">{t.resetSubmit}</button>
          <button type="button" class="pl__linkbtn" data-back>← {t.back}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Bascule connexion ⇄ réinitialisation, et submit sans destination (parité
  // site actuel) : la validation native joue d'abord (required), puis le
  // submit valide est intercepté — aucune requête, aucune navigation.
  const login = document.querySelector<HTMLElement>('[data-view="login"]');
  const reset = document.querySelector<HTMLElement>('[data-view="reset"]');

  document.querySelector('[data-forgot]')?.addEventListener('click', () => {
    if (!login || !reset) return;
    login.hidden = true;
    reset.hidden = false;
    reset.querySelector<HTMLInputElement>('input')?.focus();
  });

  document.querySelector('[data-back]')?.addEventListener('click', () => {
    if (!login || !reset) return;
    reset.hidden = true;
    login.hidden = false;
    login.querySelector<HTMLInputElement>('input')?.focus();
  });

  for (const form of document.querySelectorAll<HTMLFormElement>('.pl form')) {
    form.addEventListener('submit', (event) => event.preventDefault());
  }
</script>

<style>
  .pl {
    background: linear-gradient(180deg, var(--color-navy) 0 220px, var(--color-band) 220px);
    padding-block: var(--space-8) var(--space-9);
  }
  .pl__inner {
    display: flex;
    justify-content: center;
  }
  .pl__card {
    width: 100%;
    max-width: 480px;
    background-color: var(--color-bg);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-3);
    padding: var(--space-7) var(--space-6);
  }

  .pl__title {
    font-size: var(--fs-700);
    margin: 0;
  }
  .pl__sub {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .pl__fields {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field label {
    font-weight: var(--fw-semibold);
    font-size: var(--fs-200);
    color: var(--color-navy);
  }
  .field > input {
    width: 100%;
    padding: 0.7em 0.9em;
    border: 1px solid var(--color-grey-500);
    border-radius: var(--radius-m);
    background-color: var(--color-bg);
  }
  .field > input:focus-visible {
    border-color: var(--color-accent-blue);
  }

  .pl__submit {
    align-self: stretch;
    width: 100%;
    padding-block: 0.85em;
  }

  /* Bouton habillé en lien (bascule de vue — pas une navigation). */
  .pl__linkbtn {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    color: var(--color-accent-blue);
  }
  .pl__linkbtn:hover,
  .pl__linkbtn:focus-visible {
    text-decoration: underline;
  }
  .pl__forgot {
    margin-top: var(--space-1);
  }
</style>
