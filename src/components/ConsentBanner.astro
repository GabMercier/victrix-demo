---
import { type Locale, defaultLocale, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getSiteText } from '../i18n/site';

/**
 * Bandeau de consentement Loi 25 (P-10) — design minimal ASSUMÉ (décision
 * 17/07) : tokens seulement, re-stylé au redesign. Rendu sur toutes les pages
 * via BaseLayout ; masqué (hidden) tant que le script n'a pas constaté
 * l'absence de choix mémorisé (pas d'éclair pour les visiteurs déjà décidés).
 *
 * TEXTES ÉDITABLES AU CMS (2026-08-11) : la formulation vient de la collection
 * `site` (« Textes du site ») — bandeau transversal, à portée légale : elle
 * doit pouvoir être corrigée sans développeur. Le libellé de région (aria)
 * reste dans ui.ts.
 *
 * Contrat de consentement (consommé par P-11 — pose des scripts analytiques) :
 *  - localStorage `victrix-consent` = {"choice","date","revision"} — format,
 *    péremption (≈ 6 mois → redemandé) et révision : `src/lib/consent/record.ts` ;
 *  - classe `consent-analytics` sur <html> quand accepté ;
 *  - évènement `victrix:consent` (CustomEvent, detail.analytics: boolean) émis
 *    à chaque choix ;
 *  - GATING GÉNÉRIQUE : tout <script type="text/plain" data-consent="analytics">
 *    (src via data-src, ou contenu inline) reste INERTE tant que le visiteur
 *    n'a pas accepté ; il est activé (clone exécutable) dès l'acceptation — y
 *    compris au retour sur le site et après chaque navigation ClientRouter.
 *    Aucun script analytique ne se charge sans consentement.
 *
 * RETRAIT DU CONSENTEMENT (2026-09-18) : tout élément `[data-consent-manage]`
 * (lien « Gérer mes témoins » des pieds de page) ROUVRE le bandeau, même
 * après un choix. Passer d'« accepté » à « refusé » RECHARGE la page : un
 * script analytique déjà exécuté ne se décharge pas — seul un rechargement,
 * où il reste inerte, retire réellement la mesure.
 *
 * FINI LE 2026-09-21 (remplace Axeptio, sans bibliothèque — GA4 est le seul
 * traceur) : choix DATÉ qui périme, témoins `_ga*` EFFACÉS au refus, deux
 * boutons de MÊME poids visuel (refuser aussi simple qu'accepter), peau sombre
 * chaude de la charte (celle du CTA « nuit »).
 *
 * A11y : region nommée, boutons natifs (focus clavier), texte lisible ; le
 * bandeau n'est PAS un modal — il ne piège pas le focus et ne bloque pas la
 * navigation (exigence minimale Loi 25 : choix libre, refus aussi simple que
 * l'acceptation).
 */

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const c = (await getSiteText(lang)).consent;
const ariaLabel = useTranslations(lang).consent.ariaLabel;
const policyHref = localizePath(c.policyHref, lang);
---

<div class="consent" data-consent-banner hidden role="region" aria-label={ariaLabel}>
  <div class="container consent__inner">
    <p class="consent__text">
      {c.text}
      <a class="consent__policy" href={policyHref}>{c.policyLabel}</a>
    </p>
    <div class="consent__actions">
      <button type="button" class="consent__btn" data-consent-accept>
        {c.accept}
      </button>
      <button type="button" class="consent__btn" data-consent-refuse>
        {c.refuse}
      </button>
    </div>
  </div>
</div>

<script>
  // Comme Header.astro : avec <ClientRouter />, ce module s'exécute UNE fois
  // par session pendant que le DOM est remplacé à chaque navigation — les
  // liaisons d'éléments vivent donc dans astro:page-load.
  import {
    CONSENT_KEY,
    cookieDomains,
    isAnalyticsCookie,
    readConsent,
    serializeConsent,
    type ConsentChoice,
  } from '../lib/consent/record';

  /** Choix valide mémorisé — `null` = à (re)demander (absent, périmé, ancien format). */
  const stored = (): ConsentChoice | null => {
    try {
      return readConsent(localStorage.getItem(CONSENT_KEY))?.choice ?? null;
    } catch {
      return null;
    }
  };

  /** Refus : efface les témoins de mesure déjà posés (hôte + domaines parents). */
  const clearAnalyticsCookies = () => {
    const names = document.cookie
      .split(';')
      .map((pair) => pair.split('=')[0].trim())
      .filter(isAnalyticsCookie);
    for (const name of names) {
      for (const domain of cookieDomains(location.hostname)) {
        document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ''}`;
      }
    }
  };

  /** Active les scripts en attente de consentement présents dans le DOM. */
  const activateGatedScripts = () => {
    document
      .querySelectorAll<HTMLScriptElement>('script[type="text/plain"][data-consent="analytics"]')
      .forEach((inert) => {
        const live = document.createElement('script');
        for (const { name, value } of Array.from(inert.attributes)) {
          if (name === 'type' || name === 'data-consent' || name === 'data-src') continue;
          live.setAttribute(name, value);
        }
        const src = inert.dataset.src;
        if (src) live.src = src;
        else live.textContent = inert.textContent;
        inert.replaceWith(live);
      });
  };

  const applyChoice = (accepted: boolean, persist: boolean) => {
    if (persist) {
      try {
        localStorage.setItem(CONSENT_KEY, serializeConsent(accepted ? 'accepted' : 'refused'));
      } catch {
        /* localStorage indisponible — le choix vaut pour la page courante */
      }
    }
    document.documentElement.classList.toggle('consent-analytics', accepted);
    if (accepted) activateGatedScripts();
    else clearAnalyticsCookies();
    document.dispatchEvent(new CustomEvent('victrix:consent', { detail: { analytics: accepted } }));
  };

  document.addEventListener('astro:page-load', () => {
    const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
    if (!banner) return;

    // Boutons liés à CHAQUE chargement (le DOM est neuf après un swap) et sans
    // `once` : le bandeau peut être rouvert par « Gérer mes témoins ».
    const accept = banner.querySelector<HTMLButtonElement>('[data-consent-accept]');
    accept?.addEventListener('click', () => {
      banner.hidden = true;
      applyChoice(true, true);
    });
    banner.querySelector<HTMLButtonElement>('[data-consent-refuse]')?.addEventListener('click', () => {
      const wasAccepted = stored() === 'accepted';
      banner.hidden = true;
      applyChoice(false, true);
      // Retrait : les scripts déjà exécutés ne se déchargent pas — recharger.
      if (wasAccepted) location.reload();
    });
    document.querySelectorAll<HTMLElement>('[data-consent-manage]').forEach((opener) => {
      opener.addEventListener('click', () => {
        banner.hidden = false;
        accept?.focus();
      });
    });

    const choice = stored();
    if (choice === 'accepted') {
      // Choix déjà mémorisé : réappliquer (classe + activation des scripts de
      // CETTE page — après un swap ClientRouter, les scripts inertes copiés
      // dans le nouveau DOM doivent être réactivés).
      applyChoice(true, false);
      return;
    }
    if (choice === 'refused') return;

    banner.hidden = false;
  });
</script>

<style>
  /* Peau sombre chaude de la charte (2026-09-21) — tokens seulement. */
  .consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60; /* au-dessus du header sticky (50) */
    background-color: var(--color-on-surface);
    color: var(--color-white);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 -12px 32px -16px rgb(8 57 87 / 0.4);
  }
  .consent__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
  }
  .consent__text {
    margin: 0;
    font-size: var(--fs-200);
    max-width: 70ch;
  }
  .consent__policy {
    color: var(--color-white);
    font-weight: var(--fw-semibold);
    text-decoration: underline;
    white-space: nowrap;
    margin-inline-start: var(--space-2);
  }
  .consent__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  /* UN seul style pour les deux boutons : même poids visuel, refuser est
     aussi simple qu'accepter (Loi 25). */
  .consent__btn {
    cursor: pointer;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-pill);
    color: var(--color-white);
    font-family: inherit;
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    padding: var(--space-2) var(--space-5);
  }
  .consent__btn:hover {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-on-surface);
  }
  .consent__btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
</style>
