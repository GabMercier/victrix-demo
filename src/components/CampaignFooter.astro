---
import Logo from './Logo.astro';
import { type Locale, defaultLocale, localizePath } from '../i18n/config';
import { getSiteText } from '../i18n/site';

/**
 * Pied de page de campagne (P-04, mode « allégé ») — rendu UNIQUEMENT quand
 * une campagne porte `footer.mode: allege` (BaseLayout choisit ; défaut →
 * Footer.astro, INTOUCHÉ). Contenu : logo + barre légale (liens légaux + ©),
 * mêmes sources que le pied de page complet — collection `site`
 * (« Textes du site ») depuis 2026-08-11.
 *
 * RE-SKIN 2026-08-04 (lot chrome) : la barre basse du footer clair
 * (Footer.astro), classes copiées verbatim. `.campaign-footer` = hook nu e2e ;
 * `.footer-col` ne doit PAS apparaître ici (assertion e2e).
 */

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const siteText = await getSiteText(lang);
const f = siteText.footer;
// Lien « Gérer mes témoins » (2026-09-18, Loi 25) : rouvre le bandeau de
// consentement (écouteur dans ConsentBanner.astro) ; '' = masqué.
const manageLabel = siteText.consent.manage;
// Année du © calculée au build (elle était figée à 2026 en dur).
const year = new Date().getFullYear();

const smallMutedClass = 'text-sm font-semibold text-on-surface-variant';
---

<!-- Footer BLANC comme le header (2026-08-11) — même recette que Footer.astro. -->
<footer
  class="campaign-footer bg-white rounded-t-xl border-0 border-t border-solid border-[#C5C6D0]/30"
>
  <div class="container-site py-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
    <div class="[--logo-height:32px]">
      <Logo variant="dark" />
    </div>
    <nav aria-label={f.contactTitle}>
      <ul role="list" class="flex flex-wrap items-center gap-6">
        {
          f.legal.map((item) => (
            <li>
              <a
                class:list={['no-underline hover:text-primary', smallMutedClass]}
                href={localizePath(item.href, lang)}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          manageLabel && (
            <li>
              <button
                type="button"
                data-consent-manage
                class:list={['bg-transparent border-0 p-0 cursor-pointer hover:text-primary', smallMutedClass]}
              >
                {manageLabel}
              </button>
            </li>
          )
        }
      </ul>
    </nav>
    <p class:list={['m-0', smallMutedClass]}>©{year} Victrix</p>
  </div>
</footer>
