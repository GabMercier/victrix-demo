---
import { getEntry, getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { type Locale, defaultLocale, otherLocale, localizePath, swapLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { resolveNavHref } from '../lib/navigation/service-links';
import { isWithinWindow } from '../lib/schedule';

/**
 * Global site header: dismissible announcement bar, logo, primary navigation,
 * a working FR/EN language switcher, and an accessible mobile drawer menu.
 * Locale-aware. CONTENT (menu items, mega menu, announcement, portal button)
 * comes from the `navigation` collection — src/data/navigation/<lang>.json,
 * editable in CloudCannon; hrefs are stored locale-less and localized here.
 * Only accessibility strings stay in the UI dictionary (src/i18n/ui.ts).
 * This is site chrome rendered at build — astro:content is fine here (the
 * browser-safe rule only applies to Bookshop section components).
 */

interface Props {
  lang?: Locale;
  /** Equivalent page path in the other locale (for the language switch). */
  altLocalePath?: string;
}

const { lang = defaultLocale, altLocalePath } = Astro.props;
const t = useTranslations(lang);

const navEntry = await getEntry('navigation', lang);
if (!navEntry) {
  throw new Error(`[navigation] Fichier manquant : src/data/navigation/${lang}.json`);
}
const nav = navEntry.data;

// Slugs de la collection `services` POUR CETTE LANGUE — méga-menu dynamique
// (P-07, E.3). Un lien de navigation portant un `service` est résolu vers
// /<lang>/services/<slug> et VALIDÉ contre cet ensemble : un service inexistant
// FAIT ÉCHOUER le build (src/lib/navigation/service-links.ts, prouvé par test).
// La navigation reste la source de l'ordre et des libellés; la collection est
// la source de vérité des URLs. Tant qu'aucun lien ne porte de `service` (cas
// actuel), le rendu du header est identique à l'octet.
const serviceEntries = await getCollection('services');
const serviceSlugs = new Set(
  serviceEntries
    .filter((entry) => entry.id.startsWith(`${lang}/`))
    .map((entry) => entry.id.slice(lang.length + 1)),
);

// L'entrée qui PORTE le méga-menu est celle dont l'URL RÉSOLUE égale le
// « parentHref » résolu — comparaison sur les URLs finales (localisées), pas
// sur les valeurs brutes : un item converti en lien `service` (href vide, URL
// /<lang>/services/<slug>) doit encore accrocher son méga-menu. parentHref est
// un href simple (schéma navHref) → resolveNavHref le localise.
const megaParentHref = resolveNavHref({ href: nav.mega.parentHref }, lang, serviceSlugs);
const navItems = nav.items.map((item) => {
  // Résout un lien vers un service (validé) ou localise l'href brut (défaut).
  const href = resolveNavHref(item, lang, serviceSlugs);
  return {
    label: item.label,
    href,
    mega: href === megaParentHref ? nav.mega : undefined,
  };
});

// Garde-fou build : le méga-menu DOIT s'accrocher à une entrée du menu. Un
// « parentHref » orphelin (aucune entrée ne correspond) ferait disparaître le
// méga-menu SILENCIEUSEMENT — on casse le build en nommant le fichier et la
// valeur fautive (rien de cassé n'atteint le site).
if (!navItems.some((item) => item.mega)) {
  throw new Error(
    `[navigation] ${lang}.json : « parentHref » (${nav.mega.parentHref}) ne correspond à aucune entrée du menu principal — le méga-menu ne s'afficherait nulle part. Aligner « Lien parent » sur le lien (ou le service) d'une entrée du menu.`,
  );
}

// Mega-menu column icons (24×24 stroke outlines, colored via currentColor) —
// keyed by the `icon` names used in the ui dictionary.
const megaIcons: Record<string, string> = {
  strategy:
    '<path d="M3 21h18M5 18h14M7 18v-7m3.5 7v-7m3 7v-7m3.5 7v-7M3.5 8L12 3l8.5 5h-17z"/>',
  cloud:
    '<path d="M7 18a4.5 4.5 0 1 1 .63-8.96A6 6 0 0 1 19.2 10.6 3.8 3.8 0 0 1 18 18H7z"/>',
  security:
    '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/>',
  productivity:
    '<path d="M5.5 14.5l4 4c5-2 8.5-5.2 9.5-10.7l.3-3.6-3.6.3C10.2 5.5 7 9 5.5 14.5z"/><circle cx="14" cy="10" r="1.7"/><path d="M5.5 14.5L3 21l6.5-2.5"/>',
  managed:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3m0 13v3M2.5 12h3m13 0h3M5.2 5.2l2.1 2.1m9.4 9.4l2.1 2.1m0-13.6l-2.1 2.1M7.3 16.7l-2.1 2.1"/>',
};

// The portal lives under the locale prefix, like every other page.
const portal = {
  label: nav.portal.label,
  visible: nav.portal.visible,
  href: localizePath('/portail', lang),
};

// Recherche interne (P-06) : icône dans les actions du header (desktop) +
// lien dans le tiroir mobile. Chaînes d'interface (pas du contenu) → ui.ts.
const searchHref = localizePath('/recherche', lang);

const announce = nav.announce;
const announceLink = localizePath(announce.linkHref, lang);

// Fenêtre de diffusion planifiée de la bannière (schedule.ts) — évaluée au
// BUILD. Le build d'édition (STATIC_ONLY — même gotcha d'expression membre
// exacte que blog.ts) IGNORE la fenêtre : l'éditeur doit toujours voir et
// pouvoir modifier la bannière; la fenêtre s'applique aux builds publiés.
const STATIC_ONLY_BUILD = Boolean(import.meta.env.STATIC_ONLY);
const announceVisible =
  announce.enabled &&
  (STATIC_ONLY_BUILD || isWithinWindow(new Date(), announce.startAt, announce.endAt));

// Active-state matching against the localized current path.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};

// Language switch targets: current page stays put; the other links across.
const alt = altLocalePath ?? swapLocale(Astro.url.pathname, otherLocale[lang]);
const frHref = lang === 'fr' ? Astro.url.pathname : alt;
const enHref = lang === 'en' ? Astro.url.pathname : alt;
---

<!-- Announcement bar (editable / dismissible; « Affichée » switch + fenêtre planifiée in the CMS) -->
{
  announceVisible && (
    <div class="announcement" data-announcement>
      <div class="container announcement__inner">
        <p class="announcement__text">
          {announce.before}<strong>{announce.strong}</strong>{announce.after}
          <a class="announcement__link" href={announceLink}>
            {announce.linkLabel}
          </a>
        </p>
        <button
          type="button"
          class="announcement__close"
          data-announce-close
          aria-label={t.announce.close}
        >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M2 2l12 12M14 2L2 14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </div>
  )
}

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={localizePath('/', lang)} aria-label={t.nav.brandAria}>
      <Logo variant="dark" />
    </a>

    <nav class="primary-nav" aria-label="Navigation">
      <ul role="list" class="primary-nav__list">
        {
          navItems.map((item) => (
            <li class:list={[{ 'has-mega': !!item.mega }]} data-mega={item.mega ? '' : undefined}>
              <a
                class="primary-nav__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                aria-haspopup={item.mega ? 'true' : undefined}
                aria-expanded={item.mega ? 'false' : undefined}
              >
                {item.label}
              </a>
              {item.mega && (
                <div class="mega" aria-label={item.mega.ariaLabel}>
                  <div class="container mega__grid">
                    {item.mega.columns.map((col) => (
                      <div class="mega__col">
                        <a class="mega__title" href={localizePath(col.href, lang)}>
                          <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            focusable="false"
                            set:html={megaIcons[col.icon]}
                          />
                          <span>{col.title}</span>
                        </a>
                        <ul role="list" class="mega__list">
                          {col.links.map((link) => (
                            <li>
                              <a class="mega__link" href={resolveNavHref(link, lang, serviceSlugs)}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a
        class="site-header__search"
        href={searchHref}
        aria-label={t.search.navAria}
        aria-current={isCurrent(searchHref) ? 'page' : undefined}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="M15.5 15.5L21 21"></path>
        </svg>
      </a>
      {
        portal.visible && (
          <a class="btn btn--primary site-header__portal" href={portal.href}>
            {portal.label}
          </a>
        )
      }

      <div class="lang-switch" role="group" aria-label={t.nav.langGroupAria}>
        <a class:list={['lang-switch__link', { 'is-active': lang === 'fr' }]} href={frHref} aria-current={lang === 'fr' ? 'true' : undefined} lang="fr">FR</a>
        <span class="lang-switch__sep" aria-hidden="true">|</span>
        <a class:list={['lang-switch__link', { 'is-active': lang === 'en' }]} href={enHref} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
      </div>

      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.openMenu}
      >
        <span class="nav-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
  <div class="mobile-nav__backdrop" data-nav-close></div>
  <nav class="mobile-nav__panel" aria-label="Navigation">
    <div class="mobile-nav__head">
      <a class="site-header__brand" href={localizePath('/', lang)} aria-label={t.nav.brandAria}>
        <Logo variant="dark" />
      </a>
      <button type="button" class="nav-close" data-nav-close aria-label={t.nav.closeMenu}>
        <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M2 2l12 12M14 2L2 14"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <ul role="list" class="mobile-nav__list">
      {
        navItems.map((item) => (
          <li>
            <a
              class="mobile-nav__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="mobile-nav__link"
          href={searchHref}
          aria-current={isCurrent(searchHref) ? 'page' : undefined}
        >
          {t.search.navLabel}
        </a>
      </li>
    </ul>

    {
      portal.visible && (
        <a class="btn btn--primary mobile-nav__portal" href={portal.href}>
          {portal.label}
        </a>
      )
    }

    <div class="lang-switch lang-switch--mobile" role="group" aria-label={t.nav.langGroupAria}>
      <a class:list={['lang-switch__link', { 'is-active': lang === 'fr' }]} href={frHref} aria-current={lang === 'fr' ? 'true' : undefined} lang="fr">FR</a>
      <span class="lang-switch__sep" aria-hidden="true">|</span>
      <a class:list={['lang-switch__link', { 'is-active': lang === 'en' }]} href={enHref} aria-current={lang === 'en' ? 'true' : undefined} lang="en">EN</a>
    </div>
  </nav>
</div>

<script>
  // With <ClientRouter /> this module executes ONCE per session while the DOM
  // is swapped on every navigation — so all element bindings live in an
  // astro:page-load handler (fires on initial load AND after each swap).
  // Window/document-level listeners stay outside so they register only once.

  /** Closes the currently-bound drawer, if any (refreshed on each page-load). */
  let closeDrawer: (() => void) | null = null;

  // Close if the viewport grows to desktop while the drawer is open.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) closeDrawer?.();
  });

  // Leaving the page with the drawer open: restore scroll + drop the focus trap.
  document.addEventListener('astro:before-swap', () => closeDrawer?.());

  document.addEventListener('astro:page-load', bindHeader);

  function bindHeader() {
  // --- Mobile drawer ------------------------------------------------------
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-nav]');

  closeDrawer = null;

  if (toggle && drawer) {
    const getFocusable = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      );
    let lastFocused: HTMLElement | null = null;

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'Tab') {
        const f = getFocusable();
        if (f.length === 0) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      drawer.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('no-scroll');
      getFocusable()[0]?.focus();
      document.addEventListener('keydown', onKeydown);
    };

    const close = () => {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('no-scroll');
      document.removeEventListener('keydown', onKeydown);
      lastFocused?.focus();
    };

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') {
        close();
      } else {
        open();
      }
    });
    drawer
      .querySelectorAll('[data-nav-close]')
      .forEach((el) => el.addEventListener('click', close));
    // Close (then navigate) when a drawer link is activated.
    drawer
      .querySelectorAll('.mobile-nav__link, .mobile-nav__portal')
      .forEach((el) => el.addEventListener('click', close));

    closeDrawer = () => {
      if (!drawer.hidden) close();
    };
  }

  // --- Mega menu ----------------------------------------------------------
  // Open/close is CSS-driven (:hover / :focus-within); JS only syncs
  // aria-expanded and lets Escape close the panel (until pointer/focus leaves).
  document.querySelectorAll<HTMLLIElement>('[data-mega]').forEach((li) => {
    const trigger = li.querySelector<HTMLAnchorElement>('.primary-nav__link');
    const setExpanded = (v: boolean) => trigger?.setAttribute('aria-expanded', String(v));
    const reopenable = () => {
      li.classList.remove('mega-closed');
    };
    li.addEventListener('mouseenter', () => setExpanded(true));
    li.addEventListener('focusin', () => setExpanded(true));
    li.addEventListener('mouseleave', () => {
      setExpanded(false);
      reopenable();
    });
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) {
        setExpanded(false);
        reopenable();
      }
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // Focus first: it fires focusin (→ expanded=true), which the two
        // lines below then correct — the reverse order would leave
        // aria-expanded="true" on a hidden panel.
        trigger?.focus();
        li.classList.add('mega-closed');
        setExpanded(false);
      }
    });
  });

  // --- Announcement bar dismissal ----------------------------------------
  // The dismissed state is applied pre-paint by a blocking script in <head>
  // (adds .announce-dismissed on <html>); here we only handle the close click.
  const announceClose = document.querySelector<HTMLButtonElement>('[data-announce-close]');
  if (announceClose) {
    announceClose.addEventListener('click', () => {
      document.documentElement.classList.add('announce-dismissed');
      try {
        sessionStorage.setItem('victrix-announce', 'closed');
      } catch {
        /* sessionStorage unavailable — banner still hides for this page view */
      }
    });
  }
  }
</script>

<style>
  /* ---------- Announcement bar ---------- */
  .announcement {
    background-color: var(--color-accent-blue);
    color: var(--color-white);
    font-size: var(--fs-200);
  }
  .announcement__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    justify-content: center;
    padding-block: var(--space-2);
  }
  .announcement__text {
    margin: 0;
    max-width: none;
    text-align: center;
  }
  .announcement__link {
    color: var(--color-white);
    font-weight: var(--fw-semibold);
    text-decoration: underline;
    white-space: nowrap;
  }
  .announcement__close {
    flex-shrink: 0;
    display: inline-flex;
    padding: var(--space-1);
    background: transparent;
    border: 0;
    color: var(--color-white);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  /* ---------- Header bar ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 76px;
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    --logo-height: 40px;
  }

  /* ---------- Primary (desktop) nav ---------- */
  .primary-nav {
    display: none;
  }
  .primary-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 2vw, var(--space-6));
    margin: 0;
  }
  .primary-nav__link {
    color: var(--color-navy);
    font-weight: var(--fw-medium);
    text-decoration: none;
    padding-block: var(--space-2);
    white-space: nowrap;
  }
  .primary-nav__link:hover {
    color: var(--color-accent-blue);
  }
  .primary-nav__link[aria-current='page'] {
    color: var(--color-accent-blue);
    font-weight: var(--fw-semibold);
    box-shadow: inset 0 -2px 0 0 var(--color-accent-blue);
  }

  /* ---------- Mega menu (desktop) ----------
     The panel is a child of its nav <li>, so li:hover / :focus-within keeps it
     open while the pointer or focus is inside. Negative margin + padding
     stretch the li's hover area to the header's edges so the pointer never
     crosses a "dead" gap on its way down to the panel. Positioned against
     .site-header (sticky ⇒ containing block), spanning its full width. */
  .has-mega {
    padding-block: var(--space-5);
    margin-block: calc(-1 * var(--space-5));
  }
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    box-shadow: 0 28px 48px -16px rgb(8 57 87 / 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.16s ease,
      transform 0.16s ease,
      visibility 0s linear 0.16s;
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
    transition-delay: 0s;
  }
  /* Escape closes the panel until the pointer/focus leaves the item. */
  .has-mega.mega-closed .mega {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .mega {
      transition: none;
      transform: none;
    }
  }
  .mega__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-7);
  }
  .mega__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-navy);
    font-size: var(--fs-200);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mega__title svg {
    flex-shrink: 0;
    color: var(--color-accent-blue);
  }
  .mega__title:hover span {
    color: var(--color-accent-blue);
  }
  .mega__list {
    margin: var(--space-4) 0 0;
    padding-left: calc(24px + var(--space-3));
    display: grid;
    gap: var(--space-3);
  }
  .mega__link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--fs-200);
    line-height: 1.4;
    display: inline-block;
  }
  .mega__link:hover {
    color: var(--color-accent-blue);
  }

  /* ---------- Right-side actions ---------- */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .site-header__portal {
    display: none;
  }
  /* Recherche : icône desktop seulement (le mobile passe par le tiroir). */
  .site-header__search {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-navy);
    border-radius: var(--radius-sm);
  }
  .site-header__search:hover,
  .site-header__search[aria-current='page'] {
    color: var(--color-accent-blue);
  }
  /* The header portal button is accent blue on victrix.ca (the global
     .btn--primary stays navy elsewhere). */
  .site-header__portal,
  .mobile-nav__portal {
    background-color: var(--color-accent-blue);
  }
  .site-header__portal:hover,
  .mobile-nav__portal:hover {
    background-color: var(--color-accent-blue-600);
  }

  .lang-switch {
    display: none;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-grey-600);
    font-size: var(--fs-200);
  }
  .lang-switch__link {
    color: var(--color-grey-600);
    text-decoration: none;
    text-transform: lowercase;
    padding: var(--space-1);
  }
  .lang-switch__link.is-active {
    color: var(--color-navy);
    font-weight: var(--fw-semibold);
