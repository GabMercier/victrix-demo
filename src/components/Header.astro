---
import { getEntry, getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { type Locale, defaultLocale, otherLocale, localizePath, swapLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { resolveNavHref } from '../lib/navigation/service-links';
import { getPostsByLocale, postUrlSlug, blogCategories } from '../i18n/blog';
import { isWithinWindow } from '../lib/schedule';

/**
 * Global site header: dismissible announcement bar, logo, primary navigation,
 * a working FR/EN language switcher, and an accessible mobile drawer menu.
 * Locale-aware. CONTENT (menu items, mega menu, announcement, portal button)
 * comes from the `navigation` collection — src/data/navigation/<lang>.json,
 * editable in CloudCannon; hrefs are stored locale-less and localized here.
 * Only accessibility strings stay in the UI dictionary (src/i18n/ui.ts).
 * This is site chrome rendered at build — astro:content is fine here (the
 * browser-safe rule only applies to Bookshop section components).
 *
 * RE-SKIN 2026-08-04 (lot chrome), RE-ANCRÉ 2026-08-14 sur export2
 * (docs/design/export2/Code/{header,mega-menu} — décision v3) : 100 %
 * utilitaires Tailwind (règle no-hybride). Les classes .site-header,
 * .primary-nav, .site-header__search, .lang-switch, .announcement, etc. sont
 * des HOOKS NUS (zéro CSS) : e2e (header-variants.spec.ts), script ci-dessous
 * et global.css (html.announce-dismissed .announcement) s'y accrochent.
 */

interface Props {
  lang?: Locale;
  /** Equivalent page path in the other locale (for the language switch). */
  altLocalePath?: string;
}

const { lang = defaultLocale, altLocalePath } = Astro.props;
const t = useTranslations(lang);

const navEntry = await getEntry('navigation', lang);
if (!navEntry) {
  throw new Error(`[navigation] Fichier manquant : src/data/navigation/${lang}.json`);
}
const nav = navEntry.data;

// Slugs de la collection `services` POUR CETTE LANGUE — méga-menu dynamique
// (P-07, E.3). Un lien de navigation portant un `service` est résolu vers
// /<lang>/services/<slug> et VALIDÉ contre cet ensemble : un service inexistant
// FAIT ÉCHOUER le build (src/lib/navigation/service-links.ts, prouvé par test).
// La navigation reste la source de l'ordre et des libellés; la collection est
// la source de vérité des URLs. Tant qu'aucun lien ne porte de `service` (cas
// actuel), le rendu du header est identique à l'octet.
const serviceEntries = await getCollection('services');
const serviceSlugs = new Set(
  serviceEntries
    .filter((entry) => entry.id.startsWith(`${lang}/`))
    .map((entry) => entry.id.slice(lang.length + 1)),
);

// L'entrée qui PORTE le méga-menu est celle dont l'URL RÉSOLUE égale le
// « parentHref » résolu — comparaison sur les URLs finales (localisées), pas
// sur les valeurs brutes : un item converti en lien `service` (href vide, URL
// /<lang>/services/<slug>) doit encore accrocher son méga-menu. parentHref est
// un href simple (schéma navHref) → resolveNavHref le localise.
const megaParentHref = resolveNavHref({ href: nav.mega.parentHref }, lang, serviceSlugs);
// Fidélité maquette : le même panneau peut s'accrocher à PLUSIEURS entrées
// (parentHrefs supplémentaires — Expertises + Services + Produits).
const megaParentSet = new Set([
  megaParentHref,
  ...(nav.mega.parentHrefs ?? []).map((h) => resolveNavHref({ href: h }, lang, serviceSlugs)),
]);

// Carte mise en avant + bandeau bas du méga-menu Services (Figma
// « Composants ») — blocs OPTIONNELS de la nav, hrefs localisés ici.
const megaFeatured = nav.mega.featured
  ? { ...nav.mega.featured, href: resolveNavHref({ href: nav.mega.featured.href }, lang, serviceSlugs) }
  : undefined;
const megaStripe = nav.mega.stripe
  ? {
      text: nav.mega.stripe.text,
      links: nav.mega.stripe.links.map((l) => ({
        label: l.label,
        href: resolveNavHref({ href: l.href }, lang, serviceSlugs),
      })),
    }
  : undefined;

// Méga-menu RESSOURCES (parité victrix.ca) — contenu GÉNÉRÉ AU BUILD : les
// catégories viennent des étiquettes réelles du blogue (blogCategories — même
// source que les onglets de filtre de l'index Ressources) et les « derniers
// articles » de la collection. La nav ne porte que les textes (voir le schéma
// navigation dans content.config.ts). Un lien de catégorie cible l'index
// filtré : /<lang>/ressources/?categorie=<étiquette>.
const megaRes = nav.megaRessources;
const megaResParentHref = megaRes
  ? resolveNavHref({ href: megaRes.parentHref }, lang, serviceSlugs)
  : undefined;
const blogPosts = megaRes ? await getPostsByLocale(lang) : [];
const resCategories = blogCategories(blogPosts).map((tag) => ({
  label: tag,
  href: `${megaResParentHref}/?categorie=${encodeURIComponent(tag)}`,
}));
// Correction 2026-08-17 : DEUX cartes AVEC image de couverture (les 4 titres
// en liste débordaient de leur rangée h-10 — chevauchement visuel). L'image
// vient du frontmatter `coverImage` (chemin public servi tel quel).
const resLatest = blogPosts.slice(0, 2).map((post) => ({
  title: post.data.title,
  href: localizePath(`/ressources/${postUrlSlug(post)}/`, lang),
  image: post.data.coverImage ?? '',
}));

// Chaque entrée porte au plus une CLÉ de panneau (« main » = le méga partagé
// Expertises·Services·Produits, « ressources » = le méga Ressources). Les
// panneaux sont rendus UNE SEULE FOIS hors des <li> (voir plus bas) : passer
// d'un onglet à l'autre du MÊME panneau ne le ferme/rouvre plus (demande
// 2026-08-04) — il ne se referme que si le contenu change ou si l'entrée
// survolée n'a pas de sous-menu.
const navItems = nav.items.map((item) => {
  // Résout un lien vers un service (validé) ou localise l'href brut (défaut).
  const href = resolveNavHref(item, lang, serviceSlugs);
  const megaKey = megaParentSet.has(href)
    ? 'main'
    : megaRes && href === megaResParentHref
      ? 'ressources'
      : undefined;
  return { label: item.label, href, megaKey };
});

// Ancrage DOM de chaque panneau : dans le DERNIER <li> qui le déclenche —
// l'ordre de tabulation reste « déclencheurs du panneau, puis ses liens »
// (un panneau rendu après le <ul> serait inatteignable au clavier : Tab
// passerait par Carrière/Ressources qui ferment/remplacent le panneau).
const megaPanelAnchor: Record<string, number> = {};
navItems.forEach((item, i) => {
  if (item.megaKey) megaPanelAnchor[item.megaKey] = i;
});

// Garde-fou build : le méga-menu DOIT s'accrocher à une entrée du menu. Un
// « parentHref » orphelin (aucune entrée ne correspond) ferait disparaître le
// méga-menu SILENCIEUSEMENT — on casse le build en nommant le fichier et la
// valeur fautive (rien de cassé n'atteint le site).
if (!navItems.some((item) => item.megaKey === 'main')) {
  throw new Error(
    `[navigation] ${lang}.json : « parentHref » (${nav.mega.parentHref}) ne correspond à aucune entrée du menu principal — le méga-menu ne s'afficherait nulle part. Aligner « Lien parent » sur le lien (ou le service) d'une entrée du menu.`,
  );
}
// Chaque parent SUPPLÉMENTAIRE doit aussi accrocher une entrée — un parent
// orphelin serait ignoré en silence (même philosophie de garde-fou).
const megaOrphans = [...megaParentSet].filter((h) => !navItems.some((i) => i.href === h));
if (megaOrphans.length > 0) {
  throw new Error(
    `[navigation] ${lang}.json : « parentHrefs » du méga-menu — ${megaOrphans.join(', ')} ne correspond(ent) à aucune entrée du menu principal. Aligner chaque valeur sur le lien d'une entrée du menu.`,
  );
}
// Même garde-fou pour le méga-menu Ressources (quand il est configuré).
if (megaRes && !navItems.some((item) => item.megaKey === 'ressources')) {
  throw new Error(
    `[navigation] ${lang}.json : « parentHref » du méga-menu Ressources (${megaRes.parentHref}) ne correspond à aucune entrée du menu principal — le panneau ne s'afficherait nulle part.`,
  );
}

// The portal lives under the locale prefix, like every other page.
const portal = {
  label: nav.portal.label,
  visible: nav.portal.visible,
  href: localizePath('/portail', lang),
};

// Bouton d'action du header (maquette : « Contact » en bouton bleu, le portail
// devient un lien texte). Absent du JSON → repli historique : le portail
// reste le bouton.
const headerCta = nav.cta
  ? { label: nav.cta.label, href: resolveNavHref({ href: nav.cta.href }, lang, serviceSlugs) }
  : null;

// Recherche interne (P-06) : icône dans les actions du header (desktop) +
// lien dans le tiroir mobile. Chaînes d'interface (pas du contenu) → ui.ts.
const searchHref = localizePath('/recherche', lang);

const announce = nav.announce;
const announceLink = localizePath(announce.linkHref, lang);

// Fenêtre de diffusion planifiée de la bannière (schedule.ts) — évaluée au
// BUILD. Le build d'édition (STATIC_ONLY — même gotcha d'expression membre
// exacte que blog.ts) IGNORE la fenêtre : l'éditeur doit toujours voir et
// pouvoir modifier la bannière; la fenêtre s'applique aux builds publiés.
const STATIC_ONLY_BUILD = Boolean(import.meta.env.STATIC_ONLY);
const announceVisible =
  announce.enabled &&
  (STATIC_ONLY_BUILD || isWithinWindow(new Date(), announce.startAt, announce.endAt));

// Active-state matching against the localized current path.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};

// Language switch targets: current page stays put; the other links across.
const alt = altLocalePath ?? swapLocale(Astro.url.pathname, otherLocale[lang]);
const frHref = lang === 'fr' ? Astro.url.pathname : alt;
const enHref = lang === 'en' ? Astro.url.pathname : alt;

// Recettes utilitaires partagées dans CE composant (répétées verbatim côté
// campagnes — composants autonomes, pas d'abstraction partagée).
// Bouton primaire export2 (Code/header) : rayon 4px, 12/24, 14/600, ombre
// effet « normal », hover bleu-600 (= primary-container).
const ctaClass =
  'inline-flex items-center justify-center px-6 py-3 rounded bg-primary text-on-primary text-sm font-semibold no-underline shadow-controle hover:bg-primary-container transition-colors';
// Panneau méga : rendu une seule fois par clé, ouvert via data-open (JS).
// Les gris froids jadis « verbatim maquette » (#F8F9FA/#C5C6D0/#EDEEEF) sont
// devenus l'échelle neutral-* officielle (export2, décision v3 2026-08-14) —
// la divergence consignée le 2026-08-04 est levée, tout passe par tokens.
// « Jamais de défilement » (demande user 2026-08-17) : flex-col + groupe
// nommé `group/mega` — quand le menu déborde du viewport, le script pose
// data-fit (paddings compacts via group-data-[fit]/mega:*) et une min-height
// jusqu'au bas de l'écran ; le bandeau bas est poussé au BORD BAS via
// mt-auto. Menu qui tient = hauteur naturelle, comportement inchangé.
const megaPanelClass =
  'group/mega absolute top-full inset-x-0 flex flex-col bg-white border-0 border-t border-solid border-neutral-300/10 shadow-surelevee invisible opacity-0 -translate-y-1.5 pointer-events-none transition-[opacity,transform] duration-150 data-[open]:visible data-[open]:opacity-100 data-[open]:translate-y-0 data-[open]:pointer-events-auto motion-reduce:transition-none motion-reduce:translate-y-0';
// Tête de colonne (export mega-menu .overline + .divider) : 12/600 uppercase
// ls 0.5px neutral-800, filet appuyé neutral-500.
const megaHeadClass =
  'block text-xs font-semibold uppercase tracking-[0.5px] text-neutral-800 no-underline pb-2 border-0 border-b border-solid border-outline hover:text-primary';
// Lien de colonne (export .menu-list) : 14px neutral-800, hauteur 40px,
// indicateur bleu 6px à gauche au survol (remplace l'ancienne flèche).
const megaLinkClass =
  'relative flex items-center h-10 pl-3.5 pr-2 text-sm text-neutral-800 no-underline transition-colors hover:text-primary before:content-[""] before:absolute before:left-0 before:inset-y-0 before:w-1.5 before:rounded-[1px] before:bg-primary before:opacity-0 before:transition-opacity hover:before:opacity-100';
const langLinkClass = 'no-underline p-1 text-sm';
---

<!-- Announcement bar (editable / dismissible; « Affichée » switch + fenêtre planifiée in the CMS) -->
{
  announceVisible && (
    <div class="announcement bg-primary text-on-primary text-sm" data-announcement>
      <div class="container-site flex items-center justify-center gap-4 py-2">
        <p class="m-0 max-w-none text-center">
          {announce.before}<strong class="font-semibold">{announce.strong}</strong>{announce.after}
          <a class="text-on-primary font-semibold underline whitespace-nowrap" href={announceLink}>
            {announce.linkLabel}
          </a>
        </p>
        <button
          type="button"
          class="shrink-0 inline-flex p-1 bg-transparent border-0 text-on-primary cursor-pointer rounded"
          data-announce-close
          aria-label={t.announce.close}
        >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M2 2l12 12M14 2L2 14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
    </div>
  )
}

<!-- Barre BLANCHE, hauteur 72px + ombre « normal » (export2 Code/header). -->
<header class="site-header sticky top-0 z-50 bg-white shadow-controle">
  <div class="container-site flex items-center justify-between gap-6 min-h-[72px]">
    <a
      class="site-header__brand inline-flex items-center shrink-0 [--logo-height:40px]"
      href={localizePath('/', lang)}
      aria-label={t.nav.brandAria}
    >
      <Logo variant="dark" />
    </a>

    <nav class="primary-nav hidden lg:block" aria-label="Navigation">
      <ul role="list" class="flex items-center gap-[clamp(1rem,2vw,2.5rem)]">
        {
          navItems.map((item, i) => (
            <li class:list={[{ 'py-6 -my-6': !!item.megaKey }]} data-mega={item.megaKey}>
              <a
                class="text-base font-normal text-neutral-600 no-underline whitespace-nowrap py-2 px-2 rounded transition-colors hover:text-primary hover:bg-primary/5 aria-[current=page]:text-primary aria-[current=page]:font-semibold aria-[current=page]:shadow-[inset_0_-2px_0_0_var(--color-primary)]"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                aria-haspopup={item.megaKey ? 'true' : undefined}
                aria-expanded={item.megaKey ? 'false' : undefined}
                aria-controls={item.megaKey ? `mega-${item.megaKey}` : undefined}
              >
                {item.label}
              </a>
              {/* Panneau « main » — UN rendu, PARTAGÉ entre Expertises·Services·
                  Produits : passer d'un onglet à l'autre ré-ouvre le MÊME
                  panneau (no-op, aucun fondu fermer/rouvrir). Absolute → ancré
                  sur le <header> sticky, donc toujours « collant ». */}
              {item.megaKey === 'main' && megaPanelAnchor.main === i && (
                <div
                  id="mega-main"
                  class={megaPanelClass}
                  data-mega-panel="main"
                  aria-label={nav.mega.ariaLabel}
                >
                  <div
                    class:list={[
                      'container-site grid gap-x-10 gap-y-8',
                      megaFeatured
                        ? 'grid-cols-[repeat(3,minmax(0,1fr))_minmax(240px,1fr)]'
                        : 'grid-cols-5',
                      megaStripe ? 'pt-10 pb-10' : 'py-10',
                      'group-data-[fit]/mega:py-6',
                    ]}
                  >
                    {megaFeatured && (
                      <div class="col-start-4 row-start-1 row-span-2 self-start relative overflow-hidden bg-surface-container-low border border-solid border-neutral-300 rounded-lg p-6 flex flex-col items-start gap-1">
                        {/* Halo décoratif bleu du coin supérieur droit (maquette). */}
                        <span
                          class="absolute -top-8 -right-8 size-32 rounded-full bg-[rgba(0,56,230,0.05)] blur-[20px] pointer-events-none"
                          aria-hidden="true"
                        />
                        <span class="size-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                          <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path
                              fill-rule="evenodd"
                              d="M12 2.5c-4.14 0-7.5 3.36-7.5 7.5 0 2.2.95 4.18 2.5 5.6V21.5h5.5v-2h2c.83 0 1.5-.67 1.5-1.5v-2.5h1.9c.56 0 .93-.6.68-1.1L17.5 11.2A7.5 7.5 0 0 0 12 2.5ZM12 7.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-.5-2.3h1v1.5h-1Zm0 7.1h1v1.5h-1Zm3.3-3.3h1.5v1h-1.5Zm-7.1 0h1.5v1H7.7Z"
                            />
                          </svg>
                        </span>
                        <p class="text-base font-bold text-on-surface pt-3 m-0 max-w-none">
                          {megaFeatured.title}
                        </p>
                        {megaFeatured.body && (
                          <p class="text-sm leading-normal text-neutral-700 m-0 max-w-none">
                            {megaFeatured.body}
                          </p>
                        )}
                        <a
                          class="inline-flex items-center gap-1 text-sm font-semibold text-primary no-underline mt-2 hover:underline"
                          href={megaFeatured.href}
                        >
                          {megaFeatured.ctaLabel}
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 16 16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path d="M2 8h11M9 3.5L13.5 8 9 12.5" />
                          </svg>
                        </a>
                        {/* Mode ajusté (menu > viewport) : l'illustration de la
                            carte vedette saute — c'est elle qui fait déborder
                            le panneau sur les fenêtres basses. */}
                        {megaFeatured.image && (
                          <img
                            class="w-full rounded mt-6 group-data-[fit]/mega:hidden"
                            src={megaFeatured.image}
                            alt=""
                            loading="lazy"
                          />
                        )}
                      </div>
                    )}
                    {nav.mega.columns.map((col) => (
                      <div>
                        <a class={megaHeadClass} href={localizePath(col.href, lang)}>
                          {col.title}
                        </a>
                        <ul role="list" class="mt-4 flex flex-col gap-2">
                          {col.links.map((link) => (
                            <li>
                              <a class={megaLinkClass} href={resolveNavHref(link, lang, serviceSlugs)}>
                                <span>{link.label}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                  {megaStripe && (
                    <div class="mt-auto bg-surface-container border-0 border-t border-solid border-neutral-300/10 py-4">
                      <div class="container-site flex flex-wrap items-center justify-between gap-4">
                        <p class="text-sm font-semibold text-neutral-700 m-0 max-w-none">
                          {megaStripe.text}
                        </p>
                        {megaStripe.links.length > 0 && (
                          <div class="flex items-center gap-6">
                            {megaStripe.links.map((l) => (
                              <a
                                class="text-sm font-semibold text-primary no-underline hover:underline"
                                href={l.href}
                              >
                                {l.label}
                              </a>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              )}
              {megaRes && item.megaKey === 'ressources' && megaPanelAnchor.ressources === i && (
                <div
                  id="mega-ressources"
                  class={megaPanelClass}
                  data-mega-panel="ressources"
                  aria-label={megaRes.ariaLabel}
                >
                  <div class="container-site grid grid-cols-[minmax(220px,1fr)_minmax(160px,0.8fr)_2fr] gap-10 py-10 group-data-[fit]/mega:py-6 group-data-[fit]/mega:gap-6">
                    <div>
                      <p class="text-body-md text-on-surface-variant max-w-[32ch] m-0 mb-6">
                        {megaRes.intro}
                      </p>
                      <a class={ctaClass} href={megaResParentHref}>
                        {megaRes.ctaLabel}
                      </a>
                    </div>
                    <div>
                      <p class:list={[megaHeadClass, 'm-0 max-w-none']}>
                        {megaRes.categoriesTitle}
                      </p>
                      <ul role="list" class="mt-4 flex flex-col gap-2">
                        {resCategories.map((cat) => (
                          <li>
                            <a class={megaLinkClass} href={cat.href}>
                              <span>{cat.label}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <p class:list={[megaHeadClass, 'm-0 max-w-none']}>
                        {megaRes.latestTitle}
                      </p>
                      <ul role="list" class="mt-4 grid grid-cols-2 gap-6 max-w-[640px]">
                        {resLatest.map((article) => (
                          <li>
                            <a class="group flex flex-col gap-3 no-underline" href={article.href}>
                              <span class="block aspect-video overflow-hidden rounded bg-surface-container">
                                {article.image && (
                                  <img
                                    src={article.image}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none"
                                  />
                                )}
                              </span>
                              <span class="text-sm leading-normal font-semibold text-neutral-800 transition-colors group-hover:text-primary">
                                {article.title}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4 lg:gap-6">
      <!-- Maquette : seule L'AUTRE langue est proposée (« EN » sur les pages FR). -->
      <div
        class="lang-switch hidden lg:flex items-center text-sm"
        role="group"
        aria-label={t.nav.langGroupAria}
      >
        {
          lang === 'fr' ? (
            <a
              class:list={['lang-switch__link font-semibold text-neutral-600 hover:text-primary', langLinkClass]}
              href={enHref}
              lang="en"
            >
              EN
            </a>
          ) : (
            <a
              class:list={['lang-switch__link font-semibold text-neutral-600 hover:text-primary', langLinkClass]}
              href={frHref}
              lang="fr"
            >
              FR
            </a>
          )
        }
      </div>

      <a
        class="site-header__search hidden lg:flex items-center justify-center size-[34px] rounded-full text-neutral-600 hover:text-primary hover:bg-neutral-600/10 transition-colors aria-[current=page]:text-primary"
        href={searchHref}
        aria-label={t.search.navAria}
        aria-current={isCurrent(searchHref) ? 'page' : undefined}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="M15.5 15.5L21 21"></path>
        </svg>
      </a>

      {
        portal.visible &&
          (headerCta ? (
            <a
              class="site-header__portal hidden lg:inline-flex text-base font-semibold text-neutral-600 no-underline whitespace-nowrap hover:text-primary"
              href={portal.href}
            >
              {portal.label}
            </a>
          ) : (
            <a class:list={['site-header__portal hidden lg:inline-flex', ctaClass]} href={portal.href}>
              {portal.label}
            </a>
          ))
      }

      {
        headerCta && (
          <a class:list={['site-header__cta hidden lg:inline-flex', ctaClass]} href={headerCta.href}>
            {headerCta.label}
          </a>
        )
      }

      <button
        type="button"
        class="lg:hidden size-11 inline-flex items-center justify-center bg-transparent border-0 cursor-pointer text-on-primary-fixed"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.openMenu}
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M3 5h18M3 12h18M3 19h18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div class="fixed inset-0 z-[200]" id="mobile-nav" data-mobile-nav hidden>
  <div class="absolute inset-0 bg-on-primary-fixed/55" data-nav-close></div>
  <nav
    class="absolute inset-y-0 right-0 h-full w-[min(86vw,360px)] overflow-y-auto bg-surface-container-lowest shadow-surelevee p-6 flex flex-col gap-6"
    aria-label="Navigation"
  >
    <div class="flex items-center justify-between [--logo-height:34px]">
      <a
        class="site-header__brand inline-flex items-center"
        href={localizePath('/', lang)}
        aria-label={t.nav.brandAria}
      >
        <Logo variant="dark" />
      </a>
      <button
        type="button"
        class="size-11 inline-flex items-center justify-center bg-transparent border-0 cursor-pointer text-on-primary-fixed"
        data-nav-close
        aria-label={t.nav.closeMenu}
      >
        <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M2 2l12 12M14 2L2 14"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <ul role="list" class="flex flex-col gap-1">
      {
        navItems.map((item) => (
          <li>
            <a
              class="mobile-nav__link block px-2 py-3 rounded text-lg font-medium text-on-primary-fixed no-underline hover:bg-surface-container-low hover:text-primary aria-[current=page]:text-primary aria-[current=page]:font-semibold"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="mobile-nav__link block px-2 py-3 rounded text-lg font-medium text-on-primary-fixed no-underline hover:bg-surface-container-low hover:text-primary aria-[current=page]:text-primary aria-[current=page]:font-semibold"
          href={searchHref}
          aria-current={isCurrent(searchHref) ? 'page' : undefined}
        >
          {t.search.navLabel}
        </a>
      </li>
    </ul>

    <div class="flex flex-col items-start gap-4">
      {
        headerCta && (
          <a class:list={['mobile-nav__cta self-start', ctaClass]} href={headerCta.href}>
            {headerCta.label}
          </a>
        )
      }
      {
        portal.visible &&
          (headerCta ? (
            <a
              class="mobile-nav__portal text-base font-semibold text-neutral-600 no-underline hover:text-primary"
              href={portal.href}
            >
              {portal.label}
            </a>
          ) : (
            <a class:list={['mobile-nav__portal self-start', ctaClass]} href={portal.href}>
              {portal.label}
            </a>
          ))
      }
    </div>

    <div
      class="lang-switch lang-switch--mobile flex items-center text-sm mt-auto"
      role="group"
      aria-label={t.nav.langGroupAria}
    >
      {
        lang === 'fr' ? (
          <a
            class:list={['lang-switch__link font-semibold text-neutral-600 hover:text-primary', langLinkClass]}
            href={enHref}
            lang="en"
          >
            EN
          </a>
        ) : (
          <a
            class:list={['lang-switch__link font-semibold text-neutral-600 hover:text-primary', langLinkClass]}
            href={frHref}
            lang="fr"
          >
            FR
          </a>
        )
      }
    </div>
  </nav>
</div>

<script>
  // With <ClientRouter /> this module executes ONCE per session while the DOM
  // is swapped on every navigation — so all element bindings live in an
  // astro:page-load handler (fires on initial load AND after each swap).
  // Window/document-level listeners stay outside so they register only once.

  /** Closes the currently-bound drawer, if any (refreshed on each page-load). */
  let closeDrawer: (() => void) | null = null;

  // Close if the viewport grows to desktop while the drawer is open.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) closeDrawer?.();
  });

  // Leaving the page with the drawer open: restore scroll + drop the focus trap.
  document.addEventListener('astro:before-swap', () => closeDrawer?.());

  // Escape GLOBAL : ferme tout méga ouvert à la SOURIS (le gestionnaire par
  // <li> ne couvre que le cas clavier — keydown ne remonte que depuis
  // l'élément focalisé). Niveau module (une seule fois), requête le DOM
  // courant : compatible avec les swaps du ClientRouter.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('[data-mega-panel]').forEach((p) => {
      delete p.dataset.open;
      delete p.dataset.fit;
      p.style.minHeight = ''; // retire le mode ajusté (menu > viewport)
    });
    document.querySelectorAll<HTMLLIElement>('[data-mega]').forEach((li) => {
      li.querySelector<HTMLAnchorElement>('a[aria-haspopup]')?.setAttribute('aria-expanded', 'false');
    });
  });

  // « Jamais de défilement » (demande user 2026-08-17, précisée : la règle
  // est LE MENU TIENT-IL, pas une largeur) : à l'ouverture on mesure — si le
  // panneau déborde sous le bas du viewport, il passe en mode AJUSTÉ
  // (data-fit : paddings compacts via group-data-[fit]/mega) et s'ÉTIRE
  // jusqu'au bas de l'écran (min-height depuis son bord haut — sous
  // l'en-tête collant, bannière incluse) : son bandeau bas (mt-auto) colle
  // au bord, tout est visible sans défiler, comme un menu mobile. S'il
  // tient : hauteur naturelle, comportement inchangé. min-height (pas
  // height) : le contenu n'est jamais rogné. Niveau module (une seule fois,
  // requêtes DOM au moment de l'événement) — compatible ClientRouter, comme
  // le Escape global ci-dessus.
  const sizeMegaPanel = (p: HTMLElement) => {
    delete p.dataset.fit;
    p.style.minHeight = '';
    const avail = window.innerHeight - p.getBoundingClientRect().top;
    if (p.scrollHeight > avail) {
      p.dataset.fit = '';
      p.style.minHeight = `${Math.max(0, avail)}px`;
    }
  };
  // Un redimensionnement panneau ouvert re-mesure (entre ou sort du mode
  // ajusté sans fermer/rouvrir).
  window.addEventListener('resize', () => {
    document.querySelectorAll<HTMLElement>('[data-mega-panel]').forEach((p) => {
      if ('open' in p.dataset) sizeMegaPanel(p);
    });
  });

  document.addEventListener('astro:page-load', bindHeader);

  function bindHeader() {
  // --- Mobile drawer ------------------------------------------------------
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-nav]');

  closeDrawer = null;

  if (toggle && drawer) {
    const getFocusable = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      );
    let lastFocused: HTMLElement | null = null;

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'Tab') {
        const f = getFocusable();
        if (f.length === 0) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      drawer.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('no-scroll');
      getFocusable()[0]?.focus();
      document.addEventListener('keydown', onKeydown);
    };

    const close = () => {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('no-scroll');
      document.removeEventListener('keydown', onKeydown);
      lastFocused?.focus();
    };

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') {
        close();
      } else {
        open();
      }
    });
    drawer
      .querySelectorAll('[data-nav-close]')
      .forEach((el) => el.addEventListener('click', close));
    // Close (then navigate) when a drawer link is activated.
    drawer
      .querySelectorAll('.mobile-nav__link, .mobile-nav__portal, .mobile-nav__cta')
      .forEach((el) => el.addEventListener('click', close));

    closeDrawer = () => {
      if (!drawer.hidden) close();
    };
  }

  // --- Mega menu ----------------------------------------------------------
  // Les panneaux sont rendus UNE FOIS par clé ([data-mega-panel="main|
  // ressources"]) et PARTAGÉS entre leurs déclencheurs ([data-mega="<clé>"]) :
  // passer d'Expertises à Services à Produits ré-ouvre le MÊME panneau — no-op,
  // donc aucun fondu fermer/rouvrir (demande 2026-08-04). Le panneau change en
  // fondu quand le CONTENU change (→ Ressources) et se ferme quand le pointeur
  // atteint une entrée de nav SANS sous-menu, quitte la zone du header (barre
  // OU panneau — le panneau est un descendant du <header>), à Escape, ou quand
  // le focus sort de la nav. Escape marque data-mega-closed sur le déclencheur
  // pour ne pas rouvrir tant que le pointeur/focus ne l'a pas quitté.
  const megaItems = Array.from(document.querySelectorAll<HTMLLIElement>('[data-mega]'));
  const megaPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-mega-panel]'));
  const headerEl = document.querySelector<HTMLElement>('header.site-header');
  const navEl = document.querySelector<HTMLElement>('nav.primary-nav');
  const megaTrigger = (li: HTMLLIElement) => li.querySelector<HTMLAnchorElement>('a[aria-haspopup]');
  const closeAllMegas = () => {
    megaPanels.forEach((p) => {
      delete p.dataset.open;
      delete p.dataset.fit;
      p.style.minHeight = '';
    });
    megaItems.forEach((li) => megaTrigger(li)?.setAttribute('aria-expanded', 'false'));
  };
  const openMega = (li: HTMLLIElement) => {
    if ('megaClosed' in li.dataset) return; // fermé par Escape — attendre la sortie
    const key = li.dataset.mega;
    megaPanels.forEach((p) => {
      if (p.dataset.megaPanel === key) {
        p.dataset.open = '';
        sizeMegaPanel(p); // mode ajusté si le menu déborde du viewport (module)
      } else {
        delete p.dataset.open;
        delete p.dataset.fit;
        p.style.minHeight = '';
      }
    });
    // Tous les déclencheurs du panneau ouvert sont « expanded » (ils
    // contrôlent le même panneau), les autres non.
    megaItems.forEach((other) =>
      megaTrigger(other)?.setAttribute('aria-expanded', other.dataset.mega === key ? 'true' : 'false'),
    );
  };
  megaItems.forEach((li) => {
    li.addEventListener('mouseenter', () => openMega(li));
    li.addEventListener('focusin', () => openMega(li));
    // Quitter l'ÉLÉMENT ne ferme pas (sortie du header, entrée sans sous-menu
    // ou changement de contenu) — on redevient seulement ré-ouvrable après un
    // Escape.
    li.addEventListener('mouseleave', () => {
      delete li.dataset.megaClosed;
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // Focus d'abord : focusin (→ ouvre) est corrigé par les deux lignes
        // suivantes — l'ordre inverse laisserait aria-expanded="true" sur un
        // panneau masqué.
        megaTrigger(li)?.focus();
        li.dataset.megaClosed = '';
        closeAllMegas();
      }
    });
  });
  // Une entrée de nav SANS sous-menu ferme le panneau ouvert (souris ET
  // clavier). :scope > ul > li : NE PAS attraper les <li> des listes de liens
  // DANS les panneaux (un survol de lien fermerait son propre panneau).
  navEl?.querySelectorAll<HTMLLIElement>(':scope > ul > li:not([data-mega])').forEach((li) => {
    li.addEventListener('mouseenter', closeAllMegas);
    li.addEventListener('focusin', closeAllMegas);
  });
  // Clavier : le panneau est partagé entre plusieurs <li> — c'est la sortie
  // du focus de la NAV entière (déclencheurs + panneaux) qui ferme.
  navEl?.addEventListener('focusout', (e) => {
    const navRoot = e.currentTarget as HTMLElement;
    if (!navRoot.contains(e.relatedTarget as Node)) closeAllMegas();
  });
  // Escape depuis un lien DU panneau : refocaliser le déclencheur (sinon le
  // focus resterait sur un lien masqué) puis fermer.
  megaPanels.forEach((panel) => {
    panel.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const li = megaItems.find((l) => l.dataset.mega === panel.dataset.megaPanel);
      if (li) {
        megaTrigger(li)?.focus();
        li.dataset.megaClosed = '';
      }
      closeAllMegas();
    });
  });
  // La sortie RÉELLE de la zone du header (barre + panneau) ferme tout.
  headerEl?.addEventListener('mouseleave', closeAllMegas);

  // --- Announcement bar dismissal ----------------------------------------
  // The dismissed state is applied pre-paint by a blocking script in <head>
  // (adds .announce-dismissed on <html>); here we only handle the close click.
  const announceClose = document.querySelector<HTMLButtonElement>('[data-announce-close]');
  if (announceClose) {
    announceClose.addEventListener('click', () => {
      document.documentElement.classList.add('announce-dismissed');
      try {
        sessionStorage.setItem('victrix-announce', 'closed');
      } catch {
        /* sessionStorage unavailable — banner still hides for this page view */
      }
    });
  }
  }
</script>
