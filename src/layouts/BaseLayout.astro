---
import '../styles/global.css';
// Thème Tailwind v4 « Luminous Precision » (Phase 1) — utilitaires + tokens
// @theme, SANS preflight (cohabitation avec les styles existants — voir
// l'entête de theme.css). Importé après global.css; les tokens portent des
// noms distincts des legacy, aucune interférence.
import '../styles/theme.css';
// BANC D'ESSAI (2026-09-21, TEMPORAIRE) — police et bleu commutables par
// ?police= / ?bleu=, pour trancher deux écarts maquettes/site avec le designer.
// Sans paramètre, cette feuille ne s'applique à rien. Voir docs/design/banc-essai.md.
import '../styles/banc-essai.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { type Locale, defaultLocale, otherLocale, htmlLang, swapLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getActiveAnnounceId } from '../lib/announce';
import { getLocaleData } from '../i18n/locale-data';
import { resolveContactPreset, type ContactPresetKeys } from '../lib/contact/presets';

interface Props {
  /** Page locale. Required so chrome, <html lang>, and hreflang are correct. */
  lang?: Locale;
  /** Page title — appended with the site name. */
  title?: string;
  /** Meta description for SEO / social previews. */
  description?: string;
  /** Open Graph / Twitter share image (path under the site root). */
  image?: string;
  /** og:type — "article" for blog posts enables richer share cards. */
  ogType?: 'website' | 'article';
  /** For articles: ISO publish date → article:published_time. */
  publishedTime?: string;
  /** For articles: tags → article:tag. */
  tags?: string[];
  /**
   * Path of the equivalent page in the OTHER locale (for the language switch
   * and hreflang). Defaults to swapping the URL's locale prefix — pages with
   * non-mirrored paths (e.g. the portal) pass this explicitly.
   */
  altLocalePath?: string;
  /**
   * When true, emits <meta name="robots" content="noindex, nofollow"> — used
   * by campaign landing pages (src/content/landing), which default to noindex.
   */
  noindex?: boolean;
  /**
   * Type de contenu pour le FILTRE de la recherche interne (2026-08-17) —
   * valeur du filtre « Type » de Pagefind, posée sur <main> à côté de
   * data-pagefind-body. Par ROUTE (le fichier de route EST le type) :
   * « Service », « Article », « Page »… Même graphie FR/EN (mots communs).
   * Absent → la page n'a pas de valeur de filtre (elle disparaît des
   * résultats quand un filtre est actif) — donner un type à toute page
   * indexable. L'interface Pagefind affiche le groupe automatiquement dès
   * que l'index contient des filtres.
   */
  contentType?: string;
  /**
   * Préremplissage du formulaire Contact par les boutons de la page
   * (2026-09-17, src/lib/contact/presets.ts) : CLÉS neutres (sujet, service)
   * résolues ici en libellés de la langue et vérifiées contre les options
   * réelles de la page Contact, puis posées sur <body data-contact-sujet /
   * data-contact-service>. Le script « provenance des CTA » ci-dessous les
   * ajoute (?sujet= / ?expertise=) à tout lien vers Contact hors chrome.
   * Absent ou vide → rien de posé, comportement historique.
   */
  contactPreset?: ContactPresetKeys;
}

const {
  lang = defaultLocale,
  title,
  description,
  image = '/og-image.png',
  ogType = 'website',
  publishedTime,
  tags,
  altLocalePath,
  noindex = false,
  contentType,
  contactPreset,
} = Astro.props;

const contactLabels =
  contactPreset && (contactPreset.sujet || contactPreset.service)
    ? resolveContactPreset(lang, contactPreset, await getLocaleData('contact', lang))
    : { sujet: '', service: '' };

const t = useTranslations(lang);
const other = otherLocale[lang];

// Id de la bannière d'annonce active (collection `annonces`) — pour le script
// anti-flash ci-dessous. Constant pour tout le build (un seul « maintenant »
// dans src/lib/announce.ts) → le script inline reste identique sur toutes les
// pages, propriété dont dépend le ClientRouter (voir le commentaire du script).
const activeAnnounceId = await getActiveAnnounceId();

const SITE_NAME = t.siteName;
const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
// `||` et non `??` : une description VIDÉE au CMS ('' — incident du 2026-09-18)
// retombe elle aussi sur la description par défaut, jamais de balise vide.
const metaDescription = description || t.defaultDescription;

// Canonical + per-locale alternates for hreflang and the language switch.
const altPath = altLocalePath ?? swapLocale(Astro.url.pathname, other);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altURL = new URL(altPath, Astro.site);
const frURL = lang === 'fr' ? canonicalURL : altURL;
const enURL = lang === 'en' ? canonicalURL : altURL;
const ogImageURL = new URL(image, Astro.site);
const ogLocale = lang === 'fr' ? 'fr_CA' : 'en_CA';
const ogLocaleAlt = lang === 'fr' ? 'en_CA' : 'fr_CA';

// Organization JSON-LD — the ONE sitewide structured-data block, emitted on
// every page (frozen contract). Absolute URLs are required by schema.org
// consumers, hence `new URL(..., Astro.site)` like the canonical/OG URLs above.
// `logo` = public/images/logo-victrix.png (1200×379, fond blanc), rendu du
// SVG de marque src/assets/victrix-logo.svg avec les fills de la charte
// (.lv-mark #0b1334 / .lv-tag #7b889d — le SVG source n'a pas de couleurs,
// elles sont injectées par Logo.astro à l'affichage). Régénérer via sharp si
// le logo change.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Les Solutions Victrix',
  url: new URL('/', Astro.site).href,
  logo: new URL('/images/logo-victrix.png', Astro.site).href,
};

// P-11 — GA4 sous consentement Loi 25 (2026-08-17). PUBLIC_GA4_ID absent →
// AUCUNE balise rendue (zéro requête, parité stricte avec l'existant).
// Présent → deux balises GELÉES (type="text/plain" data-consent="analytics"),
// que ConsentBanner (activateGatedScripts) dégèle à l'acceptation du bandeau
// PUIS à chaque astro:page-load — le re-config gtag à chaque navigation envoie
// le page_view de la page courante (suivi SPA voulu; gtag.js re-injecté vient
// du cache navigateur). La CSP (public/_headers) autorise googletagmanager +
// google-analytics depuis l'édition OPS-CSP du même jour. Accès défensif
// import.meta.env : patron form.astro (bundle Bookshop navigateur).
const env = import.meta.env ?? {};
const GA4_ID = typeof env.PUBLIC_GA4_ID === 'string' ? env.PUBLIC_GA4_ID.trim() : '';
// Amorce construite ici (un script inline Astro n'interpole pas {}) — injectée
// via set:html. GA4_ID vient de l'environnement de build (opérateur), pas
// d'une saisie visiteur.
const ga4Bootstrap = GA4_ID
  ? [
      'window.dataLayer = window.dataLayer || [];',
      'window.gtag = function () { window.dataLayer.push(arguments); };',
      "window.gtag('js', new Date());",
      `window.gtag('config', '${GA4_ID}');`,
    ].join('\n')
  : '';
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    {/* BANC D'ESSAI (2026-09-21, TEMPORAIRE — docs/design/banc-essai.md).
        `?police=montserrat|nunito|hanken|inter` et `?bleu=figma|export2`
        reposent le site dans la variante demandée, sur N'IMPORTE QUELLE page ;
        `?banc=off` remet tout à zéro. Le choix est mémorisé, donc la
        navigation interne le garde sans traîner de paramètre.

        PLACÉ TOUT EN HAUT DU HEAD, volontairement : il pose les attributs
        AVANT le premier rendu, sinon la page clignote dans l'ancienne variante.
        Sans choix mémorisé ni paramètre, il ne fait RIEN — aucun attribut,
        aucune requête vers Google Fonts, aucun octet pour un visiteur normal.

        À RETIRER avec banc-essai.css quand les deux arbitrages seront tranchés. */}
    <script is:inline>
      {
        const CLE = 'victrix-banc-essai';
        const POLICES = {
          montserrat: 'Montserrat:wght@400;500;600;700;800',
          nunito: 'Nunito+Sans:wght@400;500;600;700;800',
          hanken: 'Hanken+Grotesk:wght@400;500;600;700;800',
          inter: '',
        };
        const BLEUS = { figma: 1, export2: 1 };
        const params = new URLSearchParams(location.search);
        let etat = {};
        try {
          etat = JSON.parse(localStorage.getItem(CLE) || '{}') || {};
        } catch {
          etat = {};
        }
        if (params.get('banc') === 'off') {
          etat = {};
        }
        const police = (params.get('police') || '').toLowerCase();
        const bleu = (params.get('bleu') || '').toLowerCase();
        if (police in POLICES) etat.police = police;
        if (bleu in BLEUS) etat.bleu = bleu;
        try {
          if (etat.police || etat.bleu) localStorage.setItem(CLE, JSON.stringify(etat));
          else localStorage.removeItem(CLE);
        } catch {
          /* navigation privée : le banc vaut alors pour cette page seulement */
        }

        const html = document.documentElement;
        // « inter » et « export2 » sont les valeurs du site : on RETIRE
        // l'attribut plutôt que de le poser, pour revenir au rendu normal.
        if (etat.police && etat.police !== 'inter') html.setAttribute('data-police', etat.police);
        else html.removeAttribute('data-police');
        // Sens INVERSÉ le 2026-09-21 : le bleu Figma est devenu celui du site,
        // c'est donc l'ancien (« export2 ») qui se pose en surcouche.
        if (etat.bleu === 'export2') html.setAttribute('data-bleu', 'export2');
        else html.removeAttribute('data-bleu');

        const famille = POLICES[etat.police];
        if (famille && !document.getElementById('banc-essai-police')) {
          const lien = document.createElement('link');
          lien.id = 'banc-essai-police';
          lien.rel = 'stylesheet';
          lien.href = 'https://fonts.googleapis.com/css2?family=' + famille + '&display=swap';
          document.head.appendChild(lien);
        }

        // Étiquette : savoir CE QU'ON REGARDE avant de montrer une capture.
        const etiqueter = () => {
          const ancienne = document.querySelector('.banc-essai-etiquette');
          if (ancienne) ancienne.remove();
          if (!etat.police && !etat.bleu) return;
          const p = document.createElement('p');
          p.className = 'banc-essai-etiquette';
          p.textContent =
            'banc d’essai · ' + (etat.police || 'inter') + ' · ' + (etat.bleu || 'export2') + ' · ';
          const a = document.createElement('a');
          a.href = '?banc=off';
          a.textContent = 'quitter';
          p.appendChild(a);
          document.body.appendChild(p);
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', etiqueter);
        } else {
          etiqueter();
        }
        // Le ClientRouter remplace <body> : l'attribut de <html> survit, pas
        // l'étiquette — on la repose à chaque navigation.
        document.addEventListener('astro:page-load', etiqueter);
      }
    </script>

    {/* Language alternates */}
    <link rel="alternate" hreflang="fr-CA" href={frURL} />
    <link rel="alternate" hreflang="en-CA" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={frURL} />
    <!-- Flux RSS des ressources (P-14) — découverte automatique du flux. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — RSS`}
      href={new URL(`/${lang}/rss.xml`, Astro.site)}
    />

    {/* Icons + theme — official Victrix favicon */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* = --color-nuit (un <meta> ne peut pas consommer var()) — audit P-16. */}
    <meta name="theme-color" content="#0d1430" />

    {/* Preload the primary font to cut layout shift on first paint —
        Hanken Grotesk variable couvre 100-900 en un seul fichier. */}
    <link rel="preload" href="/fonts/InterVariable-subset.woff2" as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {/* Unindexed pages (e.g. campaign landings) opt out of search engines. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Victrix" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Organization structured data (JSON-LD) — see orgSchema above. Pages add
        their own page-level schemas (e.g. BlogPosting) separately. */}
    <JsonLd schema={orgSchema} />

    {/* Schémas JSON-LD par page (P-12 : BreadcrumbList, BlogPosting…) — les
        routes les injectent via slot="head". Jamais dans le slot par défaut :
        il atterrit dans <main>, où le comptage d'enfants (design:previews) et
        le périmètre data-pagefind-body supposent « 1 enfant = 1 section ». */}
    <slot name="head" />

    {/* GA4 (P-11) — balises GELÉES tant que le visiteur n'a pas accepté le
        bandeau Loi 25 (contrat data-consent, voir ConsentBanner.astro). Rien
        n'est rendu sans PUBLIC_GA4_ID. L'amorce définit window.gtag AVANT les
        scripts d'événements des pages (ordre du document — /merci, /recherche). */}
    {GA4_ID && (
      <script
        is:inline
        type="text/plain"
        data-consent="analytics"
        async
        data-src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}
      />
    )}
    {GA4_ID && (
      <script is:inline type="text/plain" data-consent="analytics" set:html={ga4Bootstrap} />
    )}

    {/* SPA-like navigation: swaps page content client-side with a crossfade,
        persists across the site, respects prefers-reduced-motion. Inline
        scripts below re-apply state on astro:after-swap; component scripts
        re-bind on astro:page-load. */}
    <ClientRouter />

    {/* Hide the announcement bar before first paint if THIS banner was
        dismissed this session — prevents a flash/layout jump on every
        navigation. The stored value is the dismissed banner's ID (annonces
        collection): a different banner going live must reappear despite an
        earlier dismissal. The swap resets <html> attributes from the incoming
        static page, so the class is re-applied on astro:after-swap (fires
        before the new page paints). `activeAnnounceId` is constant across the
        whole build, so this script stays identical on every page and the
        router runs it only once — the document-level listener never
        double-registers. */}
    <script is:inline define:vars={{ activeAnnounceId }}>
      (() => {
        const applyDismissed = () => {
          try {
            if (
              activeAnnounceId &&
              sessionStorage.getItem('victrix-announce') === activeAnnounceId
            ) {
              document.documentElement.classList.add('announce-dismissed');
            }
          } catch {}
        };
        applyDismissed();
        document.addEventListener('astro:after-swap', applyDismissed);
      })();
    </script>
    {/* Provenance des appels à l'action (2026-09-16, demande client) : TOUT lien
        vers la page Contact — hors en-tête, menus et pied de page — emporte le
        libellé du bouton cliqué (?cta=) et le titre de la page d'origine (?de=).
        La page Contact s'en sert pour préremplir « Précisez votre demande » et
        deux champs cachés (cta, provenance) transmis avec le message. Aucun
        composant à modifier : le lien est complété AU CLIC, en phase de capture
        (avant le ClientRouter, qui lit alors l'adresse déjà complétée). Sans
        JavaScript, le lien reste un lien vers Contact. Un paramètre déjà
        présent sur le lien (?cta=, ?sujet=, ?expertise= — ex. catalogue de
        solutions) est laissé tel quel. Listes déroulantes (2026-09-17) : les
        libellés posés par la route sur <body data-contact-sujet /
        data-contact-service> deviennent ?sujet= / ?expertise= (préremplissage
        des listes « De quoi souhaitez-vous parler ? » et « Service »). Script
        identique sur toutes les pages → le routeur ne l'exécute qu'une fois ;
        l'écouteur est posé sur document, il survit aux navigations (le
        ClientRouter remplace <body>, donc ses attributs suivent la page). */}
    <script is:inline>
      document.addEventListener(
        'click',
        (e) => {
          const t = e.target;
          const a = t && t.closest ? t.closest('a[href]') : null;
          if (!a || a.closest('header, nav, footer')) return;
          let u;
          try {
            u = new URL(a.getAttribute('href'), location.href);
          } catch {
            return;
          }
          if (u.origin !== location.origin || !/^\/(fr|en)\/contact\/?$/.test(u.pathname)) return;
          let changed = false;
          const ds = document.body.dataset;
          if (ds.contactSujet && !u.searchParams.has('sujet')) {
            u.searchParams.set('sujet', ds.contactSujet);
            changed = true;
          }
          if (ds.contactService && !u.searchParams.has('expertise')) {
            u.searchParams.set('expertise', ds.contactService);
            changed = true;
          }
          if (!u.searchParams.has('cta') && !u.searchParams.has('produit')) {
            const label = (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 80);
            if (label) {
              u.searchParams.set('cta', label);
              u.searchParams.set('de', document.title.replace(/\s+—\s+[^—]+$/, '').trim().slice(0, 120));
              changed = true;
            }
          }
          if (changed) a.setAttribute('href', u.pathname + u.search + u.hash);
        },
        true,
      );
    </script>
  </head>
  <body data-contact-sujet={contactLabels.sujet || undefined} data-contact-service={contactLabels.service || undefined}>
    <a class="skip-link" href="#main-content">{t.skipLink}</a>

    <!-- Global header (a page can override it by filling the "header" slot —
         P-04 : la route campagnes y place CampaignHeader en mode réduit). -->
    <slot name="header"><Header lang={lang} altLocalePath={altPath} /></slot>

    {/* data-pagefind-body — périmètre de la recherche interne (P-06) : seules
        les pages indexables (pas de noindex) entrent dans l'index Pagefind, et
        seulement leur <main> (jamais le chrome header/footer). Dès qu'une page
        porte l'attribut, toutes celles qui ne le portent pas sont exclues.
        data-pagefind-filter (2026-08-17) : filtre « Type » depuis l'attribut
        data-content-type (prop contentType) — l'interface de /recherche
        l'affiche automatiquement. Le slot par défaut suit le contrat « 1
        enfant = 1 section » (comptage design:previews) avec DEUX exceptions
        par attribut : script/style/link et [data-crumbs] (fil d'Ariane —
        src/components/Breadcrumbs.astro). */}
    <main
      id="main-content"
      data-pagefind-body={noindex ? undefined : ''}
      data-pagefind-filter={!noindex && contentType ? 'Type[data-content-type]' : undefined}
      data-content-type={!noindex && contentType ? contentType : undefined}
    >
      <slot />
    </main>

    <!-- Global footer (a page can override it by filling the "footer" slot). -->
    <slot name="footer"><Footer lang={lang} /></slot>

    <!-- Bandeau de consentement Loi 25 (P-10) — sur toutes les pages ; les
         scripts analytiques (P-11) resteront gated sur ce consentement. -->
    <ConsentBanner lang={lang} />
  </body>
</html>
