---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { type Locale, localePaths, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getLocaleData } from '../../i18n/locale-data';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
// Contenu ÉDITABLE AU CMS (collection `contact`, src/data/contact/<lang>.json —
// migré de src/i18n/content/contact.ts le 2026-08-12). Appel nu (gotcha
// Bookshop, voir merci.astro) ; `c.…` aux points d'usage comme avant.
const c = await getLocaleData('contact', lang);

/**
 * Page Contact — FIDÉLITÉ MAQUETTE 2026-08-05 (docs/design/contact.css +
 * capture fournie par le user), lot « une page à la fois » :
 *  - héros centré ivoire : eyebrow 12/700 ls 1.2 bleu, H1 56/800 ls -1.12
 *    navy, sous-titre 18/29 centré ;
 *  - bande beige (surface-container-low) : carte Coordonnées blanche (titre
 *    bleu, rangées icône + libellé/valeur, filet, mini-grille des villes) + 3
 *    cartes bureaux ivoire (photo, ville 24/700, adresse, tél bleu en pied) ;
 *  - section formulaire 2 colonnes : titre 40/700 + intro + puces cochées
 *    bleues à gauche ; panneau #F0EDEA bordé à droite (champs 50px blancs
 *    rayon 4, selects Sujet/Expertise à chevron custom, « Précisez votre
 *    demande », message, consentement, bouton primaire rayon 2).
 * Couleurs : export déjà Hanken/chaud → bleus/navy/textes/fonds = TOKENS
 * (#002FC7→primary, #00105B→on-primary-fixed, #1C1C1A→on-surface,
 * #444656→on-surface-variant, #F6F3EF→surface-container-low, #FCF9F5→surface) ;
 * bordures froides #C4C5D9 et panneau #F0EDEA repris VERBATIM (précédent méga).
 * RÈGLE no-hybride : 100 % utilitaires Tailwind, zéro CSS scopé (l'ancienne
 * feuille de la page est supprimée).
 *
 * PORTAGE /api/forms FAIT (2026-08-17 — docs/formulaires.md §10) : DEUX MODES,
 * même règle que la section « form » (form.astro) :
 *  - PUBLIC_FORMS_ENABLED absente → MAQUETTE inchangée (aucun `action`, le
 *    script en bas simule la confirmation — il se repère par
 *    [data-contact-form], attribut posé seulement dans ce mode) ;
 *  - PUBLIC_FORMS_ENABLED="1" → vrai <form method="POST" action="/api/forms">
 *    avec le contrat de champs §4 : `lang`, `source`, `_formId: contact`
 *    (le serveur dérive requis/courriels/cases et la liste blanche des selects
 *    DEPUIS la définition src/data/forms/<lang>/contact.json), pot de miel
 *    `website`, bannière ?erreur=1, widget Turnstile si la clé est posée,
 *    data-astro-reload (POST natif urlencoded, vrai suivi du 303 vers /merci).
 * Les `name` des champs sont DÉRIVÉS de la définition (fieldName partagé) et
 * deux garde-fous de build cassent la compilation si la page et la définition
 * divergent (libellés, options des selects) — une dérive silencieuse ferait
 * rejeter des soumissions légitimes.
 */
import { getEntry } from 'astro:content';
import { fieldName } from '../../lib/forms/field-name';

// Locale-neutral coordinates (template-only, mirrors the office cards order).
const officePhones = [
  { phone: '418-780-8181', tel: '+14187808181' },
  { phone: '514-879-1919', tel: '+15148791919' },
  { phone: '+33 1 74 90 50 40', tel: '+33174905040' },
];

const consentHtml = c.consentText.replace('{privacy}', localizePath('/politique-confidentialite', lang));

// --- Formulaire réel : définition, noms de champs, garde-fous ---------------
const formDefEntry = await getEntry('forms', `${lang}/contact`);
if (!formDefEntry) {
  throw new Error(
    `[contact] définition introuvable : src/data/forms/${lang}/contact.json — la page Contact exige un formulaire « contact » par langue.`,
  );
}
const formDef = formDefEntry.data;
const defNames = new Map(formDef.fields.map((f, i) => [f.label, fieldName(f.label, i)]));
/** Nom HTML d'un champ, par LIBELLÉ exact de la définition (garde-fou build). */
const nameFor = (label: string): string => {
  const name = defNames.get(label);
  if (!name) {
    throw new Error(
      `[contact] champ « ${label} » absent de src/data/forms/${lang}/contact.json — réaligner la définition avec la page (libellés identiques, à l'accent près).`,
    );
  }
  return name;
};
/** Les options d'un select de la page doivent égaler celles de la définition. */
const assertSameOptions = (label: string, options: string[]): void => {
  const defOptions = formDef.fields.find((f) => f.label === label)?.options ?? [];
  const same =
    options.length === defOptions.length && options.every((opt, i) => opt === defOptions[i]);
  if (!same) {
    throw new Error(
      `[contact] options de « ${label} » désalignées entre src/data/contact/${lang}.json (page) et src/data/forms/${lang}/contact.json (définition — la liste blanche du serveur).`,
    );
  }
};
assertSameOptions(c.labels.subject, c.subjectOptions);
assertSameOptions(c.labels.expertise, c.expertiseOptions);
// La case de consentement est identifiée par TYPE (son libellé de définition
// est interne — la page affiche son propre texte riche avec le lien).
const consentDefField = formDef.fields.find((f) => f.type === 'checkbox');
if (!consentDefField) {
  throw new Error(
    `[contact] la définition src/data/forms/${lang}/contact.json doit contenir une case à cocher (consentement Loi 25).`,
  );
}
const consentName = nameFor(consentDefField.label);

// Mode fonctionnel (mêmes drapeaux que form.astro — parité stricte sans clés).
const env = import.meta.env ?? {};
const formsEnabled = env.PUBLIC_FORMS_ENABLED === '1';
const turnstileSiteKey = formsEnabled ? env.PUBLIC_TURNSTILE_SITE_KEY || '' : '';
const pagePath = Astro.url?.pathname ?? '';

// Pot de miel : idiome « visuellement masqué » EN LIGNE (patron form.astro).
const honeypotStyle =
  'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;';
const errorBannerStyle =
  'border:1px solid var(--color-error);background-color:var(--color-error-container);color:var(--color-on-error-container);';
const errorMessage =
  lang === 'en'
    ? 'Your message could not be sent. Please check your answers and try again.'
    : 'Votre message n’a pas pu être envoyé. Vérifiez vos réponses, puis réessayez.';

// Recettes partagées de la page (répétées si besoin ailleurs — pas d'abstraction).
const cardBorder = 'border border-solid border-[#C4C5D9]';
const labelClass = 'block text-base font-bold text-on-surface';
const inputClass =
  'w-full h-[50px] px-3 bg-white border border-solid border-[#C4C5D9] rounded text-base text-on-surface focus-visible:border-primary focus-visible:outline-none';
const cityLabelClass = 'block text-xs font-bold uppercase tracking-[1.2px] text-on-surface-variant mb-1';
const phoneIcon =
  'M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z';
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDescription} contentType="Page">
  <Breadcrumbs
    lang={lang}
    items={[
      { name: t.article.breadcrumbHome, path: localizePath('/', lang) },
      { name: c.metaTitle },
    ]}
  />
  {/* LocalBusiness ×3 (2026-08-17, F3.2) — un schéma par bureau, depuis le
      MÊME contenu CMS que les cartes (collection contact) : adresse, ville,
      téléphone (apparié par position, comme les cartes), photo. */}
  {
    c.offices.map((office, i) => (
      <JsonLd
        slot="head"
        schema={{
          '@context': 'https://schema.org',
          '@type': 'LocalBusiness',
          name: `Les Solutions Victrix — ${office.city}`,
          parentOrganization: { '@type': 'Organization', name: 'Les Solutions Victrix' },
          address: {
            '@type': 'PostalAddress',
            streetAddress: office.lines.join(', '),
            addressLocality: office.city,
            addressCountry: office.city === 'Paris' ? 'FR' : 'CA',
          },
          ...(officePhones[i] ? { telephone: officePhones[i].tel } : {}),
          ...(office.image ? { image: new URL(office.image, Astro.site).href } : {}),
          url: new URL(Astro.url.pathname, Astro.site).href,
        }}
      />
    ))
  }
  <!-- Hero -->
  <section class="bg-surface py-20 lg:py-24">
    <div class="container-site flex flex-col items-center text-center gap-4">
      <p class="text-xs font-bold uppercase tracking-[1.2px] text-primary m-0 max-w-none">{c.heroEyebrow}</p>
      <h1 class="text-[40px] leading-[1.1] lg:text-[56px] lg:leading-[62px] font-extrabold tracking-[-1.12px] text-on-primary-fixed m-0">
        {c.heroTitle}
      </h1>
      <p class="text-lg leading-[29px] text-on-surface-variant max-w-[672px] m-0">{c.heroSub}</p>
    </div>
  </section>

  <!-- Coordonnées + bureaux -->
  <section class="bg-surface-container-low pt-20 pb-28 lg:pb-40">
    <div class="container-site grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr] gap-6 items-stretch">
      <!-- Carte coordonnées -->
      <div class:list={['bg-white rounded-sm shadow-[0_1px_2px_rgba(0,0,0,0.05)] p-8 lg:p-10 flex flex-col gap-8', cardBorder]}>
        <h2 class="text-2xl font-bold text-primary m-0">{c.infoTitle}</h2>
        <div class="flex flex-col gap-4">
          <div class="flex items-start gap-4">
            <svg class="shrink-0 mt-1 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={phoneIcon} />
            </svg>
            <p class="m-0 max-w-none">
              <span class="block text-base font-bold text-on-surface">{c.infoLabels.tollFree}</span>
              <a class="text-base text-on-surface-variant no-underline hover:text-primary" href="tel:+18886808181">1-888-680-8181</a>
            </p>
          </div>
          <div class="flex items-start gap-4">
            <svg class="shrink-0 mt-1 text-primary" width="20" height="16" viewBox="0 0 24 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2" y="2" width="20" height="16" rx="2" />
              <path d="m2 4 10 8L22 4" />
            </svg>
            <p class="m-0 max-w-none">
              <span class="block text-base font-bold text-on-surface">{c.infoLabels.email}</span>
              <a class="text-base text-on-surface-variant no-underline hover:text-primary" href="mailto:contact@victrix.ca">contact@victrix.ca</a>
            </p>
          </div>
        </div>
        <div class="border-0 border-t border-solid border-[#C4C5D9] pt-4 grid grid-cols-2 gap-x-6 gap-y-4">
          <p class="m-0 max-w-none">
            <span class={cityLabelClass}>{c.infoLabels.montreal}</span>
            <a class="text-base text-on-surface no-underline hover:text-primary" href="tel:+15148791919">514-879-1919</a>
          </p>
          <p class="m-0 max-w-none">
            <span class={cityLabelClass}>{c.infoLabels.quebec}</span>
            <a class="text-base text-on-surface no-underline hover:text-primary" href="tel:+14187808181">418-780-8181</a>
          </p>
          <p class="m-0 max-w-none">
            <span class={cityLabelClass}>{c.infoLabels.paris}</span>
            <a class="text-base text-on-surface no-underline hover:text-primary" href="tel:+33174905040">+33 1 74 90 50 40</a>
          </p>
        </div>
      </div>

      <!-- Cartes bureaux -->
      {
        c.offices.map((office, i) => (
          <article class:list={['bg-surface rounded-sm p-6 flex flex-col', cardBorder]}>
            <img
              class="w-full aspect-[16/10] object-cover rounded-sm border-0"
              src={office.image}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3 class="text-2xl font-bold text-on-surface m-0 mt-5 mb-2">{office.city}</h3>
            <address class="not-italic text-base leading-6 text-on-surface-variant m-0">
              {office.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
            </address>
            {officePhones[i] && (
              <a
                class="mt-auto pt-6 inline-flex items-center gap-2 text-base font-bold text-primary no-underline hover:text-primary-container"
                href={`tel:${officePhones[i].tel}`}
              >
                <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={phoneIcon} />
                </svg>
                {officePhones[i].phone}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- Formulaire -->
  <section class="bg-surface py-20 lg:py-24">
    <div class="container-site grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12 lg:gap-20 items-start">
      <div class="flex flex-col gap-4">
        <h2 class="text-[32px] leading-[1.2] lg:text-[40px] lg:leading-[48px] font-bold tracking-[-0.4px] text-on-surface m-0 text-balance">
          {c.formTitle}
        </h2>
        <p class="text-lg leading-[29px] text-on-surface-variant m-0 max-w-none">{c.formIntro}</p>
        <ul role="list" class="flex flex-col gap-4 m-0 p-0 pt-4 list-none">
          {
            c.formBullets.map((bullet) => (
              <li class="m-0 flex items-center gap-2">
                <svg class="shrink-0 text-primary" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m8.5 12 2.5 2.5 4.5-5" />
                </svg>
                <span class="text-base font-bold text-primary">{bullet}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class:list={['bg-[#F0EDEA] rounded-sm p-6 sm:p-8 lg:p-12', cardBorder]}>
        <p class="sr-only" id="req-note">{c.reqNote}</p>
        <form
          class="flex flex-col gap-6"
          aria-describedby="req-note"
          data-contact-form={formsEnabled ? undefined : ''}
          method={formsEnabled ? 'POST' : undefined}
          action={formsEnabled ? '/api/forms' : undefined}
          data-astro-reload={formsEnabled ? '' : undefined}
        >
          {
            formsEnabled && (
              <>
                {/* Bannière d'erreur + mini-script FRÈRES ADJACENTS (le script se
                    repère par previousElementSibling) — patron form.astro. */}
                <p class="m-0 max-w-none px-4 py-3 rounded text-sm leading-normal" role="alert" hidden style={errorBannerStyle}>
                  {errorMessage}
                </p>
                <script is:inline data-astro-rerun>
                  // Révèle la bannière au retour d'un échec (« ?erreur=1 »).
                  {
                    const s = document.currentScript;
                    const b = s && s.previousElementSibling;
                    if (b && /[?&]erreur=/.test(location.search)) b.removeAttribute('hidden');
                  }
                </script>
                <input type="hidden" name="lang" value={lang} />
                <input type="hidden" name="source" value={pagePath} />
                <input type="hidden" name="_formId" value="contact" />
                {/* Pot de miel `website` — voir honeypotStyle. */}
                <div aria-hidden="true" style={honeypotStyle}>
                  <label for="contact-website">Site Web</label>
                  <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off" />
                </div>
              </>
            )
          }
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-2">
              <label class={labelClass} for="firstname">{c.labels.firstName} <span aria-hidden="true">*</span></label>
              <input class={inputClass} id="firstname" name={formsEnabled ? nameFor(c.labels.firstName) : 'firstname'} type="text" autocomplete="given-name" required />
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelClass} for="lastname">{c.labels.lastName} <span aria-hidden="true">*</span></label>
              <input class={inputClass} id="lastname" name={formsEnabled ? nameFor(c.labels.lastName) : 'lastname'} type="text" autocomplete="family-name" required />
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelClass} for="email">{c.labels.email} <span aria-hidden="true">*</span></label>
              <input class={inputClass} id="email" name={formsEnabled ? nameFor(c.labels.email) : 'email'} type="email" autocomplete="email" required />
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelClass} for="phone">{c.labels.phone}</label>
              <input class={inputClass} id="phone" name={formsEnabled ? nameFor(c.labels.phone) : 'phone'} type="tel" autocomplete="tel" />
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelClass} for="subject">{c.labels.subject} <span aria-hidden="true">*</span></label>
              <span class="relative block">
                <select class:list={[inputClass, 'appearance-none pr-10']} id="subject" name={formsEnabled ? nameFor(c.labels.subject) : 'subject'} required>
                  <option value="">{c.labels.subjectPlaceholder}</option>
                  {c.subjectOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-[#6B7280]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </div>
            <div class="flex flex-col gap-2">
              <label class={labelClass} for="expertise">{c.labels.expertise} <span aria-hidden="true">*</span></label>
              <span class="relative block">
                <select class:list={[inputClass, 'appearance-none pr-10']} id="expertise" name={formsEnabled ? nameFor(c.labels.expertise) : 'expertise'} required>
                  <option value="">{c.labels.expertisePlaceholder}</option>
                  {c.expertiseOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-[#6B7280]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label class={labelClass} for="request">{c.labels.request}</label>
            <input class={inputClass} id="request" name={formsEnabled ? nameFor(c.labels.request) : 'request'} type="text" />
          </div>

          <div class="flex flex-col gap-2">
            <label class={labelClass} for="message">{c.labels.message} <span aria-hidden="true">*</span></label>
            <textarea
              class="w-full h-[122px] p-3 bg-white border border-solid border-[#C4C5D9] rounded text-base text-on-surface resize-y focus-visible:border-primary focus-visible:outline-none"
              id="message"
              name={formsEnabled ? nameFor(c.labels.message) : 'message'}
              required
            ></textarea>
          </div>

          <div class="flex items-start gap-3 py-2">
            <input
              class="size-4 mt-1 shrink-0 bg-white border border-solid border-[#C4C5D9] rounded-sm accent-[var(--color-primary)]"
              id="consent"
              name={formsEnabled ? consentName : 'consent'}
              value="oui"
              type="checkbox"
              required
            />
            <label class="text-base leading-[26px] text-on-surface-variant" for="consent">
              <span set:html={consentHtml} />
            </label>
          </div>

          {
            turnstileSiteKey && (
              <>
                {/* Widget Turnstile — CSP appliquée le 2026-08-17 (public/_headers). */}
                <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-language={lang} />
                <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
              </>
            )
          }

          <button
            type="submit"
            class="self-start bg-primary text-on-primary px-10 py-4 rounded-sm text-base leading-6 border-0 cursor-pointer shadow-[0_1px_3px_rgba(0,0,0,0.1),0_1px_2px_-1px_rgba(0,0,0,0.1)] hover:bg-primary-container transition-colors"
          >
            {c.submit}
          </button>

          <p
            class="m-0 max-w-none px-4 py-3 rounded bg-primary-fixed border border-solid border-primary text-on-primary-fixed font-medium"
            data-form-status
            data-success={c.statusMessage}
            role="status"
            aria-live="polite"
            hidden
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Demo-only submission: validate natively, then confirm inline (no backend).
  // MODE MAQUETTE SEULEMENT : [data-contact-form] n'est posé que quand
  // PUBLIC_FORMS_ENABLED est absente — en mode réel, ce module ne trouve rien
  // et le POST natif suit son cours (303 → /merci). Re-bound on
  // astro:page-load — the DOM is swapped on each client-side navigation while
  // this module executes only once per session.
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLParagraphElement>('[data-form-status]');
    if (form && status) {
      form.noValidate = true;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        status.hidden = false;
        status.textContent = status.dataset.success ?? '';
        form.reset();
      });
    }
  });
</script>
