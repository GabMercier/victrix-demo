---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  type Locale,
  defaultLocale,
  otherLocale,
  localizePath,
  isLocale,
  htmlLang,
} from '../../i18n/config';
import { getPostsByLocale, postUrlSlug } from '../../i18n/blog';
// Le renderer Bookshop partagé mappe chaque section à son composant. Les
// sections DOIVENT passer par lui — avec la directive `bookshop:live` — pour
// que l'édition visuelle CloudCannon se branche (voir l'entête du renderer).
import Page from '../../../component-library/src/shared/astro/page.astro';
import JsonLd from '../../components/JsonLd.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../../lib/seo/breadcrumb';
import { useTranslations } from '../../i18n/ui';
import { CONTACT_SUJET_DEFAULT, resolveContactPreset } from '../../lib/contact/presets';
import { getLocaleData } from '../../i18n/locale-data';

/**
 * Pages génériques (collection `pages`, 2026-08-11) — une route statique par
 * entrée de src/content/pages/<locale>/<slug>.json, rendue depuis son tableau
 * `sections`. RÉPLIQUE FIDÈLE de la route services
 * (src/pages/[lang]/services/[...slug].astro) SANS le préfixe d'URL : la
 * collection porte les pages de PREMIER NIVEAU (/decouvrir, /expertises,
 * /produits, /secteurs, /tarification, /centre-de-confiance, pages légales…).
 *
 * ROUTE ATTRAPE-TOUT ([...slug]) : Astro donne priorité aux routes plus
 * spécifiques (index, contact, services/[...slug],
 * ressources/*, campagnes/*, portail/*…) — le catalogue /solutions est une
 * page générale depuis le 2026-09-17 (section solutions-catalogue) — cette route ne génère QUE les
 * chemins des entrées de la collection, elle n'attrape rien d'autre en build
 * statique. Tout ce qui est load-bearing dans la route services l'est ici
 * aussi : variable LITTÉRALE `frontmatter`, seam `enrich` (formulaires liés +
 * jetons {{page.*}} + ressources liées), build-gate formId, altLocalePath par
 * fichier homonyme.
 */
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const formEntries = await getCollection('forms');

  const paths = [];
  for (const page of pages) {
    const seg = page.id.split('/')[0];
    const lang: Locale = isLocale(seg) ? seg : defaultLocale;
    // Chemin de FICHIER (clé d'appariement FR/EN) vs slug d'URL : `data.slug`
    // le surcharge (même logique que services/blog).
    const filePath = page.id.slice(page.id.indexOf('/') + 1);
    const slug = page.data.slug || filePath;
    const other = otherLocale[lang];

    const counterpart = pages.find((p) => p.id === `${other}/${filePath}`);
    const altLocalePath = counterpart
      ? localizePath(`/${counterpart.data.slug || filePath}/`, other)
      : localizePath('/', other);

    // Carte formId → définition pour la langue + garde-fou build (patron
    // services/campagnes : un formId introuvable ÉCHOUE le build en nommant
    // la page et le fichier attendu).
    const resolvedForms = Object.fromEntries(
      formEntries
        .filter((entry) => entry.id.startsWith(`${lang}/`))
        .map((entry) => [entry.id.slice(lang.length + 1), entry.data]),
    );
    for (const section of page.data.sections) {
      if (section.type === 'form' && section.formId && !resolvedForms[section.formId]) {
        throw new Error(
          `[pages] ${page.id} : formId « ${section.formId} » introuvable — attendu src/data/forms/${lang}/${section.formId}.json (collection Formulaires)`,
        );
      }
    }

    const enrich: Record<string, Record<string, unknown>> = {};

    // Ressources liées — patron exact de la route services (une seule section
    // par page, garde-fou build identique).
    const relatedSections = page.data.sections.filter((s) => s.type === 'related-posts');
    if (relatedSections.length > 1) {
      throw new Error(
        `[pages] ${page.id} : ${relatedSections.length} sections « ressources liées » — une seule par page est supportée (enrich est indexé par type : les mêmes cartes seraient injectées partout). En retirer.`,
      );
    }
    const relatedSection = relatedSections[0];
    if (relatedSection && 'tags' in relatedSection) {
      const wanted = relatedSection.tags.map((t) => t.toLowerCase());
      const posts = (await getPostsByLocale(lang))
        .filter((post) =>
          [...post.data.tags, ...post.data.topics].some((t) => wanted.includes(t.toLowerCase())),
        )
        .slice(0, 3);
      const dateFmt = new Intl.DateTimeFormat(htmlLang[lang], {
        dateStyle: 'long',
        timeZone: 'UTC',
      });
      const cards = await Promise.all(
        posts.map(async (post) => {
          return {
            href: localizePath(`/ressources/${postUrlSlug(post)}`, lang),
            title: post.data.title,
            excerpt: post.data.excerpt,
            tags: post.data.tags,
            dateISO: post.data.date.toISOString(),
            dateLabel: dateFmt.format(post.data.date),
            img: { src: post.data.coverImage ?? '' },
          };
        }),
      );
      enrich['related-posts'] = { cards };
    }

    // Catalogue de solutions (2026-09-17) — ex-route fixe solutions.astro
    // convertie en section de page générale. Les fiches viennent de la
    // collection `solutions` (tri `order`, vedette = première `featured`),
    // liens localisés ; un lien /contact transporte `?sujet=` (libellé de la
    // langue de la clé « solution », src/lib/contact/presets.ts — la page
    // contact ignore un sujet inconnu, tolérant), `?expertise=` (2026-09-18 :
    // le champ OBLIGATOIRE « Service » restait vide — clé `contactService` de
    // la FICHE, repli sur celle de la PAGE du catalogue) et `?produit=` (nom
    // de la solution). Les libellés passent par resolveContactPreset : une
    // option renommée au CMS → paramètre omis, jamais de build rouge. Une
    // seule section par page (enrich indexé par type) ; le renderer partagé
    // casse le build si la section est posée ailleurs.
    const catalogueSections = page.data.sections.filter((s) => s.type === 'solutions-catalogue');
    if (catalogueSections.length > 1) {
      throw new Error(
        `[pages] ${page.id} : ${catalogueSections.length} sections « catalogue de solutions » — une seule par page est supportée (enrich est indexé par type : les mêmes fiches seraient injectées partout). En retirer.`,
      );
    }
    if (catalogueSections.length === 1) {
      const contactOptions = await getLocaleData('contact', lang);
      const contactHref = (
        href: string,
        productTitle: string,
        serviceKey: (typeof page.data)['contactService'],
      ): string => {
        if (!href) return '';
        const base = localizePath(href, lang);
        if (!/^\/contact\/?$/.test(href)) return base;
        const preset = resolveContactPreset(
          lang,
          { sujet: 'solution', service: serviceKey || page.data.contactService },
          contactOptions,
        );
        const params = new URLSearchParams();
        if (preset.sujet) params.set('sujet', preset.sujet);
        if (preset.service) params.set('expertise', preset.service);
        params.set('produit', productTitle);
        return `${base}?${params.toString()}`;
      };
      const solutionEntries = (await getCollection('solutions'))
        .filter((entry) => entry.id.startsWith(`${lang}/`))
        .sort((a, b) => a.data.order - b.data.order);
      // « Découvrir » mène à la FICHE (lot L11, 2026-09-23) dès que l'entrée
      // porte des `sections` — c'est ce qui fait d'elle une page. `href` reste
      // une SURCHARGE : rempli, il l'emporte (ex. `o-bureau`, dont la page de
      // service est plus riche que sa fiche). Sans fiche ET sans `href`, le
      // lien reste masqué, comme avant : c'est l'état des 9 cartes EN, dont la
      // traduction est un travail de contenu — elles gardent leur `/contact`.
      const ficheHref = (entry: (typeof solutionEntries)[number]) => {
        const fichier = entry.id.slice(entry.id.indexOf('/') + 1);
        return localizePath(`/solutions/${entry.data.slug || fichier}/`, lang);
      };
      const toCard = (entry: (typeof solutionEntries)[number]) => ({
        title: entry.data.title,
        description: entry.data.description,
        image: entry.data.image,
        sector: entry.data.sector,
        solutionType: entry.data.solutionType,
        href: entry.data.href
          ? contactHref(entry.data.href, entry.data.title, entry.data.contactService)
          : entry.data.sections.length > 0
            ? ficheHref(entry)
            : '',
        docHref: entry.data.docHref ? localizePath(entry.data.docHref, lang) : '',
      });
      const featuredEntry = solutionEntries.find((entry) => entry.data.featured);
      enrich['solutions-catalogue'] = {
        featured: featuredEntry ? toCard(featuredEntry) : null,
        cards: solutionEntries.filter((entry) => entry !== featuredEntry).map(toCard),
      };
    }

    enrich.form = {
      resolvedForms,
      pageContext: {
        titre: page.data.title,
        chemin: `/${lang}/${slug}/`,
        slug,
        langue: lang,
      },
    };

    // `frontmatter` est LOAD-BEARING pour l'édition live CloudCannon — voir
    // src/pages/[lang]/campagnes/[slug].astro:43-50. Ne pas renommer.
    paths.push({
      params: { lang, slug },
      props: { page, lang, altLocalePath, frontmatter: page.data, enrich },
    });
  }
  return paths;
}

const { page, lang, altLocalePath, frontmatter, enrich } = Astro.props;

// Fil d'Ariane (2026-08-17) — le MÊME tableau alimente le fil VISIBLE
// (Breadcrumbs.astro) et le balisage BreadcrumbList (P-12). Collection plate :
// Accueil → page courante, pas de niveau intermédiaire.
const crumbs = [
  { name: useTranslations(lang).article.breadcrumbHome, path: localizePath('/', lang) },
  { name: page.data.title },
];
const crumbsSchema = breadcrumbSchema(crumbs, Astro.site!);

// Préremplissage Contact — le repli `|| CONTACT_SUJET_DEFAULT` est ALIGNÉ sur
// la route des services (2026-09-22, lot L-prefill) : il manquait ici, et les
// 9 pages générales sur 11 qui n'ont pas de `contactSujet` au CMS envoyaient
// leurs 18 CTA sur deux listes obligatoires VIDES (constaté sur Secteurs).
// Pas de repli de SERVICE côté route : une page générale n'a pas de famille de
// services à hériter (celles des services la tirent de leur chemin de fichier)
// — resolveContactPreset retombe sur « Autre », et sur « Ressources humaines »
// quand le sujet est « carrière » (SUJET_SERVICE_FALLBACK).
const contactPreset = {
  sujet: page.data.contactSujet || CONTACT_SUJET_DEFAULT,
  service: page.data.contactService,
};
---

<BaseLayout
  lang={lang}
  title={page.data.seoTitle || page.data.title}
  description={page.data.description}
  noindex={page.data.noindex}
  altLocalePath={altLocalePath}
  contentType="Page"
  contactPreset={contactPreset}
>
  <JsonLd slot="head" schema={crumbsSchema} />
  <Breadcrumbs lang={lang} items={crumbs} />
  <Page bookshop:live contentBlocks={frontmatter.sections} enrich={enrich} seoH1={frontmatter.seoH1} />
</BaseLayout>
