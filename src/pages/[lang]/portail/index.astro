---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortalLogin from '../../../components/PortalLogin.astro';
import { type Locale, localePaths, localizePath, otherLocale } from '../../../i18n/config';

/**
 * Client-portal login entry, localized: /fr/portail and /en/portail.
 *
 * 2026-08-18 — la MAQUETTE MOCK du portail est RETIRÉE (décision user) : plus
 * de tableau de bord, plus de routes /auth/*, plus de middleware ni de
 * session. Seule cette page de connexion (VISUELLE, bouton désactivé)
 * subsiste — elle est désormais PRÉRENDUE comme le reste du site. Le plan de
 * l'implémentation réelle (Entra ID + Dataverse) reste docs/portail-auth.md ;
 * l'ancien prototype OIDC/PKCE-shaped vit dans l'historique git.
 */
export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Locale };

const title = lang === 'fr' ? 'Mon portail' : 'My portal';
const description =
  lang === 'fr'
    ? 'Connectez-vous à votre portail client Victrix pour accéder à vos contrats, services et documents.'
    : 'Sign in to your Victrix client portal to access your contracts, services and documents.';
---

{/* noindex : le portail reste hors des moteurs et hors de la recherche
    interne Pagefind (le data-pagefind-body de BaseLayout suit !noindex). */}
<BaseLayout
  lang={lang}
  altLocalePath={localizePath('/portail', otherLocale[lang])}
  title={title}
  description={description}
  noindex
>
  <PortalLogin lang={lang} />
</BaseLayout>
