---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { type Locale, localePaths } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getPostsByLocale, filterPublished, blogCategories } from '../../../i18n/blog';

export const getStaticPaths = localePaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

// Drafts never reach this listing on the public build; the STATIC_ONLY
// (CloudCannon editing) build keeps them so editors can preview. Belt and
// braces: getPostsByLocale already applies filterPublished internally (the
// homepage's latest-articles strip relies on that), the explicit pass here
// keeps this page's draft policy self-evident and survives a future
// refactor of the shared helper.
const posts = filterPublished(await getPostsByLocale(lang));

// Onglets de filtre par catégorie (parité victrix.ca) — MÊME source que le
// méga-menu Ressources du header (blogCategories) : les étiquettes réelles
// des articles. Le filtre est client (page statique) : les cartes portent
// leurs étiquettes en data-tags, le script masque les autres ; `?categorie=`
// permet un lien direct filtré (c'est ce que ciblent les liens du méga-menu).
const categories = blogCategories(posts);
---

<BaseLayout lang={lang} title={t.blog.title} description={t.blog.intro}>
  <div class="container blog">
    <header class="blog__head">
      <p class="eyebrow">{t.blog.eyebrow}</p>
      <h1>{t.blog.title}</h1>
      <p class="blog__intro">{t.blog.intro}</p>
    </header>

    {
      categories.length > 1 && (
        <div class="blog__filters" role="group" aria-label={t.blog.filterAria} data-blog-filters>
          <button type="button" class="blog__filter is-active" data-filter="" aria-pressed="true">
            {t.blog.filterAll}
          </button>
          {categories.map((cat) => (
            <button type="button" class="blog__filter" data-filter={cat} aria-pressed="false">
              {cat}
            </button>
          ))}
        </div>
      )
    }

    <ul role="list" class="blog__grid" data-blog-grid>
      {
        posts.map((post) => (
          <li data-tags={post.data.tags.join('|')}>
            <BlogCard post={post} lang={lang} headingLevel="h2" />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<script>
  // Filtre par catégorie — s'exécute au chargement ET après chaque navigation
  // ClientRouter (astro:page-load). `?categorie=` est lu à l'arrivée (liens du
  // méga-menu Ressources) et maintenu à jour au clic (lien partageable).
  document.addEventListener('astro:page-load', () => {
    const group = document.querySelector<HTMLElement>('[data-blog-filters]');
    const grid = document.querySelector<HTMLElement>('[data-blog-grid]');
    if (!group || !grid) return;
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));

    const apply = (cat: string) => {
      buttons.forEach((b) => {
        const active = (b.dataset.filter ?? '') === cat;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      grid.querySelectorAll<HTMLLIElement>('li[data-tags]').forEach((li) => {
        const tags = (li.dataset.tags ?? '').split('|');
        li.hidden = cat !== '' && !tags.includes(cat);
      });
      const url = new URL(window.location.href);
      if (cat) url.searchParams.set('categorie', cat);
      else url.searchParams.delete('categorie');
      history.replaceState(null, '', url);
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? '')));

    const initial = new URL(window.location.href).searchParams.get('categorie') ?? '';
    // Une catégorie inconnue dans l'URL (article retiré, faute de frappe)
    // retombe sur « Tous » — jamais une grille vide inexpliquée.
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  });
</script>

<style>
  .blog {
    padding-block: var(--space-8) var(--space-9);
  }
  .blog__head {
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }
  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-200);
  }
  .blog__intro {
    margin-top: var(--space-4);
    font-size: var(--fs-400);
    color: var(--color-text-muted);
  }

  /* ---------- Onglets de filtre (parité victrix.ca) ---------- */
  .blog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .blog__filter {
    appearance: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: var(--space-2) var(--space-1) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .blog__filter:hover {
    color: var(--color-accent-blue);
  }
  .blog__filter.is-active {
    color: var(--color-accent-blue);
    font-weight: var(--fw-semibold);
    border-bottom-color: var(--color-accent-blue);
  }

  .blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin: 0;
  }
  @media (min-width: 640px) {
    .blog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .blog__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
