---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { defaultLocale, otherLocale, htmlLang, localizePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import {
  postLocale,
  postUrlSlug,
  findCounterpart,
  filterPublished,
  getPostsByLocale,
} from '../../../i18n/blog';
import { breadcrumbSchema } from '../../../lib/seo/breadcrumb';

export async function getStaticPaths() {
  // Drafts get NO route on the public build; the STATIC_ONLY (CloudCannon
  // editing) build keeps them so editors can preview an unpublished article.
  // Filtering the WHOLE list before mapping also keeps findCounterpart() from
  // pairing with a draft translation — its language switch falls back to the
  // other locale's Ressources index until the translation is published.
  const posts = filterPublished(await getCollection('blog'));
  return posts.map((post) => {
    const lang = postLocale(post) ?? defaultLocale;
    const other = otherLocale[lang];
    // Language switch / hreflang target: the translation's own localized URL.
    // EN slugs differ from FR now, so we can't just swap the path prefix.
    // Fall back to the other locale's Ressources index if there's no counterpart.
    // Keep the trailing slash so the alternate points at the counterpart's
    // canonical form (the no-slash URL 308-redirects on Cloudflare Pages).
    const counterpart = findCounterpart(post, posts);
    const altLocalePath = localizePath(
      counterpart ? `/ressources/${postUrlSlug(counterpart)}/` : '/ressources/',
      other,
    );
    return { params: { lang, slug: postUrlSlug(post) }, props: { post, lang, altLocalePath } };
  });
}

const { post, lang, altLocalePath } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);

// Format the calendar date in the page locale, in UTC (so 2026-05-28 doesn't
// roll back a day in timezones behind UTC).
const dateFmt = new Intl.DateTimeFormat(htmlLang[lang], { dateStyle: 'long', timeZone: 'UTC' });

// Couverture = chemin public servi tel quel (contenu migré de WordPress —
// voir le schéma blog). Pas de dérivé astro:assets : og:image et JSON-LD
// pointent l'original en URL absolue; sans couverture, BaseLayout retombe
// sur son image OG par défaut.
const coverUrl = post.data.coverImage
  ? new URL(post.data.coverImage, Astro.site).href
  : undefined;

const ressourcesHref = localizePath('/ressources', lang);

// Colonne latérale « Nos derniers articles » (parité victrix.ca) : les 2 plus
// récents, article courant exclu.
const latestPosts = (await getPostsByLocale(lang)).filter((p) => p.id !== post.id).slice(0, 2);

// BlogPosting JSON-LD (via the frozen JsonLd contract — src/components/
// JsonLd.astro). Search engines require ABSOLUTE URLs in structured data,
// hence new URL(…, Astro.site): the image is the same 1200×630 derivative as
// og:image above. Author and publisher are both the Organization — this blog
// has no per-author bylines. This block is the one deliberate addition to the
// public HTML of this page (JSON-LD is allowed by the workstream brief).
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  inLanguage: htmlLang[lang],
  image: coverUrl ?? new URL('/og-image.png', Astro.site).href,
  author: { '@type': 'Organization', name: 'Les Solutions Victrix' },
  publisher: { '@type': 'Organization', name: 'Les Solutions Victrix' },
};

// BreadcrumbList JSON-LD (P-12) — reflet machine du fil d'Ariane visible
// ci-dessous (Accueil › Ressources › article). Même canal JsonLd que
// BlogPosting ; URLs absolues, dernier élément sans `item`.
const crumbsSchema = breadcrumbSchema(
  [
    { name: t.article.breadcrumbHome, path: localizePath('/', lang) },
    { name: t.blog.eyebrow, path: `${ressourcesHref}/` },
    { name: post.data.title },
  ],
  Astro.site!,
);

// Absolute canonical URL for the share buttons — keep the trailing slash so it
// matches og:url (the no-slash form 308-redirects on Cloudflare Pages).
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareLinks = [
  {
    name: 'LinkedIn',
    label: t.article.shareLinkedin,
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`,
  },
  {
    name: 'X',
    label: t.article.shareX,
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.data.title)}`,
  },
  {
    name: 'Facebook',
    label: t.article.shareFacebook,
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
  },
];
---

<BaseLayout
  lang={lang}
  title={post.data.seoTitle || post.data.title}
  description={post.data.excerpt}
  image={post.data.coverImage}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  tags={post.data.tags}
  altLocalePath={altLocalePath}
  noindex={post.data.noindex}
>
  <JsonLd slot="head" schema={articleSchema} />
  <JsonLd slot="head" schema={crumbsSchema} />
  <article class="article">
    <div class="container article__inner">
      {/* Fil d'Ariane (parité victrix.ca) — remplace l'ancien lien retour. */}
      <nav class="article__crumbs" aria-label={t.article.breadcrumbAria}>
        <a href={localizePath('/', lang)}>{t.article.breadcrumbHome}</a>
        <span aria-hidden="true">›</span>
        <a href={ressourcesHref}>{t.blog.eyebrow}</a>
        <span aria-hidden="true">›</span>
        <span class="article__crumb-current" aria-current="page">{post.data.title}</span>
      </nav>

      <div class="article__layout">
        <div class="article__main">
      <header class="article__head">
        {
          post.data.tags.length > 0 && (
            <ul role="list" class="article__tags">
              {post.data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )
        }

        <h1>{post.data.title}</h1>

        <p class="article__meta">
          {/* data-pagefind-meta/sort : expose la date de l'article à la
              recherche interne (P-06) — affichée sur les résultats et
              disponible comme tri Pagefind. */}
          <time
            datetime={post.data.date.toISOString()}
            data-pagefind-meta="date[datetime]"
            data-pagefind-sort="date[datetime]"
          >
            {dateFmt.format(post.data.date)}
          </time>
        </p>
      </header>

      {
        post.data.coverImage && (
          <img class="article__cover" src={post.data.coverImage} alt="" loading="eager" />
        )
      }

      <div class="prose article__body">
        <Content />
      </div>

      <footer class="article__foot">
        <div class="share">
          <span class="share__label">{t.article.shareLabel}</span>
          <ul role="list" class="share__list">
            {
              shareLinks.map((l) => (
                <li>
                  <a
                    class="share__link"
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={l.label}
                  >
                    {l.name === 'LinkedIn' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M6.94 7.5a1.94 1.94 0 1 1 0-3.88 1.94 1.94 0 0 1 0 3.88zM5.2 9h3.5v11H5.2V9zm5.6 0h3.35v1.5h.05c.47-.85 1.6-1.75 3.3-1.75 3.53 0 4.18 2.2 4.18 5.05V20h-3.5v-4.9c0-1.17-.02-2.67-1.7-2.67-1.7 0-1.96 1.28-1.96 2.59V20h-3.5V9z" />
                      </svg>
                    )}
                    {l.name === 'X' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
                      </svg>
                    )}
                    {l.name === 'Facebook' && (
                      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M14 9h2.5V6H14c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3h-3V9.5C13.5 9.2 13.7 9 14 9z" />
                      </svg>
                    )}
                  </a>
                </li>
              ))
            }
            <li>
              <button class="share__link" type="button" data-copy-link aria-label={t.article.copyLink}>
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h3v-2h-3a5.1 5.1 0 0 0 0 10.2h3v-2h-3A3.1 3.1 0 0 1 3.9 12Zm4.1 1h8v-2H8v2Zm9-6h-3v2h3a3.1 3.1 0 0 1 0 6.2h-3v2h3a5.1 5.1 0 0 0 0-10.2Z" />
                </svg>
              </button>
            </li>
          </ul>
          <span class="share__copied" data-copy-status role="status" aria-live="polite" hidden>
            {t.article.copied}
          </span>
        </div>

        <a class="btn btn--outline" href={ressourcesHref}>{t.article.backBtn}</a>
      </footer>
        </div>

        {
          latestPosts.length > 0 && (
            <aside class="article__aside" aria-label={t.article.latestTitle} data-pagefind-ignore>
              <h2 class="article__aside-title">{t.article.latestTitle}</h2>
              {latestPosts.map((p) => {
                const href = localizePath(`/ressources/${postUrlSlug(p)}/`, lang);
                return (
                  <article class="aside-card">
                    {p.data.coverImage && (
                      <a class="aside-card__media" href={href} tabindex="-1" aria-hidden="true">
                        <img src={p.data.coverImage} alt="" loading="lazy" decoding="async" />
                      </a>
                    )}
                    <div class="aside-card__body">
                      <h3 class="aside-card__title">
                        <a href={href}>{p.data.title}</a>
                      </h3>
                      <p class="aside-card__date">
                        <time datetime={p.data.date.toISOString()}>{dateFmt.format(p.data.date)}</time>
                      </p>
                      <a class="btn btn--outline aside-card__btn" href={href}>
                        {t.article.readMore}
                      </a>
                    </div>
                  </article>
                );
              })}
            </aside>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

{/* data-astro-rerun: inline scripts with identical content are otherwise
    skipped by the client router — without it, revisiting the same article
    after navigating away would leave the copy button unbound. */}
<script is:inline data-astro-rerun define:vars={{ shareUrl }}>
  const btn = document.querySelector('[data-copy-link]');
  const status = document.querySelector('[data-copy-status]');
  if (btn && status) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
        status.hidden = false;
        setTimeout(() => {
          status.hidden = true;
        }, 2000);
      } catch {
        /* clipboard unavailable — ignore */
      }
    });
  }
</script>

<style>
  .article {
    padding-block: var(--space-7) var(--space-9);
  }
  /* Deux colonnes dès 1100px : contenu (≤ 800px, largeur de lecture
     inchangée) + colonne « derniers articles » (parité victrix.ca). */
  .article__inner {
    max-width: var(--container-max);
  }
  .article__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    justify-content: center;
  }
  .article__main {
    max-width: 800px;
    width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 1100px) {
    .article__layout {
      grid-template-columns: minmax(0, 800px) 300px;
      justify-content: space-between;
    }
    .article__main {
      margin-inline: 0;
    }
  }
  .article__head {
    margin-bottom: var(--space-6);
  }

  /* Fil d'Ariane */
  .article__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: var(--fs-100);
    color: var(--color-text-muted);
  }
  .article__crumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .article__crumbs a:hover {
    color: var(--color-accent-blue);
  }
  .article__crumb-current {
    color: var(--color-navy);
    font-weight: var(--fw-medium);
    max-width: 48ch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Colonne « Nos derniers articles » */
  .article__aside {
    display: grid;
    gap: var(--space-5);
    align-self: start;
  }
  @media (min-width: 1100px) {
    .article__aside {
      position: sticky;
      top: calc(76px + var(--space-5));
    }
  }
  .article__aside-title {
    font-size: var(--fs-500);
    color: var(--color-navy);
    margin: 0;
  }
  .aside-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg);
  }
  .aside-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-surface);
  }
  .aside-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .aside-card__body {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .aside-card__title {
    font-size: var(--fs-300);
    line-height: var(--lh-snug);
    margin: 0;
  }
  .aside-card__title a {
    color: var(--color-navy);
    text-decoration: none;
  }
  .aside-card__title a:hover {
    color: var(--color-accent-blue);
  }
  .aside-card__date {
    margin: 0;
    font-size: var(--fs-100);
    color: var(--color-text-muted);
  }
  .aside-card__btn {
    justify-self: start;
    font-size: var(--fs-200);
  }

  /* ---------- Mise en forme du corps (parité victrix.ca) ----------
     Le corps vient du Markdown migré (rendu <Content /> global) — :global()
     obligatoire pour styler au travers de la frontière scoped. */
  .article__body :global(h2) {
    color: var(--color-navy);
    position: relative;
    padding-bottom: var(--space-3);
  }
  .article__body :global(h2)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 72px;
    height: 3px;
    background-color: var(--color-accent-green);
  }
  .article__body :global(h3) {
    color: var(--color-navy);
  }
  /* CTA : lien autonome marqué au câblage (wire-blog.mjs) → bouton marine,
     comme les appels à l'action des articles victrix.ca. */
  .article__body :global(.article-cta) {
    display: inline-block;
    background-color: var(--color-navy);
    color: var(--color-white);
    text-decoration: none;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-200);
    padding: 0.7em 1.5em;
    border-radius: var(--radius-pill);
  }
  .article__body :global(.article-cta):hover {
    background-color: var(--color-accent-blue);
    color: var(--color-white);
  }
  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }
  .tag {
    font-size: var(--fs-100);
    font-weight: var(--fw-semibold);
    color: var(--color-navy);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.2em 0.7em;
  }
  .article__head h1 {
    max-width: 22ch;
  }
  .article__meta {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--fs-200);
  }
  .article__cover {
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-7);
  }
  .article__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  /* Share row */
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .share__label {
    font-weight: var(--fw-semibold);
    color: var(--color-navy);
    font-size: var(--fs-200);
  }
  .share__list {
    display: flex;
    gap: var(--space-2);
    margin: 0;
  }
  .share__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg);
    color: var(--color-navy);
    cursor: pointer;
  }
  .share__link:hover {
    background-color: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-text-invert);
  }
  .share__copied {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    color: var(--color-navy);
  }
  .share__copied[hidden] {
    display: none;
  }
</style>
