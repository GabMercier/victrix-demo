---
/**
 * PAGE LABORATOIRE — PORT COMPLET DE PageExpertise.html (à purger avant la
 * mise en prod, même régime que /fr/design-lab). REVALIDATION DU PIPELINE sur
 * la LIVRAISON FINALE (audit-tokens-figma.md §5) : le body de
 * docs/design/Export HTML/PageExpertise.html est repris VERBATIM et rendu par
 * le pipeline v4 du repo (design-lab-refonte.css + theme-refonte.css,
 * référence exports actée 2026-08-04), à ces adaptations près (recette §5) :
 *  1. Play CDN + config inline + liens Google Fonts retirés → pipeline v4 ;
 *  2. images : 6 tuiles → public/images/design-lab/refonte/pageexpertise-0{1..6}.jpg
 *     (rapatriées) ; fond du HÉROS (URL d'origine MORTE — Annexe A des
 *     signalements) → STAND-IN local pageexpertise-04.jpg, à remplacer au
 *     ré-export du .fig ; capture Ø STUDIO (MORTE aussi) → bloc placeholder
 *     explicite, pas de fausse image ;
 *  3. data-alt → alt ; les href="#" factices de la maquette sont CONSERVÉS
 *     (fidélité — même choix que /fr/design-lab, dérogation eslint
 *     anchor-is-valid sur design-lab/*) ;
 *  4. artefacts d'export corrigés : `viewbox` → `viewBox` (SVG du CTA),
 *     `md:row` → `md:flex-row` (barre basse du footer) ;
 *  5. script scroll du header (ombre + h-20→h-16) conservé en is:inline
 *     (comportement réel de la maquette, pas décoratif) ;
 *  6. icônes FILL 1 des cartes « Approche » : rendues par le sous-ensemble
 *     Refonte à axe FILL variable (generate-icon-subset.mjs).
 * CONSERVÉ TEL QUEL et SIGNALÉ (arbitrages-design-a-trancher.md §2.d) :
 * l'item de nav marqué actif est « Secteurs » (artefact d'export sur une page
 * Expertise). Hors sitemap ('/design-lab'), hors Pagefind, hors CloudCannon,
 * noindex, FR seulement.
 */
import '../../../styles/design-lab-refonte.css';

export function getStaticPaths() {
  // Page laboratoire monolingue — pas de variante /en.
  return [{ params: { lang: 'fr' } }];
}
---

<!doctype html>
<html class="light" lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design lab — PageExpertise (export final, revalidation pipeline)</title>
  </head>
  <body class="bg-surface text-on-surface">
    <!-- Header (TopNavBar) — export L22-40 -->
    <header class="fixed top-0 w-full z-50 bg-surface border-b border-solid border-outline-variant h-20 flex items-center transition-all">
      <nav class="max-w-container-max mx-auto px-margin-x w-full flex justify-between items-center">
        <div class="text-headline-md font-headline-md font-extrabold text-primary flex items-center gap-2">VICTRIX</div>
        <div class="hidden md:flex items-center gap-stack-lg">
          <a class="font-body-md text-on-surface-variant hover:text-primary transition-colors" href="#">Expertises</a>
          <div class="text-primary font-bold border-b-2 border-solid border-primary pb-1 font-body-md">Secteurs</div>
          <a class="font-body-md text-on-surface-variant hover:text-primary transition-colors" href="#">Carrières</a>
          <a class="font-body-md text-on-surface-variant hover:text-primary transition-colors" href="#">À propos</a>
          <a class="font-body-md text-on-surface-variant hover:text-primary transition-colors" href="#">Blogue</a>
          <a class="font-body-md text-on-surface-variant hover:text-primary transition-colors" href="#">Contact</a>
        </div>
        <button class="bg-primary text-on-primary px-6 py-3 rounded hover:bg-primary-container transition-all font-button text-button" type="button">
          Demander une consultation
        </button>
      </nav>
    </header>
    <main class="pt-20">
      <!-- Hero Section — export L42-68. Fond d'origine MORT → stand-in local. -->
      <section class="relative min-h-[716px] flex items-center overflow-hidden">
        <div class="absolute inset-0 z-0">
          <div
            class="w-full h-full bg-cover bg-center scale-105"
            style="background-image: url('/images/design-lab/refonte/pageexpertise-04.jpg');"
          >
          </div>
          <div class="absolute inset-0 bg-on-primary-fixed/40"></div>
        </div>
        <div class="relative z-10 max-w-container-max mx-auto px-margin-x py-24">
          <div class="max-w-3xl">
            <span class="font-label-caps text-label-caps text-primary-fixed uppercase tracking-widest mb-4 block">Productivité & Stratégie</span>
            <h1 class="font-display text-display text-white mb-6 leading-tight m-0">
              Améliorer la <span class="text-primary-fixed-dim">Productivité</span> en entreprise
            </h1>
            <p class="font-body-lg text-body-lg text-surface-container-low mb-10 max-w-2xl m-0">
              À la recherche d'une idée pour améliorer la productivité de votre entreprise? Avec des années d'expérience,
              Victrix vous propose une approche humaine et orientée client qui considère vos besoins d'affaires et se
              concentre sur vos utilisateurs.
            </p>
            <div class="flex flex-wrap gap-4">
              <button class="bg-primary text-white font-button text-button px-8 py-4 rounded hover:bg-primary-container transition-all flex items-center gap-2 shadow-lg" type="button">
                Rencontrons-nous
                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
              </button>
              <button class="bg-white/10 backdrop-blur-md border border-solid border-white/20 text-white font-button text-button px-8 py-4 rounded hover:bg-white/20 transition-all" type="button">
                Découvrir nos solutions
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Approche Section — export L69-102 (icônes FILL 1) -->
      <section class="py-section-gap bg-surface-container-lowest">
        <div class="max-w-container-max mx-auto px-margin-x">
          <div class="text-center mb-16">
            <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4 m-0">Notre approche humaine</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mx-auto m-0">
              Nos spécialistes utilisent une approche proactive pour vous aider à tirer le maximum des heures
              travaillées en conciliant les réalités des trois grands acteurs.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 bg-white border border-solid border-outline-variant rounded hover:shadow-xl transition-shadow duration-300">
              <div class="w-12 h-12 bg-primary-fixed rounded flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-primary" style='font-variation-settings: "FILL" 1;'>corporate_fare</span>
              </div>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4 m-0">L'ORGANISATION</h3>
              <p class="font-body-md text-on-surface-variant m-0">
                Votre vision, votre image, votre message. Nous alignons les outils technologiques sur vos objectifs
                stratégiques globaux.
              </p>
            </div>
            <div class="p-8 bg-white border border-solid border-outline-variant rounded hover:shadow-xl transition-shadow duration-300">
              <div class="w-12 h-12 bg-primary-fixed rounded flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-primary" style='font-variation-settings: "FILL" 1;'>person_apron</span>
              </div>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4 m-0">LE PORTEUR</h3>
              <p class="font-body-md text-on-surface-variant m-0">
                Ses responsabilités, ses capacités, son initiative. Nous valorisons l'humain qui déploie et maintient
                vos solutions.
              </p>
            </div>
            <div class="p-8 bg-white border border-solid border-outline-variant rounded hover:shadow-xl transition-shadow duration-300">
              <div class="w-12 h-12 bg-primary-fixed rounded flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-primary" style='font-variation-settings: "FILL" 1;'>groups</span>
              </div>
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4 m-0">LE DESTINATAIRE</h3>
              <p class="font-body-md text-on-surface-variant m-0">
                Ses outils, son appartenance, ses intérêts. Nous optimisons l'expérience utilisateur finale pour
                maximiser l'adoption.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Expertises Section (Bento Grid Style) — export L103-172 -->
      <section class="py-section-gap bg-surface">
        <div class="max-w-container-max mx-auto px-margin-x">
          <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
            <div class="max-w-2xl">
              <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest mb-2 block">Domaines d'expertise</span>
              <h2 class="font-headline-lg text-headline-lg text-on-surface m-0">Une vision 360° de votre productivité numérique</h2>
            </div>
            <div class="text-right">
              <p class="font-body-md text-on-surface-variant max-w-sm m-0">
                Des solutions idéales pour simplifier les tâches quotidiennes et bénéficier d'un gain de temps immédiat.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              [
                { img: 'pageexpertise-01.jpg', titre: 'Intranet Moderne' },
                { img: 'pageexpertise-02.jpg', titre: 'BI et Power BI' },
                { img: 'pageexpertise-03.jpg', titre: 'Collaboration' },
                { img: 'pageexpertise-04.jpg', titre: 'Infrastructure & Cloud' },
                { img: 'pageexpertise-05.jpg', titre: 'Mobilité' },
                { img: 'pageexpertise-06.jpg', titre: 'IA & Automatisation' },
              ].map((t) => (
                <div class="relative h-64 rounded-xl overflow-hidden group">
                  <img alt={t.titre} class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" src={`/images/design-lab/refonte/${t.img}`} />
                  <div class="absolute inset-0 bg-gradient-to-t from-on-primary-fixed/80 to-transparent" />
                  <div class="absolute bottom-0 left-0 p-6">
                    <h3 class="font-headline-md text-white text-[20px] m-0 mb-1">{t.titre}</h3>
                    <div class="w-8 h-1 bg-primary-fixed-dim" />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Technologies Section (marquee) — export L173-200, contenu doublé pour boucle sans couture -->
      <section class="py-12 bg-on-primary-fixed text-white overflow-hidden marquee-refonte">
        <div class="max-w-container-max mx-auto px-margin-x">
          <div class="flex items-center gap-stack-lg animate-[marquee_20s_linear_infinite] whitespace-nowrap w-max">
            {
              [false, true].map((clone) => (
                <div class="flex items-center gap-stack-lg" aria-hidden={clone || undefined}>
                  {['OneNote', 'Stream', 'Power BI', 'Teams', 'Sharepoint', 'PowerApps', 'PowerAutomate'].map((t) => (
                    <>
                      <span class="font-headline-md text-headline-md opacity-40 hover:opacity-100 transition-opacity cursor-default">{t}</span>
                      <span class="text-primary-fixed-dim">•</span>
                    </>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Outils Exclusifs Section — export L201-260 -->
      <section class="py-section-gap bg-surface-container-low">
        <div class="max-w-container-max mx-auto px-margin-x">
          <div class="mb-16">
            <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4 m-0">Nos solutions de productivité exclusives</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl m-0">
              Victrix développe ses propres applications pour répondre aux défis spécifiques du travail moderne.
            </p>
          </div>
          <div class="flex flex-col gap-12">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg items-center bg-white rounded-xl overflow-hidden border border-solid border-outline-variant shadow-sm">
              <div class="p-12">
                <div class="bg-primary-fixed text-primary px-3 py-1 rounded text-xs font-bold w-fit mb-4 uppercase">Exclusivité Victrix</div>
                <h3 class="font-headline-lg text-headline-lg text-on-surface mb-6 m-0">Ø Studio</h3>
                <p class="font-body-md text-on-surface-variant mb-8 m-0">
                  Propulsez-vous vers la Power Platform avec un accompagnement adapté à vos besoins. Le Ø Studio vous
                  offre rapidité de développement et gain en capacité de livraison afin de migrer vos applications ou
                  automatiser vos processus.
                </p>
                <a class="inline-flex items-center gap-2 text-primary font-bold hover:underline" href="#">
                  Élevez votre taux de productivité avec Ø Studio
                  <span class="material-symbols-outlined">arrow_forward</span>
                </a>
              </div>
              {/* Capture Ø Studio d'origine MORTE (Annexe A) — placeholder explicite, à remplacer au ré-export du .fig. */}
              <div class="h-full min-h-[400px] bg-surface-container-high flex flex-col items-center justify-center gap-3 text-on-surface-variant p-8 text-center">
                <span class="material-symbols-outlined text-[40px]">terminal</span>
                <p class="font-label-caps text-label-caps uppercase m-0">Visuel Ø Studio à ré-exporter du .fig</p>
                <p class="font-body-md text-body-md m-0 max-w-[24rem]">L'URL d'origine de la capture d'écran est morte côté Google (voir signalements, Annexe A).</p>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
              <div class="bg-white p-10 rounded-xl border border-solid border-outline-variant flex flex-col">
                <div class="w-12 h-12 bg-secondary-container rounded flex items-center justify-center mb-6">
                  <span class="material-symbols-outlined text-secondary">calendar_today</span>
                </div>
                <h3 class="font-headline-md text-headline-md mb-4 m-0">O bureau</h3>
                <p class="font-body-md text-on-surface-variant mb-8 m-0">
                  Simplifiez les réservations, améliorez la gestion et automatisez les rapports d'utilisation de vos
                  bureaux grâce à notre application de gestion de réservation facile à implémenter.
                </p>
                <a class="mt-auto inline-flex items-center gap-2 text-primary font-bold hover:underline" href="#">
                  Gérer la réservation efficacement
                  <span class="material-symbols-outlined">arrow_forward</span>
                </a>
              </div>
              <div class="bg-white p-10 rounded-xl border border-solid border-outline-variant flex flex-col">
                <div class="w-12 h-12 bg-secondary-container rounded flex items-center justify-center mb-6">
                  <span class="material-symbols-outlined text-secondary">hub</span>
                </div>
                <h3 class="font-headline-md text-headline-md mb-4 m-0">Plateforme employé</h3>
                <p class="font-body-md text-on-surface-variant mb-8 m-0">
                  Offrez à votre personnel ce qu'il y a de mieux en matière d'intranet. Augmentez la productivité au
                  travail en centralisant les outils et les connaissances.
                </p>
                <a class="mt-auto inline-flex items-center gap-2 text-primary font-bold hover:underline" href="#">
                  Déployer un intranet moderne
                  <span class="material-symbols-outlined">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section — export L261-284 (viewBox corrigé) -->
      <section class="py-section-gap">
        <div class="max-w-container-max mx-auto px-margin-x">
          <div class="bg-primary p-12 md:p-20 rounded-xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-1/2 h-full opacity-10 pointer-events-none">
              <svg class="w-full h-full" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                <circle cx="200" cy="200" fill="none" r="180" stroke="white" stroke-dasharray="10 10" stroke-width="2"></circle>
                <circle cx="200" cy="200" fill="none" r="140" stroke="white" stroke-width="1"></circle>
              </svg>
            </div>
            <div class="relative z-10 max-w-2xl">
              <h2 class="font-headline-lg text-headline-lg text-white mb-6 m-0">Prêt à faire évoluer votre organisation ?</h2>
              <p class="font-body-lg text-body-lg text-white/80 mb-10 m-0">
                Discutons de vos enjeux et découvrons comment Victrix peut vous aider à aller plus loin dans votre
                transformation numérique et l'amélioration de vos performances.
              </p>
              <button class="bg-white text-primary font-button text-button px-10 py-5 rounded hover:bg-surface-container-low transition-all shadow-xl" type="button">
                Réservez un créneau avec un expert
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer — export L285-343 (md:row → md:flex-row) -->
    <footer class="bg-surface-container-lowest border-t border-solid border-outline-variant py-section-gap">
      <div class="max-w-container-max mx-auto px-margin-x">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-stack-lg mb-12">
          <div class="col-span-1">
            <div class="text-headline-md font-headline-md font-extrabold text-primary mb-6">VICTRIX</div>
            <p class="font-body-md text-on-surface-variant mb-6 m-0">
              Conseil stratégique et solutions TI pour des opérations plus efficaces, sécurisées et évolutives. Leader
              en transformation numérique au Canada.
            </p>
            <div class="flex gap-4">
              <a class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
                <span class="material-symbols-outlined text-[20px]">share</span>
              </a>
              <a class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all" href="#">
                <span class="material-symbols-outlined text-[20px]">public</span>
              </a>
            </div>
          </div>
          {
            [
              {
                titre: 'Expertises',
                liens: ['Conseil stratégique', 'Infonuagique', 'Cybersécurité', 'Productivité', 'Intelligence artificielle', 'Services gérés'],
                actif: 'Productivité',
              },
              { titre: 'Solutions', liens: ['Ø Studio', 'SEVOC', 'Migration Azure', 'Modern Work', 'Office Booking'], actif: null },
              { titre: 'Liens Rapides', liens: ['Secteurs', 'Ressources', 'À propos', 'Carrières', 'Confidentialité'], actif: null },
            ].map((col) => (
              <div>
                <h4 class="font-label-caps text-label-caps mb-6 text-on-surface m-0">{col.titre}</h4>
                <ul class="space-y-4 m-0 p-0 list-none">
                  {col.liens.map((l) => (
                    <li>
                      <a class={l === col.actif ? 'font-body-md text-primary font-bold' : 'font-body-md text-on-surface-variant hover:text-primary transition-colors'} href="#">
                        {l}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="pt-8 border-t border-solid border-outline-variant flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
          <p class="font-body-md text-on-surface-variant text-sm m-0">© 2024 Victrix. Tous droits réservés. Expertise en conseil TI.</p>
          <div class="flex gap-6">
            <a class="font-body-md text-on-surface-variant text-sm hover:underline" href="#">Politique de confidentialité</a>
            <a class="font-body-md text-on-surface-variant text-sm hover:underline" href="#">Conditions d'utilisation</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Micro-interaction du header (ombre + hauteur au scroll) — export L344-358, conservée -->
    <script is:inline>
      window.addEventListener('scroll', () => {
        const header = document.querySelector('header');
        if (window.scrollY > 50) {
          header.classList.add('shadow-md');
          header.classList.remove('h-20');
          header.classList.add('h-16');
        } else {
          header.classList.remove('shadow-md');
          header.classList.add('h-20');
          header.classList.remove('h-16');
        }
      });
    </script>
  </body>
</html>
