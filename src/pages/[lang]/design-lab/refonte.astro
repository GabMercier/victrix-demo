---
/**
 * PAGE LABORATOIRE — REFONTE (à purger avant la mise en prod, même régime que
 * /fr/design-lab). Prototypes des SECTIONS SANS COMPOSANT EXISTANT relevées
 * dans les maquettes finales (docs/design/Export HTML/, analyse de réception
 * §3/§5.5), rendues par le pipeline v4 du repo avec le THÈME CANDIDAT
 * theme-refonte.css (RÉFÉRENCE ACTÉE 2026-08-04 : les exports HTML font foi —
 * écarts restants signalés dans docs/design/arbitrages-design-a-trancher.md).
 *
 * Markup repris des exports avec les adaptations de la recette d'audit §5 :
 *  1. Play CDN + config inline + Google Fonts retirés → design-lab-refonte.css ;
 *  2. images distantes → copies locales public/images/design-lab/refonte/
 *     (rapatriées par scripts/design/fetch-maquette-images.mjs) ;
 *  3. data-alt → alt, href="#" → liens réels ou <button> ;
 *  4. rayons rendus selon les CONFIGS DES EXPORTS (décision 2026-08-04) —
 *     rounded-full excepté, gardé ROND (artefact signalé) ;
 *  5. carte flottante « 24/7 » (Accueil) TRANSPOSÉE au système normatif des
 *     4 pages alignées (Accueil hors-norme, ré-export demandé) : text-display
 *     (pas display-lg/Manrope), border-outline-variant (pas border-subtle),
 *     chiffre en primary (pas secondary — les CTA des 4 pages sont primary) ;
 *  6. marquee : contenu doublé (boucle sans couture), gel au survol et sous
 *     prefers-reduced-motion (design-lab-refonte.css).
 * Hors sitemap (filtre '/design-lab' d'astro.config.mjs), hors Pagefind,
 * hors CloudCannon, noindex. FR seulement (même règle que design-lab).
 */
import '../../../styles/design-lab-refonte.css';

export function getStaticPaths() {
  // Page laboratoire monolingue — pas de variante /en.
  return [{ params: { lang: 'fr' } }];
}

const bento = [
  { img: 'pageexpertise-01.jpg', titre: 'Intranet Moderne' },
  { img: 'pageexpertise-02.jpg', titre: 'BI et Power BI' },
  { img: 'pageexpertise-03.jpg', titre: 'Collaboration' },
  { img: 'pageexpertise-04.jpg', titre: 'Infrastructure & Cloud' },
  { img: 'pageexpertise-05.jpg', titre: 'Mobilité' },
  { img: 'pageexpertise-06.jpg', titre: 'IA & Automatisation' },
];
const technos = ['OneNote', 'Stream', 'Power BI', 'Teams', 'Sharepoint', 'PowerApps', 'PowerAutomate'];
const realisations = [
  { icone: 'medical_services', titre: 'Santé', texte: 'Recherche documentaire intelligente pour le personnel clinique.' },
  { icone: 'support_agent', titre: 'Services', texte: 'Automatisation de la gestion des demandes de soutien technique.' },
  { icone: 'groups', titre: 'RH', texte: "Agent conversationnel pour l'onboarding et les questions employé." },
  { icone: 'gavel', titre: 'Juridique', texte: 'Automatisation intelligente de la gestion et analyse documentaire.' },
];
const bureaux = [
  { img: 'contact-01.jpg', ville: 'Québec', adresse: '330 Rue Saint-Vallier Est, #130<br>Québec (QC), G1K 9C5', tel: '418-780-8181', href: 'tel:418-780-8181' },
  { img: 'contact-02.jpg', ville: 'Montréal', adresse: '1100 Boul. René-Lévesque O, #1900<br>Montréal (QC), H3B 4N4', tel: '514-879-1919', href: 'tel:514-879-1919' },
  { img: 'contact-03.jpg', ville: 'Paris', adresse: '9-15 rue Rouget de Lisle<br>Issy-les-Moulineaux, 92130', tel: '+33 1 74 90 50 40', href: 'tel:+33174905040' },
];
const valeurs = [
  { icone: 'star', nom: 'Excellence' },
  { icone: 'groups', nom: 'Collaboration' },
  { icone: 'lightbulb', nom: 'Innovation' },
  { icone: 'handshake', nom: 'Engagement' },
  { icone: 'verified', nom: 'Intégrité' },
];
---

<!doctype html>
<html class="light" lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design lab — Refonte : prototypes des sections manquantes</title>
  </head>
  <body class="bg-surface text-on-surface">
    <header class="bg-surface-container-lowest border-b border-solid border-outline-variant sticky top-0 z-50">
      <div class="max-w-container-max mx-auto px-margin-x h-16 flex items-center justify-between">
        <p class="font-headline-md text-headline-md text-primary m-0">Design lab · Refonte</p>
        <nav class="flex items-center gap-stack-lg">
          <a class="text-body-md text-on-surface-variant hover:text-primary transition-colors" href="/fr/design-lab/">Ancien export</a>
          <a class="text-body-md text-on-surface-variant hover:text-primary transition-colors" href="/fr/design-lab/palettes/">Comparaison des palettes</a>
        </nav>
      </div>
    </header>

    <main class="max-w-container-max mx-auto px-margin-x py-stack-lg">
      <section class="py-stack-lg">
        <span class="font-label-caps text-label-caps text-primary uppercase block mb-stack-sm">Laboratoire · thème candidat theme-refonte.css</span>
        <h1 class="font-display text-display text-on-surface m-0 mb-stack-md">Sections des maquettes finales sans composant existant</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-[46rem] m-0">
          Chaque bloc reproduit un pattern des exports HTML finaux avec les tokens retenus. Référence actée
          (2026-08-04) : les exports font foi — les écarts restants sont signalés à l'équipe design
          (docs/design/arbitrages-design-a-trancher.md).
        </p>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">1 · Tuiles expertises (image + overlay navy)</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">PageExpertise.html · ⛔ gap — home-expertises ne couvre pas ce pattern · overlay = on-primary-fixed (usage des exports)</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            bento.map((t) => (
              <div class="relative h-64 rounded-xl overflow-hidden group">
                <img alt={t.titre} class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" src={`/images/design-lab/refonte/${t.img}`} />
                <div class="absolute inset-0 bg-gradient-to-t from-on-primary-fixed/80 to-transparent" />
                <div class="absolute bottom-0 left-0 p-6">
                  <h3 class="font-headline-md text-white text-[20px] m-0 mb-1">{t.titre}</h3>
                  <div class="w-8 h-1 bg-primary-fixed-dim" />
                </div>
              </div>
            ))
          }
        </div>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">2 · Bande technologies défilante</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">PageExpertise.html · ⛔ gap — logo-banner est statique · gel au survol + prefers-reduced-motion</span>
        </div>
        <div class="py-12 bg-on-primary-fixed text-white overflow-hidden rounded-lg marquee-refonte">
          <div class="flex items-center gap-stack-lg animate-[marquee_20s_linear_infinite] whitespace-nowrap w-max">
            {
              [false, true].map((clone) => (
                <div class="flex items-center gap-stack-lg" aria-hidden={clone || undefined}>
                  {technos.map((t) => (
                    <>
                      <span class="font-headline-md text-headline-md opacity-40 hover:opacity-100 transition-opacity cursor-default">{t}</span>
                      <span class="text-primary-fixed-dim">•</span>
                    </>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">3 · Réalisations (cartes icône)</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">PageSolution.html · ≈ feature-boxes à recadrer (bordure survol primary, icône 40px)</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter">
          {
            realisations.map((r) => (
              <div class="p-stack-lg border border-solid border-outline-variant bg-white hover:border-primary transition-all group rounded">
                <span class="material-symbols-outlined text-primary mb-4 text-[40px] group-hover:scale-110 transition-transform">{r.icone}</span>
                <h3 class="font-headline-md text-headline-md m-0 mb-2">{r.titre}</h3>
                <p class="font-body-md text-body-md text-on-surface-variant m-0">{r.texte}</p>
              </div>
            ))
          }
        </div>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">4 · Cartes bureaux</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Contact.html · ⛔ gap — aucun composant localisations</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          {
            bureaux.map((b) => (
              <div class="bg-surface-container-lowest border border-solid border-outline-variant p-stack-lg rounded group hover:border-primary transition-colors h-full flex flex-col">
                <div class="mb-stack-md overflow-hidden rounded-sm h-32">
                  <img alt={`Bureau de ${b.ville}`} class="w-full h-full object-cover" src={`/images/design-lab/refonte/${b.img}`} />
                </div>
                <h3 class="text-headline-md font-headline-md m-0 mb-2">{b.ville}</h3>
                <p class="text-body-md text-on-surface-variant flex-grow m-0 mb-4" set:html={b.adresse} />
                <a class="text-primary font-bold inline-flex items-center gap-2 group-hover:underline" href={b.href}>
                  <span class="material-symbols-outlined">call</span>
                  {b.tel}
                </a>
              </div>
            ))
          }
        </div>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">5 · Nos valeurs</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Carrieres.html · ⛔ gap — aucun composant valeurs</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-gutter">
          {
            valeurs.map((v, i) => (
              <div class={`flex flex-col items-center text-center p-stack-md border border-solid border-outline-variant hover:border-primary transition-colors group rounded${i === valeurs.length - 1 ? ' col-span-2 md:col-span-1' : ''}`}>
                <span class="material-symbols-outlined text-primary text-4xl mb-stack-sm group-hover:scale-110 transition-transform">{v.icone}</span>
                <span class="font-label-caps text-label-caps uppercase tracking-widest font-bold">{v.nom}</span>
              </div>
            ))
          }
        </div>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">6 · Vitrine + carte flottante « 24/7 »</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Accueil.html · ⛔ gap · TRANSPOSÉ au système des 4 pages alignées (Accueil hors-norme, signalé)</span>
        </div>
        <div class="flex flex-col lg:flex-row items-center gap-16 overflow-visible">
          <div class="w-full lg:w-1/2 relative mb-12 lg:mb-0">
            <div class="rounded-xl overflow-hidden shadow-2xl">
              <img alt="Équipe Victrix en rencontre de travail" class="w-full h-[420px] object-cover" src="/images/design-lab/refonte/accueil-04.jpg" />
            </div>
            <div class="absolute bottom-[-40px] right-[-8px] bg-white p-8 rounded-xl shadow-xl border border-solid border-outline-variant max-w-[320px]">
              <div class="text-primary font-display text-display leading-none mb-2">24/7</div>
              <div class="text-on-surface font-bold text-button uppercase mb-2 tracking-widest">Services gérés</div>
              <p class="text-label-caps text-on-surface-variant leading-tight m-0 normal-case tracking-normal">Support proactif et gestion complète de votre écosystème M365.</p>
            </div>
          </div>
          <div class="w-full lg:w-1/2">
            <h3 class="font-display text-headline-lg text-on-surface m-0 mb-6">
              Libérez votre équipe des contraintes <span class="text-primary">opérationnelles</span>
            </h3>
            <p class="text-body-lg text-on-surface-variant m-0 mb-10">
              Nos services gérés vous permettent de vous concentrer sur votre cœur de métier pendant que nos experts
              veillent sur la performance de vos systèmes.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
              <div class="bg-primary-container p-6 rounded-lg border-l-4 border-solid border-white">
                <div class="font-bold text-white mb-2 uppercase text-[12px]">M365 Écosystème</div>
                <p class="text-white/90 text-body-md m-0">Maximisez l'utilisation de vos licences et outils collaboratifs.</p>
              </div>
              <div class="bg-primary-container p-6 rounded-lg border-l-4 border-solid border-white">
                <div class="font-bold text-white mb-2 uppercase text-[12px]">Sécurité Infra</div>
                <p class="text-white/90 text-body-md m-0">Surveillance continue et remédiation rapide des incidents.</p>
              </div>
            </div>
            <a class="inline-flex items-center gap-4 text-on-surface font-bold text-headline-md group" href="/fr/contact/">
              <span class="w-12 h-12 rounded-full border border-solid border-outline flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all">
                <span class="material-symbols-outlined">arrow_forward</span>
              </span>
              Parler à un expert
            </a>
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------------------ */}
      <section class="mb-section-gap">
        <div class="border-b border-solid border-outline-variant pb-stack-sm mb-stack-lg flex flex-wrap items-baseline gap-stack-md">
          <h2 class="font-headline-md text-headline-md m-0">7 · Primitives de la planche</h2>
          <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">DesignSystemVictrix.png §4 · rayons = configs exports (rounded 0.125rem ; full gardé rond, signalé)</span>
        </div>
        <div class="flex flex-wrap items-center gap-stack-lg bg-surface-container-lowest border border-solid border-outline-variant rounded-lg p-stack-lg">
          <button class="bg-primary text-on-primary px-6 py-3 rounded font-button text-button inline-flex items-center gap-2 group" type="button">
            Bouton primaire
            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </button>
          <button class="bg-transparent text-primary border border-solid border-primary px-6 py-3 rounded font-button text-button inline-flex items-center gap-2 group" type="button">
            Bouton secondaire
            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </button>
          <span class="inline-flex items-center gap-2 bg-surface-container-high text-on-surface rounded-full px-4 py-2 font-label-caps text-label-caps uppercase">
            <span class="material-symbols-outlined text-[16px]">security</span>
            Cybersécurité
          </span>
          <label class="flex flex-col gap-1 min-w-64">
            <span class="font-body-md text-body-md font-bold">Courriel</span>
            <span class="flex items-center gap-2 border border-solid border-outline-variant rounded px-3 py-2 bg-white focus-within:border-primary transition-colors">
              <span class="material-symbols-outlined text-on-surface-variant text-[20px]">mail</span>
              <input class="outline-none font-body-md text-body-md bg-transparent w-full" placeholder="prenom.nom@entreprise.ca" type="email" />
            </span>
          </label>
        </div>
      </section>

      <footer class="border-t border-solid border-outline-variant py-stack-lg">
        <p class="text-body-md text-on-surface-variant m-0">
          Prochaine étape (groundwork Phase 5) : réponses aux 5 arbitrages, puis portage complet d'une page finale
          (PageExpertise recommandé) pour revalider le pipeline — audit-tokens-figma.md §5.
        </p>
      </footer>
    </main>
  </body>
</html>
