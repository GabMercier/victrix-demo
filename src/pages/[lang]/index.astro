---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
// The shared Bookshop renderer maps each section to its component. Sections
// MUST be rendered through it — with `bookshop:live` below — for CloudCannon's
// live editing to connect (see the renderer's header comment). Vite resolves
// relative imports above src/ without any alias.
import Page from '../../../component-library/src/shared/astro/page.astro';
import { locales, type Locale, htmlLang, localizePath } from '../../i18n/config';
import { getPostsByLocale, postUrlSlug, postKey } from '../../i18n/blog';

/**
 * Home page — composed from the `home` collection's `sections` array (the same
 * frozen contract as the campaign landings), rendered through the shared
 * Bookshop renderer so it is visually editable in CloudCannon (criterion 1).
 * The former inline markup moved 1:1 into component-library/src/components/
 * home-* components; the rendered HTML stays byte-identical in normal builds.
 *
 * Two sections are NOT pure front matter and can't compute their data in the
 * browser editor (component-library components must stay browser-safe — no
 * astro:assets/astro:content imports, see faq.astro). We resolve their data at
 * BUILD time here and inject it via the renderer's `enrich` seam:
 *  - home-solution: its image, resolved with getImage (same options as the old
 *    <Image>), so the built <img> is identical;
 *  - home-latest: the 3 newest posts (getPostsByLocale) with their covers
 *    pre-resolved to plain src/srcset strings.
 * In the editor's live re-render neither `enrich` value exists, so those
 * components fall back to placeholders (documented in each component).
 */
export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const entry = await getEntry('home', `${lang}/accueil`);
    if (!entry) throw new Error(`Contenu d'accueil introuvable : src/content/home/${lang}/accueil.json`);

    const sections = entry.data.sections;

    // home-solution image → same getImage options as the old <Image>.
    const solution = sections.find((s) => s.type === 'home-solution');
    const enrich: Record<string, Record<string, unknown>> = {};
    if (solution && 'image' in solution && solution.image) {
      const img = solution.image;
      const resolved = await getImage({
        src: img,
        widths: [400, 760],
        sizes: '(min-width: 880px) 420px, 100vw',
      });
      enrich['home-solution'] = {
        resolvedImage: {
          src: resolved.src,
          srcset: resolved.srcSet.attribute,
          width: img.width,
          height: img.height,
        },
      };
    }

    // home-latest : les 3 articles à afficher. Couvertures = chemins publics
    // servis tels quels (contenu migré de WordPress — voir le schéma blog) :
    // plus de getImage, le composant omet srcset/dimensions quand absents.
    //
    // ARTICLES EN VEDETTE (2026-09-23, demande du marketing pour la démo) — la
    // section accepte désormais une liste `vedettes` de NOMS DE FICHIERS
    // d'articles (`postKey`, l'identifiant commun à FR et EN). Vide = les 3
    // plus récents, comme avant.
    //
    // Trois garde-fous, parce que cette liste est saisie au CMS :
    //  - un identifiant inconnu est IGNORÉ et signalé au build, jamais fatal
    //    (une faute de frappe ne doit pas mettre la branche d'édition au rouge
    //    — mémoire cloudcannon-null-build-break) ;
    //  - la liste est COMPLÉTÉE par les articles les plus récents jusqu'à 3,
    //    pour qu'une vedette manquante ne laisse pas une grille trouée ;
    //  - au-delà de 3, le surplus est coupé : la maquette a trois cartes.
    const tousLesPosts = await getPostsByLocale(lang);
    const vedettes = (
      sections.find((s) => s.type === 'home-latest')?.vedettes ?? []
    ).filter((v) => typeof v === 'string' && v.trim() !== '');

    const posts = [];
    if (vedettes.length > 0) {
      const parIdentifiant = new Map(tousLesPosts.map((p) => [postKey(p), p]));
      const inconnus = [];
      for (const v of vedettes) {
        const trouve = parIdentifiant.get(v.trim());
        if (trouve) posts.push(trouve);
        else inconnus.push(v);
      }
      if (inconnus.length > 0) {
        console.warn(
          `[accueil/${lang}] « Articles en vedette » : ${inconnus.length} identifiant(s) sans article — ` +
            `${inconnus.join(', ')}. Attendu : le NOM DE FICHIER sans extension ` +
            `(ex. « certification-iso-27001-iso-9001 »). Complété par les plus récents.`,
        );
      }
    }
    for (const p of tousLesPosts) {
      if (posts.length >= 3) break;
      if (!posts.includes(p)) posts.push(p);
    }
    posts.length = Math.min(posts.length, 3);
    const dateFmt = new Intl.DateTimeFormat(htmlLang[lang], { dateStyle: 'long', timeZone: 'UTC' });
    const cards = await Promise.all(
      posts.map(async (post) => {
        return {
          href: localizePath(`/ressources/${postUrlSlug(post)}`, lang),
          title: post.data.title,
          excerpt: post.data.excerpt,
          tags: post.data.tags,
          dateISO: post.data.date.toISOString(),
          dateLabel: dateFmt.format(post.data.date),
          img: { src: post.data.coverImage ?? '' },
        };
      }),
    );
    enrich['home-latest'] = { cards };

    // `frontmatter` is LOAD-BEARING for CloudCannon live editing: the
    // astro-bookshop vite plugin statically pattern-matches a variable literally
    // named `frontmatter` to bind `bookshop:live` props to the entry's data
    // file. Passing `entry.data.sections` directly compiles to an EMPTY
    // params() marker (root-caused 2026-07-15 on the campaign route) — the
    // editor then re-renders the boundary with no data and the preview goes
    // blank. Do not rename or inline it.
    paths.push({ params: { lang }, props: { lang, frontmatter: entry.data, enrich } });
  }
  return paths;
}

const { lang, frontmatter, enrich } = Astro.props as {
  lang: Locale;
  frontmatter: { sections: unknown[]; seoH1?: string; seoTitle?: string; metaDescription?: string };
  enrich: Record<string, Record<string, unknown>>;
};

/**
 * SEO de l'accueil — ÉDITABLE AU CMS depuis le 2026-09-23 (`seoTitle` et
 * `metaDescription` de la collection `home`). Les deux constantes ci-dessous ne
 * sont plus la valeur servie : ce sont les REPLIS, au cas où l'éditrice vide
 * le champ (règle 5 du CLAUDE.md — un champ vidé arrive en `''`).
 *
 * Avant ce lot la page n'avait AUCUN titre : BaseLayout retombait sur
 * SITE_NAME et `<title>` sortait à « Victrix » tout court, alors que la page
 * en ligne annonce « Cabinet Conseil TI, Cybersécurité, IA & Services Gérés |
 * Victrix ». BaseLayout suffixe lui-même « — Victrix » : le champ ne contient
 * donc QUE la partie descriptive, sans la marque, comme sur toutes les autres
 * pages du site.
 */
const TITRE_REPLI = {
  fr: 'Cabinet conseil TI, cybersécurité, IA et services gérés',
  en: 'IT Consulting, Cybersecurity, AI & Managed Services',
} as const;

const DESCRIPTION_REPLI = {
  fr: 'Victrix — services-conseils en TI : cybersécurité, infonuagique, intelligence artificielle, productivité et services gérés pour les entreprises et organisations publiques.',
  en: 'Victrix — IT consulting services: cybersecurity, cloud computing, artificial intelligence, productivity and managed services for businesses and public organizations.',
} as const;

// `||` et non `??` : c'est la chaîne VIDE qu'il faut rattraper, pas `undefined`.
const title = frontmatter.seoTitle || TITRE_REPLI[lang];
const description = frontmatter.metaDescription || DESCRIPTION_REPLI[lang];
---

<BaseLayout lang={lang} title={title} description={description} contentType="Page">
  {
    /* One `bookshop:live` boundary around the whole section loop — this binds
       clicks on the page to the `sections` array in the entry's data file (via
       the `frontmatter` variable above) and re-renders sections live while
       editing. In normal Cloudflare builds the Bookshop integration is off
       (astro.config gating) and the directive is an inert prop — the rendered
       HTML is identical. `enrich` carries the build-only, browser-unsafe data
       (see getStaticPaths); it is not part of the frontmatter, so it never
       affects the live binding. */
  }
  <Page bookshop:live contentBlocks={frontmatter.sections} enrich={enrich} seoH1={frontmatter.seoH1} />
</BaseLayout>
